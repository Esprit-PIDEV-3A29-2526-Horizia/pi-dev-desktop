<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import java.util.stream.Collectors?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Region?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f4f7fc;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AdminDashboardController">

    <!-- TOP: Barre de navigation -->
    <top>
        <AnchorPane prefHeight="70.0" style="-fx-background-color: #1F2937;">
            <children>
                <Label layoutX="30.0" layoutY="20.0" text="Administration" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_RIGHT" layoutX="800.0" layoutY="15.0" prefHeight="40.0" prefWidth="370.0" spacing="20.0">
                    <children>
                        <Label fx:id="lblWelcome" text="Bienvenue, Admin" textFill="WHITE">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Button onAction="#handleLogout" style="-fx-background-color: #EF4444; -fx-background-radius: 5;" text="Déconnexion" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </top>

    <!-- LEFT: Menu latéral -->
    <left>
        <VBox prefWidth="260" spacing="18" style="-fx-background-color:#111827;">
            <padding>
                <Insets bottom="18" left="18" right="18" top="22" />
            </padding>

            <!-- Logo - réduire la taille et ajouter backgroundLoading -->
            <ImageView fitHeight="40" fitWidth="150" preserveRatio="true" smooth="false">
                <image>
                    <Image url="@../images/logo.png" backgroundLoading="true" />
                </image>
            </ImageView>
            <!-- Menu Items avec les bons fx:id et onAction -->
            <VBox spacing="5">
                <!-- Dashboard Button -->
                <Button fx:id="btnDashboard"
                        onAction="#showDashboard"
                        prefWidth="220"
                        style="-fx-background-color:transparent; -fx-text-fill:#E5E7EB; -fx-alignment:center-left; -fx-padding:12; -fx-cursor:hand; -fx-background-radius:8;"
                        text="📊 Dashboard">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <!-- Membres Button -->
                <Button fx:id="btnUsers"
                        onAction="#showUsers"
                        prefWidth="220"
                        style="-fx-background-color:transparent; -fx-text-fill:#E5E7EB; -fx-alignment:center-left; -fx-padding:12; -fx-cursor:hand; -fx-background-radius:8;"
                        text="👥 Membres">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <!-- Profils Button -->
                <Button fx:id="btnProfils"
                        onAction="#showProfils"
                        prefWidth="220"
                        style="-fx-background-color:transparent; -fx-text-fill:#E5E7EB; -fx-alignment:center-left; -fx-padding:12; -fx-cursor:hand; -fx-background-radius:8;"
                        text="📋 Profils">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <!-- Statistiques Button -->
                <Button fx:id="btnStats"
                        onAction="#showStats"
                        prefWidth="220"
                        style="-fx-background-color:transparent; -fx-text-fill:#E5E7EB; -fx-alignment:center-left; -fx-padding:12; -fx-cursor:hand; -fx-background-radius:8;"
                        text="📈 Statistiques">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <!-- Paramètres Button -->
                <Button fx:id="btnSettings"
                        onAction="#showSettings"
                        prefWidth="220"
                        style="-fx-background-color:transparent; -fx-text-fill:#E5E7EB; -fx-alignment:center-left; -fx-padding:12; -fx-cursor:hand; -fx-background-radius:8;"
                        text="⚙️ Paramètres">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </VBox>

            <Separator style="-fx-background-color:#374151;" />

            <!-- Statistiques rapides -->
            <VBox spacing="10">
                <Label style="-fx-text-fill:#9CA3AF; -fx-font-size:11px; -fx-font-weight:bold;" text="STATISTIQUES" />

                <!-- Total Membres -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:16px;" text="👥" />
                    <Label style="-fx-text-fill:#E5E7EB; -fx-font-size:12px;" text="Total membres:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalMembresLabel" style="-fx-text-fill:#10B981; -fx-font-weight:bold;" text="0" />
                </HBox>

                <!-- Admins -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:16px;" text="👑" />
                    <Label style="-fx-text-fill:#E5E7EB; -fx-font-size:12px;" text="Administrateurs:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalAdminsLabel" style="-fx-text-fill:#EF4444; -fx-font-weight:bold;" text="0" />
                </HBox>

                <!-- Agents -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:16px;" text="🛠️" />
                    <Label style="-fx-text-fill:#E5E7EB; -fx-font-size:12px;" text="Agents:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalAgentsLabel" style="-fx-text-fill:#F59E0B; -fx-font-weight:bold;" text="0" />
                </HBox>

                <!-- Clients -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:16px;" text="👤" />
                    <Label style="-fx-text-fill:#E5E7EB; -fx-font-size:12px;" text="Clients:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalClientsLabel" style="-fx-text-fill:#10B981; -fx-font-weight:bold;" text="0" />
                </HBox>
            </VBox>

            <!-- Espace flexible -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Footer avec infos admin -->
            <VBox spacing="6" style="-fx-background-color:#0B1220; -fx-background-radius:16; -fx-padding:12;">
                <HBox alignment="CENTER_LEFT" spacing="8">

                    <VBox>
                        <Label fx:id="lblAdminName" style="-fx-text-fill:white; -fx-font-size:12; -fx-font-weight:800;" text="Administrateur" />
                        <Label fx:id="lblAdminEmail" style="-fx-text-fill:#9CA3AF; -fx-font-size:10;" text="admin@horiza.com" />
                    </VBox>
                </HBox>
                <Button onAction="#handleLogout"
                        style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-font-size:11; -fx-font-weight:800;
                           -fx-background-radius:10; -fx-padding:8; -fx-cursor:hand;"
                        text="Déconnexion" />
            </VBox>

            <Label style="-fx-text-fill:#6B7280; -fx-font-size:11;" text="© 2026 Horiza" />
        </VBox>
    </left>
    <!-- CENTER: Contenu principal -->
    <center>
        <AnchorPane fx:id="contentArea" prefHeight="630.0" prefWidth="950.0" style="-fx-background-color: #f4f7fc;">
            <children>
                <!-- Le contenu changera dynamiquement -->
            </children>
        </AnchorPane>
    </center>
</BorderPane>