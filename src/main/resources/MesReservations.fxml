<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="1100.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.MesReservationsController"
      stylesheets="@style.css"
      styleClass="page">

    <children>

        <!-- ================= NAVBAR ================= -->
        <HBox prefHeight="80.0"
              alignment="CENTER_LEFT"
              spacing="18"
              styleClass="navbar">

            <!-- Logo -->
            <ImageView fitHeight="70" fitWidth="70" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png"/>
                </image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Menu centré -->
            <HBox alignment="CENTER" spacing="35">

                <Button fx:id="btnAccueil"
                        text="Accueil"
                        styleClass="nav-btn"/>

                <Button fx:id="btnNosVoyages"
                        text="Nos Voyages"
                        onAction="#allerAuCatalogue"
                        styleClass="nav-btn"/>

                <Button fx:id="btnMesReservations"
                        text="Mes Réservations"
                        styleClass="nav-btn"/>

                <Button fx:id="btnContact"
                        text="Contact"
                        styleClass="nav-btn"/>

            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Utilisateur -->
            <Button text="Utilisateur"
                    styleClass="user-btn">
                <graphic>
                    <Label text="👤" styleClass="user-icon"/>
                </graphic>
            </Button>

            <!-- Déconnexion -->
            <Button text="Déconnexion"
                    onAction="#deconnexion"
                    styleClass="logout-btn"/>

        </HBox>

        <!-- ================= CONTENU ================= -->
        <VBox spacing="18.0" VBox.vgrow="ALWAYS" alignment="CENTER">
            <padding>
                <Insets top="30.0" right="50.0" bottom="30.0" left="50.0"/>
            </padding>

            <children>

                <Label text="Mes Réservations" styleClass="page-title"  style=" -fx-text-fill: #3D94CA;"/>

                <!-- FILTRES (connectés au controller) -->
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="btnFiltreToutes" text="Toutes" onAction="#filtrerToutes"
                            style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-font-weight: bold;
                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>

                    <Button fx:id="btnFiltreConfirmees" text="Confirmées" onAction="#filtrerConfirmees"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>

                    <Button fx:id="btnFiltreAttente" text="En attente" onAction="#filtrerAttente"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>
                </HBox>

                <!-- Header tableau -->
                <GridPane styleClass="table-header">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="40.0"/>
                        <ColumnConstraints halignment="CENTER" percentWidth="20.0"/>
                        <ColumnConstraints halignment="CENTER" percentWidth="20.0"/>
                        <ColumnConstraints halignment="CENTER" percentWidth="20.0"/>
                    </columnConstraints>

                    <children>
                        <Label text="Voyage" styleClass="th"/>
                        <Label text="Personnes" GridPane.columnIndex="1" styleClass="th"/>
                        <Label text="Statut" GridPane.columnIndex="2" styleClass="th"/>
                        <Label text="Actions" GridPane.columnIndex="3" styleClass="th"/>
                    </children>
                </GridPane>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <content>
                        <VBox fx:id="containerReservations" spacing="15.0"/>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</VBox>