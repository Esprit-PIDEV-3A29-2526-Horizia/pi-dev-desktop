<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.PublicationsController"
      spacing="15"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <!-- Titre -->
    <Label text="📰 Gestion des Publications"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Barre d'outils -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="ajouterBtn" text="➕ Nouvelle Publication"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />

        <TextField fx:id="rechercheField" promptText="🔍 Rechercher..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-padding: 10; -fx-background-radius: 5;" />

        <ComboBox fx:id="triComboBox" promptText="Trier par"
                  style="-fx-background-radius: 5;" />
    </HBox>

    <!-- Liste des publications -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <FlowPane fx:id="publicationsContainer"
                  hgap="15" vgap="15"
                  style="-fx-padding: 10;" />
    </ScrollPane>

</VBox>