<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" style="-fx-background-color: #F6F7FB; -fx-padding: 20;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.PublicationsController">
    <children>
        <!-- Titre de la page -->
        <Label text="Gestion des Publications" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <VBox.margin>
                <Insets bottom="10"/>
            </VBox.margin>
        </Label>

        <!-- Barre de tri, recherche et ajout -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Trier par :" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                <ComboBox fx:id="sortComboBox" promptText="Choisir..." style="-fx-pref-width: 180px; -fx-background-radius: 5;" />
                <TextField fx:id="searchField" promptText="Rechercher par titre..." HBox.hgrow="ALWAYS" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
                <Button fx:id="addButton" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold;" text="+ Nouvelle Publication" />
            </children>
        </HBox>

        <!-- Zone des cartes de publications -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="publicationsFlowPane" hgap="20" vgap="20" style="-fx-background-color: #F6F7FB; -fx-padding: 5;">
                    <!-- Les cartes des publications seront ajoutées dynamiquement ici -->
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>