<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="cardContainer" prefWidth="230" spacing="10"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.VoyageCardUserController"
      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 12;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 14, 0, 0, 6);">

    <!-- image + badge -->
    <StackPane>
        <ImageView fx:id="imgVoyage" fitWidth="206" fitHeight="110" preserveRatio="false"
                   style="-fx-background-radius: 14; -fx-border-radius: 14;"/>
        <Label fx:id="badgeStatus" text="DISPONIBLE"
               StackPane.alignment="TOP_LEFT"
               style="-fx-background-color: #DCFCE7; -fx-text-fill: #059669;
                      -fx-background-radius: 14; -fx-padding: 3 10; -fx-font-weight: bold; -fx-font-size: 11;"/>
        <StackPane.margin>
            <Insets top="8" left="8" right="0" bottom="0"/>
        </StackPane.margin>
    </StackPane>

    <Label fx:id="lblDestination" text="Tokyo"
           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

    <Label fx:id="lblDates" text="Du 03/11/2026 au 10/11/2026"
           style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblPrix" text="3 500 DT"
               style="-fx-text-fill: #E8B156; -fx-font-weight: bold; -fx-font-size: 12;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblPlacesInfo" text="Places restantes : 25"
               style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>
    </HBox>

    <!-- bouton (orange comme capture) -->
    <Button fx:id="btnReserver" text="Réserver" onAction="#handleReserver"
            prefHeight="30" maxWidth="9999"
            style="-fx-background-color: #E8B156; -fx-text-fill: white;
                   -fx-background-radius: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>

</VBox>