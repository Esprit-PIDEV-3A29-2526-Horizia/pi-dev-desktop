<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AjouterPublicationController">
    <children>
        <Label text="Titre *" />
        <TextField fx:id="titreField" promptText="Titre de la publication" />

        <Label text="Description *" />
        <TextArea fx:id="descriptionArea" promptText="Description" prefRowCount="5" wrapText="true" />

        <Label text="Image" />
        <TextField fx:id="imageField" promptText="Chemin de l'image" />

        <!-- Bouton Parcourir avec onAction -->
        <Button text="Parcourir" onAction="#parcourirImage" />

        <Button fx:id="enregistrerBtn" text="Enregistrer" />
        <Button fx:id="annulerBtn" text="Annuler" />
    </children>
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
</VBox>