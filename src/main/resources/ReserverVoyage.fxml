<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<VBox prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F3F4F6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ReserverVoyageController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" style="-fx-background-color: #105D5E; -fx-padding: 0 30;">
            <children>
                <Button onAction="#retour" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="← Retour au catalogue" />
            </children>
        </HBox>

        <HBox spacing="30.0" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
            <children>

                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblTitre" style="-fx-font-size: 26; -fx-font-weight: bold;" text="Voyage à ..." />
                        <ImageView fx:id="imgVoyage" fitHeight="350.0" fitWidth="650.0" preserveRatio="false" style="-fx-background-radius: 10;" />
                        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Découvre ta destination" />
                        <Label fx:id="lblDescription" style="-fx-text-fill: #4B5563; -fx-font-size: 14;" text="..." wrapText="true" />
                    </children>
                </VBox>

                <VBox minWidth="350.0" prefWidth="350.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Finaliser ma réservation" />

                        <VBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Combien de personnes ?" />
                                <Spinner fx:id="spinnerPlaces" maxWidth="Infinity" prefHeight="45.0" />
                            </children>
                        </VBox>

                        <Separator />

                        <VBox spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #6B7280;" text="Prix unitaire" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblPrixUnitaire" style="-fx-font-weight: bold;" text="0 DT" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Total à payer" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblPrixTotal" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #10B981;" text="0 DT" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Button onAction="#confirmerReservation" prefHeight="55.0" maxWidth="Infinity" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-size: 16; -fx-cursor: hand;" text="Confirmer la réservation" />
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</VBox>