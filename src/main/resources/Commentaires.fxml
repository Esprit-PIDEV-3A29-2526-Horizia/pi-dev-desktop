<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.CommentairesController"
      spacing="15"
      style="-fx-background-color: white; -fx-padding: 20;">

    <!-- Titre -->
    <Label text="Commentaires"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Info publication -->
    <Label fx:id="publicationInfoLabel"
           text="Publication: Titre"
           style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;" />

    <!-- Formulaire d'ajout -->
    <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Ajouter un commentaire" style="-fx-font-weight: bold;" />

        <TextField fx:id="auteurField" promptText="Votre nom"
                   style="-fx-padding: 10; -fx-background-radius: 5;" />

        <TextArea fx:id="contenuField" promptText="Votre commentaire..."
                  wrapText="true" prefRowCount="3"
                  style="-fx-background-radius: 5;" />

        <Button fx:id="ajouterBtn" text="Publier"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" />
    </VBox>

    <!-- Liste des commentaires -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox fx:id="commentairesContainer" spacing="10" style="-fx-padding: 5;">
            <!-- Les commentaires seront ajoutés ici dynamiquement -->
        </VBox>
    </ScrollPane>

    <!-- Bouton retour -->
    <Button fx:id="retourBtn" text="← Retour aux publications"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
</VBox>