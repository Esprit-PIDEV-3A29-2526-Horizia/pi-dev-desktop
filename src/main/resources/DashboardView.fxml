<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.DashboardController">
    <content>
        <VBox spacing="20" style="-fx-background-color: #F6F7FB; -fx-padding: 20;">

            <!-- Header -->
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="📊 Tableau de bord" />

            <Button text="🔄 Rafraîchir" onAction="#refreshDashboard"
                    style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20;" />

            <!-- KPIs Cards -->
            <HBox spacing="15" alignment="CENTER">
                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #666;" text="📅 Total événements" />
                    <Label fx:id="totalEventsLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="0" />
                </VBox>

                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #666;" text="🎟️ Places totales" />
                    <Label fx:id="totalPlacesLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3D94CA;" text="0" />
                </VBox>

                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #666;" text="📊 Taux remplissage" />
                    <Label fx:id="fillRateLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #81AE8D;" text="0%" />
                </VBox>

                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #666;" text="💰 Revenu total" />
                    <Label fx:id="totalRevenueLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #E8B156;" text="0 DT" />
                </VBox>
            </HBox>

            <!-- Évolution des ventes -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="📈 Évolution des réservations" />
                <LineChart fx:id="evolutionChart" prefHeight="250">
                    <xAxis>
                        <CategoryAxis label="Date" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Nombre de réservations" />
                    </yAxis>
                </LineChart>
            </VBox>

            <!-- Catégories et Top événements -->
            <HBox spacing="15">
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="🥧 Catégories" />
                    <PieChart fx:id="categoriesChart" prefHeight="250" />
                </VBox>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="📊 Top événements" />
                    <BarChart fx:id="topEventsChart" prefHeight="250">
                        <xAxis>
                            <CategoryAxis label="Événement" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Taux (%)" upperBound="100" />
                        </yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- Événements populaires -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="🔥 Événements populaires" />
                <ScrollPane fitToWidth="true" prefHeight="200" style="-fx-background-color: transparent;">
                    <HBox fx:id="eventsContainer" spacing="15" />
                </ScrollPane>
            </VBox>

        </VBox>
    </content>
</ScrollPane>