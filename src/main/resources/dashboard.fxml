<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Dashboard"
            prefWidth="1400" prefHeight="800"
            style="-fx-background-color:#F1F5F9;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="280" spacing="8"
              style="-fx-background-color:#0F172A;">
            <padding>
                <Insets top="24" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Brand -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@images/logo.png"/>
                    </image>
                </ImageView>
                <Label text="Horizia"
                       style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:800;"/>
            </HBox>

            <Region prefHeight="24"/>

            <Label text="MENU PRINCIPAL"
                   style="-fx-text-fill:#64748B; -fx-font-size:11; -fx-font-weight:700;">
                <padding>
                    <Insets left="12"/>
                </padding>
            </Label>
            <Region prefHeight="8"/>

            <!-- Dashboard Button -->
            <Button fx:id="btnDashboard" text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color:#3B82F6; -fx-text-fill:white; -fx-font-size:14; -fx-font-weight:600;
                           -fx-background-radius:12; -fx-padding:14 18; -fx-cursor:hand;">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region prefWidth="20" prefHeight="20"
                                style="-fx-background-color:white; -fx-background-radius:3;"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Voyages Button -->
            <Button fx:id="btnVoyages" text="Voyages"
                    onAction="#showVoyages"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#94A3B8; -fx-font-size:14; -fx-font-weight:600;
                           -fx-background-radius:12; -fx-padding:14 18; -fx-cursor:hand;">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region prefWidth="20" prefHeight="20"
                                style="-fx-background-color:#94A3B8; -fx-background-radius:3;"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Réservations Button -->
            <Button fx:id="btnReservations" text="Réservations"
                    onAction="#showReservations"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#94A3B8; -fx-font-size:14; -fx-font-weight:600;
                           -fx-background-radius:12; -fx-padding:14 18; -fx-cursor:hand;">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region prefWidth="20" prefHeight="20"
                                style="-fx-background-color:#94A3B8; -fx-background-radius:3;"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Publications Button (Nouveau) -->
            <Button fx:id="btnPublications" text="Publications"
                    onAction="#showPublications"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#94A3B8; -fx-font-size:14; -fx-font-weight:600;
                           -fx-background-radius:12; -fx-padding:14 18; -fx-cursor:hand;">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region prefWidth="20" prefHeight="20"
                                style="-fx-background-color:#94A3B8; -fx-background-radius:3;"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer Info -->
            <VBox spacing="8"
                  style="-fx-background-color:#1E293B; -fx-background-radius:16; -fx-padding:16;">
                <Label text="💡 Conseil"
                       style="-fx-text-fill:white; -fx-font-size:13; -fx-font-weight:700;"/>
                <Label text="Utilisez le menu pour naviguer entre les différentes sections."
                       wrapText="true"
                       style="-fx-text-fill:#64748B; -fx-font-size:12;"/>
            </VBox>

            <Region prefHeight="12"/>
            <Label text="© 2024 Horizia"
                   style="-fx-text-fill:#475569; -fx-font-size:11;"/>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color:#F1F5F9;">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>
