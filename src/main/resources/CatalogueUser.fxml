<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.CatalogueUserController">
    <children>
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="30.0" style="-fx-background-color: #105D5E;">
                    <padding><Insets left="30.0" right="30.0" /></padding>
                    <children>
                        <ImageView fitHeight="45.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@/images/logo.png" />
                            </image>
                        </ImageView>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Button onAction="#afficherCatalogue" style="-fx-background-color: #2D7A7B; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-background-radius: 10;" text="Catalogue" />
                                <Button onAction="#afficherHistorique" style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-font-size: 15; -fx-cursor: hand;" text="Mes Réservations" />
                                <Button style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-font-size: 15; -fx-cursor: hand;" text="Profil" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button onAction="#handleDeconnexion" style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 20;" text="Déconnexion" />
                    </children>
                </HBox>

                <VBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="30.0" right="30.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox>
                                    <children>
                                        <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Bienvenue chez Horizia" />
                                        <Label style="-fx-text-fill: #64748B;" text="Trouvez votre prochaine destination de rêve" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="searchField" onKeyReleased="#handleRecherche" prefHeight="40.0" prefWidth="350.0" promptText="Où voulez-vous aller ?" style="-fx-background-radius: 20; -fx-border-color: #E2E8F0; -fx-border-radius: 20; -fx-background-insets: 0;" />
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
                            <content>
                                <GridPane fx:id="voyageGrid" hgap="25.0" vgap="25.0">
                                    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                                </GridPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>