<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.CatalogueUserController">
    <children>
        <HBox layoutX="0.0" prefHeight="700.0" prefWidth="1100.0">
            <children>
                <VBox prefWidth="250.0" style="-fx-background-color: #23779C;">
                    <children>
                        <Label text="HORIZIA CLIENT" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;">
                            <VBox.margin><Insets bottom="50.0" left="20.0" top="30.0" /></VBox.margin>
                        </Label>
                        <Button text="Catalogue Voyages" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16;" />
                        <Button text="Mes Réservations" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16;" />
                    </children>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="20.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Découvrez nos destinations" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="searchField" promptText="Rechercher une destination..." style="-fx-background-radius: 20; -fx-pref-width: 300;" />
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                            <content>
                                <GridPane fx:id="voyageGrid" hgap="20.0" vgap="20.0">
                                </GridPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>