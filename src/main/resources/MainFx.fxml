<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.Dashboard">
    <!-- Menu gauche -->
    <left>
        <VBox spacing="10" style="-fx-padding:10">
            <Button text="Dashboard" onAction="#showDashboard"/>
            <Button text="Publications" onAction="#showPublications"/>
        </VBox>
    </left>

    <!-- Contenu dynamique -->
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>

