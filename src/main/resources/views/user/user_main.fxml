<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.user.UserMainController"
            prefHeight="800" prefWidth="1400"
            style="-fx-background-color: #f8fafc;">

    <!-- TOP BAR -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <!-- Première ligne : logo, recherche, météo, nom -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 30;">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="🏔️" style="-fx-font-size: 28;"/>
                    <Label text="HORIZIA" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </HBox>
                <HBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="500">
                    <TextField fx:id="searchField" promptText="Rechercher une destination..."
                               style="-fx-background-color: #f1f5f9; -fx-background-radius: 25; -fx-padding: 10 20; -fx-font-size: 14;" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="searchBtn" text="🔍"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand;"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Label text="9°C" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label fx:id="welcomeLabel" text="Bienvenue" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </HBox>
            </HBox>

            <!-- Menu de navigation -->
            <HBox spacing="25" style="-fx-padding: 0 30 10 30;" alignment="CENTER_LEFT">
                <Button fx:id="btnAccueil" text="Accueil"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Button fx:id="btnExplorer" text="Explorer"
                        style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Button fx:id="btnFavoris" text="Favoris"
                        style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Button fx:id="btnMesPublications" text="Mes publications"
                        style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Button fx:id="btnProfil" text="Profil"
                        style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnChat" text="💬 Chat" onAction="#showChat"
                        style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Button fx:id="btnModeAdmin" text="Mode Admin" visible="false" managed="false"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-font-size: 13; -fx-font-weight: bold;"/>
                <Button fx:id="btnDeconnexion" text="Déconnexion"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-font-size: 13; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CONTENT AREA -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #f8fafc;"/>
    </center>
</BorderPane>