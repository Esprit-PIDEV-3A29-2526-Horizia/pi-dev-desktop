<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.PublicationCardController"
      spacing="10"
      style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);"
      prefWidth="280">

    <!-- Image -->
    <StackPane fx:id="imageContainer"
               style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;">
        <ImageView fx:id="imageView" fitWidth="250" fitHeight="150" preserveRatio="true" />
    </StackPane>

    <!-- Date -->
    <Label fx:id="dateLabel" style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;" />

    <!-- Titre -->
    <Label fx:id="titreLabel" wrapText="true"
           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Description -->
    <Label fx:id="descriptionLabel" wrapText="true"
           style="-fx-font-size: 13; -fx-text-fill: #7f8c8d;" />

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
       
        <Button fx:id="modifierBtn" text="Modif"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
        <Button fx:id="supprimerBtn" text="Suppr"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
    </HBox>
</VBox>