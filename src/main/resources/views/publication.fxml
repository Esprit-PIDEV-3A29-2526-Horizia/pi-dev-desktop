<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AjoutPublicationController"
      spacing="15" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Nouvelle Publication" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <GridPane vgap="10" hgap="10" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints minWidth="250"/>
            <ColumnConstraints minWidth="50"/>
        </columnConstraints>

        <!-- Type -->
        <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeComboBox" promptText="Choisir un type" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Titre -->
        <Label text="Titre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="titreField" promptText="Titre de la publication" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button fx:id="titreMicroBtn" text="🎤" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <!-- Lieu -->
        <Label text="Lieu:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="lieuField" promptText="Lieu" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button fx:id="lieuMicroBtn" text="🎤" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

        <!-- Description -->
        <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="descriptionField" promptText="Description (max 255 caractères)" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button fx:id="descriptionMicroBtn" text="🎤" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

        <!-- Tarif -->
        <Label text="Tarif:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="tarifField" promptText="Prix en DT" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Button fx:id="tarifMicroBtn" text="🎤" GridPane.rowIndex="4" GridPane.columnIndex="2"/>

        <!-- Image -->
        <Label text="Image:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1">
            <Button fx:id="imageSelectBtn" text="Choisir une image"/>
            <Label fx:id="imagePathLabel" text="Aucune image sélectionnée"/>
        </HBox>

        <!-- Actif -->
        <Label text="Actif:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <CheckBox fx:id="actifCheckBox" selected="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    </GridPane>

    <!-- Label d'erreur -->
    <Label fx:id="errorLabel" wrapText="true" maxWidth="400" style="-fx-text-fill: #e74c3c;"/>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="ajouterBtn" text="Ajouter"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20;"/>
        <Button fx:id="annulerBtn" text="Annuler"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20;"/>
    </HBox>

</VBox>