<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox fx:id="cardRoot" spacing="0"
      style="-fx-background-color: white; -fx-background-radius: 16;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 4);"
      prefWidth="320" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.frontend.components.PublicationCardController">

    <!-- Image Container -->
    <StackPane>
        <Rectangle width="320" height="200"
                   style="-fx-fill: #e2e8f0; -fx-arc-width: 16; -fx-arc-height: 16;"/>
        <ImageView fx:id="imageView" fitWidth="320" fitHeight="200"
                   preserveRatio="true" style="-fx-background-radius: 16;"/>

        <!-- Category Badge -->
        <Label fx:id="categorieBadge" text="🏖️ Plage"
               style="-fx-background-color: rgba(59, 130, 246, 0.9); -fx-text-fill: white;
                      -fx-padding: 6 14; -fx-background-radius: 20; -fx-font-weight: bold;
                      -fx-font-size: 11;"
               StackPane.alignment="TOP_LEFT" style="-fx-margin: 12 0 0 12;">
            <StackPane.margin>
                <Insets top="12" left="12"/>
            </StackPane.margin>
        </Label>

        <!-- Likes Badge -->
        <Label fx:id="likesBadge" text="❤️ 42"
               style="-fx-background-color: rgba(255,255,255,0.95); -fx-text-fill: #e74c3c;
                      -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-weight: bold;
                      -fx-font-size: 12;"
               StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets top="12" right="12"/>
            </StackPane.margin>
        </Label>
    </StackPane>

    <!-- Content -->
    <VBox spacing="12" style="-fx-padding: 20;">
        <!-- Title -->
        <Label fx:id="titreLabel" text="Magnifique séjour à Djerba"
               wrapText="true"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

        <!-- Description -->
        <Label fx:id="descriptionLabel"
               text="Une expérience inoubliable avec la famille..."
               wrapText="true" maxHeight="40"
               style="-fx-font-size: 13; -fx-text-fill: #64748b;"/>

        <!-- Author & Date -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="👤" style="-fx-font-size: 14;"/>
            <Label fx:id="auteurLabel" text="Par Ahmed Ben"
                   style="-fx-font-size: 13; -fx-text-fill: #475569; -fx-font-weight: 500;"/>
            <Label text="•" style="-fx-text-fill: #94a3b8;"/>
            <Label fx:id="dateLabel" text="Il y a 2 jours"
                   style="-fx-font-size: 12; -fx-text-fill: #94a3b8;"/>
        </HBox>

        <!-- Stats -->
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-padding: 10 0 0 0; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;">
            <Label fx:id="commentairesLabel" text="💬 8 commentaires"
                   style="-fx-font-size: 12; -fx-text-fill: #64748b;"/>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
            <Button text="✏️" onAction="#modifier"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #3b82f6;
                           -fx-background-radius: 8; -fx-padding: 8 12; -fx-cursor: hand;
                           -fx-font-size: 14;"/>
            <Button text="🗑️" onAction="#supprimer"
                    style="-fx-background-color: #fef2f2; -fx-text-fill: #ef4444;
                           -fx-background-radius: 8; -fx-padding: 8 12; -fx-cursor: hand;
                           -fx-font-size: 14;"/>
        </HBox>
    </VBox>

</VBox>