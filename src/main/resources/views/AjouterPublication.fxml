<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.stage.FileChooser?>

<VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AjouterPublicationController">
    <children>
        <!-- Titre -->
        <Label text="Nouvelle Publication" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <!-- Formulaire -->
        <VBox spacing="15">
            <!-- Titre -->
            <VBox spacing="5">
                <Label text="Titre *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                <TextField fx:id="titreField" promptText="Entrez le titre de la publication" style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
            </VBox>

            <!-- Description -->
            <VBox spacing="5">
                <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                <TextArea fx:id="descriptionField" promptText="Entrez la description..." wrapText="true" prefRowCount="4" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
            </VBox>

            <!-- Image -->
            <VBox spacing="5">
                <Label text="Image" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="imageField" promptText="Chemin de l'image" HBox.hgrow="ALWAYS" editable="false" style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
                    <Button fx:id="browseButton" text="Parcourir" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-font-weight: bold;" />
                </HBox>
                <!-- Prévisualisation -->
                <ImageView fx:id="previewImage" fitHeight="150" fitWidth="250" preserveRatio="true" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;" />
            </VBox>
        </VBox>

        <!-- Boutons -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
            <children>
                <Button fx:id="annulerButton" text="Annuler" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-weight: bold;" />
                <Button fx:id="enregistrerButton" text="Enregistrer" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-weight: bold;" />
            </children>
        </HBox>
    </children>
</VBox>