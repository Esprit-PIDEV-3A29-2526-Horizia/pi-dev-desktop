<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ModifierPublicationController"
      spacing="10" alignment="CENTER" style="-fx-padding:20">

    <Label text="Nouvelle Publication" style="-fx-font-size:18; -fx-font-weight:bold"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titreField" promptText="Titre de la publication" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Lieu:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="lieuField" promptText="Lieu" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="contenuField" promptText="Description" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Tarif:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="tarifField" promptText="Prix en DT" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Image:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="imageField" promptText="URL de l'image" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Publié:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <CheckBox fx:id="publieCheck" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Enregistrer" onAction="#modifier"/>
        <Button text="Annuler" onAction="#annuler"/>
    </HBox>
</VBox>
