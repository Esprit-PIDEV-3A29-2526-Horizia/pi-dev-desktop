<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<HBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Region prefHeight="80.0" prefWidth="100.0" style="-fx-background-color: #3B82F6; -fx-background-radius: 10;" />

        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="itemTitre" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Titre de la publication" />
                <Label fx:id="itemDestination" style="-fx-font-size: 14; -fx-text-fill: #3B82F6; -fx-font-weight: 600;" text="Destination" />
                <Label fx:id="itemDescription" style="-fx-font-size: 13; -fx-text-fill: #64748B;" text="Ceci est une description courte du voyage..." wrapText="true" />
            </children>
        </VBox>

        <VBox alignment="TOP_RIGHT" prefWidth="100.0">
            <children>
                <Label fx:id="itemDate" style="-fx-font-size: 11; -fx-text-fill: #94A3B8;" text="2026-02-14" />
            </children>
        </VBox>
    </children>
</HBox>