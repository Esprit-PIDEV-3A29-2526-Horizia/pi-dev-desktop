<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="500" prefHeight="600"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.common.ModifierPublicationsController">

    <!-- Centre : formulaire défilant -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 20;">
                <Label text="✏️ Modifier Publication"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                <VBox spacing="5">
                    <Label text="Titre *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                    <TextField fx:id="titreField" promptText="Entrez le titre"
                               style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Catégorie *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                    <ComboBox fx:id="categorieCombo" promptText="Sélectionnez une catégorie"
                              style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                    <TextArea fx:id="descriptionField" promptText="Entrez la description..."
                              wrapText="true" prefRowCount="4"
                              style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 10;" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Image actuelle" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
                    <ImageView fx:id="currentImageView" fitHeight="150" fitWidth="250" preserveRatio="true"
                               style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="imageField" promptText="Nouvelle image (optionnel)"
                                   HBox.hgrow="ALWAYS" editable="false"
                                   style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
                        <Button fx:id="browseButton" text="Changer"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </HBox>
                    <ImageView fx:id="previewImage" fitHeight="100" fitWidth="150" preserveRatio="true"
                               style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;" />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bas : boutons fixes -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 15;">
            <Button fx:id="annulerButton" text="Annuler"
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button fx:id="enregistrerButton" text="Enregistrer"
                    minWidth="100" prefWidth="100"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>