<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1400"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.admin.AdminDashboardController"
            style="-fx-background-color: #f1f5f9;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="260" spacing="5"
              style="-fx-background-color: #1a2332; -fx-padding: 20;">

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20 0;">
                <Label text="🏔️" style="-fx-font-size: 32;"/>
                <Label text="Horizia" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <!-- Informations utilisateur (ajoutées ici) -->
            <VBox spacing="5" style="-fx-padding: 0 0 10 0;">
                <Label fx:id="welcomeLabel" text="Bienvenue" style="-fx-text-fill: white; -fx-font-size: 14;"/>
                <Label fx:id="userRoleLabel" text="Administrateur" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
            </VBox>

            <Separator style="-fx-background-color: #2d3748;" />

            <Label text="MENU" style="-fx-text-fill: #64748b; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 10 0;"/>

            <Button fx:id="btnDashboard" text="🏠 Tableau de bord" onAction="#showDashboard"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnVoyages" text="✈️ Voyages" onAction="#showVoyages"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnReservations" text="📅 Réservations" onAction="#showReservations"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnLogements" text="🏨 Logements" onAction="#showLogements"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnPublications" text="📰 Publications" onAction="#showPublications"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnUtilisateurs" text="👥 Utilisateurs" onAction="#showUtilisateurs"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnStatistiques" text="📊 Statistiques" onAction="#showStatistiques"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <Button fx:id="btnChat" text="💬 Chat" onAction="#showChat"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" maxWidth="Infinity"/>
            <VBox VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnModeUser" text="👤 Mode Utilisateur" onAction="#switchToUserMode"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-cursor: hand; -fx-font-weight: bold;" maxWidth="Infinity"/>
            <Button fx:id="btnDeconnexion" text="🚪 Déconnexion" onAction="#deconnecter"
                    style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14; -fx-cursor: hand;" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #f1f5f9;"/>
    </center>
</BorderPane>