<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800" prefWidth="1400"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.admin.AdminDashboardController"
            styleClass="dashboard-root"
            stylesheets="@/css/dashboard.css">

    <!-- SIDEBAR (Menu) -->
    <left>
        <VBox styleClass="sidebar" prefWidth="260">

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 20 0;">
                <Label text="🏔️" style="-fx-font-size: 32; -fx-text-fill: white;"/>
                <Label text="Horizia" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            </HBox>

            <Label text="MENU" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>

            <Button fx:id="btnDashboard" text="📊 Dashboard" onAction="#showDashboard" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnVoyages" text="✈️ Voyages" onAction="#showVoyages" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnReservations" text="📅 Réservations" onAction="#showReservations" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnLogements" text="🏨 Logements" onAction="#showLogements" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnPublications" text="📰 Publications" onAction="#showPublications" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnUtilisateurs" text="👥 Utilisateurs" onAction="#showUtilisateurs" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnStatistiques" text="📊 Statistiques" onAction="#showStatistiques" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnChat" text="💬 Chat" onAction="#showChat" styleClass="menu-button" maxWidth="Infinity"/>

            <Separator styleClass="sidebar-separator"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <!-- Boutons Mode Utilisateur et Déconnexion -->
            <Button fx:id="btnModeUser" text="👤 Mode Utilisateur" onAction="#switchToUserMode"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px; -fx-cursor: hand; -fx-font-weight: bold;" maxWidth="Infinity"/>
            <Button fx:id="btnDeconnexion" text="🚪 Déconnexion" onAction="#deconnecter"
                    style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px; -fx-cursor: hand;" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- CENTER - Contenu principal avec en-tête -->
    <center>
        <VBox spacing="20" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">

            <!-- En-tête avec avatar, bienvenue et rôle -->
            <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Bienvenue, Admin" style="-fx-font-size: 14px; -fx-text-fill: #334155;"/>
                <Label fx:id="userRoleLabel" text="Administrateur" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                <StackPane>
                    <ImageView fx:id="avatarImage" fitHeight="40" fitWidth="40" preserveRatio="true">
                        <clip>
                            <Circle centerX="20" centerY="20" radius="20" />
                        </clip>
                    </ImageView>
                </StackPane>
            </HBox>

            <!-- Zone de contenu dynamique -->
            <StackPane fx:id="contentPane" style="-fx-background-color: transparent;"/>
        </VBox>
    </center>
</BorderPane>