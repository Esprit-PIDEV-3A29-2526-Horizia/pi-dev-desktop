<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.admin.AdminDashboardController"
            prefHeight="800" prefWidth="1400">

    <!-- SIDEBAR ADMIN -->
    <left>
        <VBox prefWidth="260" spacing="5"
              style="-fx-background-color: #1a2332; -fx-padding: 20;">

            <Label text="🏔️ HORIZIA"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="MENU ADMIN"
                   style="-fx-text-fill: #64748b; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 20 0 10 0;"/>

            <Button text="🏠 Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14; -fx-alignment: CENTER_LEFT;"/>

            <Button text="✈️ Voyages" onAction="#showVoyages"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14; -fx-alignment: CENTER_LEFT;"/>

            <Button text="📅 Réservations" onAction="#showReservations"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14; -fx-alignment: CENTER_LEFT;"/>

            <Button text="🏨 Logements" onAction="#showLogements"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14; -fx-alignment: CENTER_LEFT;"/>

            <Button text="📰 Publications" onAction="#showPublications"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14; -fx-alignment: CENTER_LEFT;"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="👤 Mode Utilisateur" onAction="#switchToUserMode"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14;"/>

            <Button text="🚪 Déconnexion" onAction="#deconnecter"
                    style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-background-radius: 10; -fx-padding: 15; -fx-font-size: 14;"/>
        </VBox>
    </left>

    <!-- CONTENT AREA -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #f1f5f9;"/>
    </center>

</BorderPane>