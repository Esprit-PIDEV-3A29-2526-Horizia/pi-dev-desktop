<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="cardContainer" prefWidth="400.0" spacing="10.0"
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ReservationCardUserController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="lblDestination" text="DESTINATION" />
                    <Label fx:id="lblDate" text="Date de réservation" style="-fx-text-fill: #64748B; -fx-font-size: 12;" />
                </VBox>
                <Label fx:id="lblStatut" text="STATUT" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="lblPersonnes" text="X Personnes" style="-fx-text-fill: #475569;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAnnuler" text="Annuler" style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-weight: bold; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>