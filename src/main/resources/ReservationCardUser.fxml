<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="cardContainer"
      prefWidth="400.0" minWidth="400.0" maxWidth="400.0"
      spacing="10.0"
      style="-fx-background-color: white;
             -fx-background-radius: 15;
             -fx-padding: 16 18;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 12, 0, 0, 6);"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ReservationCardUserController">

    <children>

        <!-- TOP: Destination + Date + Statut -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblDestination" text="DESTINATION"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Label fx:id="lblDate" text="Réservé le : --/--/----"
                           style="-fx-text-fill: #64748B; -fx-font-size: 12;"/>
                </VBox>

                <!-- Chip statut -->
                <Label fx:id="lblStatut" text="EN ATTENTE"
                       style="-fx-background-color: #FEF3C7;
                              -fx-text-fill: #D97706;
                              -fx-background-radius: 999;
                              -fx-padding: 5 12;
                              -fx-font-weight: bold;
                              -fx-font-size: 12;"/>

            </children>
        </HBox>

        <Separator style="-fx-opacity: 0.35;"/>

        <!-- BOTTOM: personnes + actions -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>

                <Label fx:id="lblPersonnes" text="X personne(s)"
                       style="-fx-text-fill: #475569; -fx-font-size: 13;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- QR visible seulement si CONFIRMEE + qr_code existe -->
                <Button fx:id="btnVoirQr" text="QR Code" onAction="#voirQrCode"
                        visible="false" managed="false"
                        style="-fx-background-color:#23779C;
                               -fx-text-fill:white;
                               -fx-background-radius:10;
                               -fx-font-weight: bold;
                               -fx-padding: 6 14;
                               -fx-cursor:hand;"/>

                <!-- Annuler (sera disable selon statut) -->
                <Button fx:id="btnAnnuler" text="Annuler" onAction="#annulerReservation"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #EF4444;
                               -fx-font-weight: bold;
                               -fx-padding: 6 10;
                               -fx-cursor: hand;"/>

            </children>
        </HBox>

    </children>
</VBox>