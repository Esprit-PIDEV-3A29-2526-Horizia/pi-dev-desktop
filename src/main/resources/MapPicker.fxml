<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<DialogPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MapPickerController">
    <content>
        <VBox spacing="15">
            <WebView fx:id="mapView" prefHeight="400" />
            <HBox spacing="10" alignment="CENTER">
                <Label text="Adresse :" />
                <TextField fx:id="addressField" promptText="Ex: Tunis, Tunisie" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </content>
    <ButtonType fx:id="saveButtonType" text="Valider" buttonData="OK_DONE" />
    <ButtonType fx:id="cancelButtonType" text="Annuler" buttonData="CANCEL_CLOSE" />
</DialogPane>