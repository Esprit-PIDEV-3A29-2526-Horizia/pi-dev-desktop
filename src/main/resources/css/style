.menuBtn {
    -fx-background-color: transparent;
    -fx-text-fill: #E5E7EB;
    -fx-font-size: 13;
    -fx-font-weight: 800;
    -fx-background-radius: 14;
    -fx-padding: 12 14;
    -fx-cursor: hand;
    -fx-border-color: #273244;
    -fx-border-radius: 14;
    -fx-border-width: 1;
}

.list-view {
    -fx-background-color: #F6F7FB;
    -fx-border-color: #D1D5DB;
    -fx-border-radius: 8;
    -fx-padding: 8;
}
