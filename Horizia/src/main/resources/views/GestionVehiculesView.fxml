<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.GestionVehiculesController"
      spacing="25" style="-fx-background-color: #f5f7fa;"
      prefWidth="1400" prefHeight="850">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HEADER -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="18">
        <!-- Bouton Retour -->
        <Button fx:id="btnRetour" text="← Retour" onAction="#retourDashboard"
                style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>

        <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;" prefHeight="40"/>

        <Label text="🚗" style="-fx-font-size: 42px;"/>
        <VBox spacing="4">
            <Label text="Gestion des Véhicules"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
            <Label text="Gérez l'ensemble de votre flotte de véhicules"
                   style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
        </VBox>
    </HBox>

    <Separator style="-fx-background-color: #e5e7eb;"/>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- GRILLE DE CARDS CRUD -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <GridPane hgap="25" vgap="25" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="50"/>
            <RowConstraints percentHeight="50"/>
        </rowConstraints>

        <!-- ────────────────────────────────────────────────────────────── -->
        <!-- CARD 1 : AJOUTER UN VÉHICULE -->
        <!-- ────────────────────────────────────────────────────────────── -->
        <VBox fx:id="cardAjouter" GridPane.columnIndex="0" GridPane.rowIndex="0"
              spacing="20" alignment="CENTER"
              style="-fx-background-color: white;
                     -fx-background-radius: 16;
                     -fx-padding: 40;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-cursor: hand;"
              onMouseClicked="#ouvrirAjouterVehicule">

            <!-- Icône -->
            <VBox alignment="CENTER"
                  style="-fx-background-color: #ecfdf5;
                         -fx-background-radius: 20;
                         -fx-pref-width: 100;
                         -fx-pref-height: 100;">
                <Label text="➕" style="-fx-font-size: 48px;"/>
            </VBox>

            <!-- Titre et Description -->
            <VBox spacing="8" alignment="CENTER">
                <Label text="Ajouter un Véhicule"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
                <Label text="Enregistrez un nouveau véhicule dans la flotte"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="300"/>
            </VBox>

            <!-- Badge -->
            <Label text="CRUD · Create"
                   style="-fx-font-size: 11px; -fx-text-fill: #059669; -fx-background-color: #d1fae5; -fx-padding: 5 15; -fx-background-radius: 12; -fx-font-weight: bold;"/>
        </VBox>

        <!-- ────────────────────────────────────────────────────────────── -->
        <!-- CARD 2 : AFFICHER LES VÉHICULES -->
        <!-- ────────────────────────────────────────────────────────────── -->
        <VBox fx:id="cardAfficher" GridPane.columnIndex="1" GridPane.rowIndex="0"
              spacing="20" alignment="CENTER"
              style="-fx-background-color: white;
                     -fx-background-radius: 16;
                     -fx-padding: 40;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-cursor: hand;"
              onMouseClicked="#ouvrirAfficherVehicules">

            <!-- Icône -->
            <VBox alignment="CENTER"
                  style="-fx-background-color: #eff6ff;
                         -fx-background-radius: 20;
                         -fx-pref-width: 100;
                         -fx-pref-height: 100;">
                <Label text="📋" style="-fx-font-size: 48px;"/>
            </VBox>

            <!-- Titre et Description -->
            <VBox spacing="8" alignment="CENTER">
                <Label text="Afficher les Véhicules"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
                <Label text="Consultez le catalogue complet de tous les véhicules"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="300"/>
            </VBox>

            <!-- Badge -->
            <Label text="CRUD · Read"
                   style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-background-color: #dbeafe; -fx-padding: 5 15; -fx-background-radius: 12; -fx-font-weight: bold;"/>
        </VBox>

        <!-- ────────────────────────────────────────────────────────────── -->
        <!-- CARD 3 : MODIFIER UN VÉHICULE -->
        <!-- ────────────────────────────────────────────────────────────── -->
        <VBox fx:id="cardModifier" GridPane.columnIndex="0" GridPane.rowIndex="1"
              spacing="20" alignment="CENTER"
              style="-fx-background-color: white;
                     -fx-background-radius: 16;
                     -fx-padding: 40;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-cursor: hand;"
              onMouseClicked="#ouvrirModifierVehicule">

            <!-- Icône -->
            <VBox alignment="CENTER"
                  style="-fx-background-color: #fef3c7;
                         -fx-background-radius: 20;
                         -fx-pref-width: 100;
                         -fx-pref-height: 100;">
                <Label text="✏️" style="-fx-font-size: 48px;"/>
            </VBox>

            <!-- Titre et Description -->
            <VBox spacing="8" alignment="CENTER">
                <Label text="Modifier un Véhicule"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
                <Label text="Mettez à jour les informations d'un véhicule existant"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="300"/>
            </VBox>

            <!-- Badge -->
            <Label text="CRUD · Update"
                   style="-fx-font-size: 11px; -fx-text-fill: #d97706; -fx-background-color: #fef3c7; -fx-padding: 5 15; -fx-background-radius: 12; -fx-font-weight: bold;"/>
        </VBox>

        <!-- ────────────────────────────────────────────────────────────── -->
        <!-- CARD 4 : SUPPRIMER UN VÉHICULE -->
        <!-- ────────────────────────────────────────────────────────────── -->
        <VBox fx:id="cardSupprimer" GridPane.columnIndex="1" GridPane.rowIndex="1"
              spacing="20" alignment="CENTER"
              style="-fx-background-color: white;
                     -fx-background-radius: 16;
                     -fx-padding: 40;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);
                     -fx-cursor: hand;"
              onMouseClicked="#ouvrirSupprimerVehicule">

            <!-- Icône -->
            <VBox alignment="CENTER"
                  style="-fx-background-color: #fee2e2;
                         -fx-background-radius: 20;
                         -fx-pref-width: 100;
                         -fx-pref-height: 100;">
                <Label text="🗑️" style="-fx-font-size: 48px;"/>
            </VBox>

            <!-- Titre et Description -->
            <VBox spacing="8" alignment="CENTER">
                <Label text="Supprimer un Véhicule"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
                <Label text="Retirez définitivement un véhicule de la flotte"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="300"/>
            </VBox>

            <!-- Badge -->
            <Label text="CRUD · Delete"
                   style="-fx-font-size: 11px; -fx-text-fill: #dc2626; -fx-background-color: #fee2e2; -fx-padding: 5 15; -fx-background-radius: 12; -fx-font-weight: bold;"/>
        </VBox>

    </GridPane>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- INFO FOOTER -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER" spacing="8" style="-fx-padding: 15 0 0 0;">
        <Label text="💡" style="-fx-font-size: 16px;"/>
        <Label text="Cliquez sur une carte pour accéder à l'opération correspondante"
               style="-fx-font-size: 13px; -fx-text-fill: #9ca3af; -fx-font-style: italic;"/>
    </HBox>

</VBox>
