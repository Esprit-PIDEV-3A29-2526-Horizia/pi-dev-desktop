<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainLayoutController"
            stylesheets="@../css/style.css">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SIDEBAR GAUCHE -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="0">

            <!-- Logo et Titre -->
            <VBox alignment="CENTER" spacing="15" styleClass="sidebar-header">
                <padding>
                    <Insets top="30" bottom="30"/>
                </padding>

                <!-- Logo - Vous pouvez remplacer par votre vraie image -->
                <Label text="🌍" style="-fx-font-size: 48px;"/>

                <Label text="HORIZIA" styleClass="app-title">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>

                <Label text="Agence de voyage" styleClass="app-subtitle">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
            </VBox>

            <!-- Séparateur -->
            <Region styleClass="sidebar-separator" prefHeight="1"/>

            <!-- Menu de Navigation -->
            <VBox spacing="5" VBox.vgrow="ALWAYS" styleClass="sidebar-menu">
                <padding>
                    <Insets top="20" right="15" bottom="20" left="15"/>
                </padding>

                <Label text="MENU" styleClass="menu-label">
                    <font>
                        <Font name="System Bold" size="11"/>
                    </font>
                    <padding>
                        <Insets left="10" bottom="10"/>
                    </padding>
                </Label>

                <!-- Bouton Dashboard -->
                <Button fx:id="btnDashboard"
                        text="Dashboard"
                        disable="true"
                        styleClass="sidebar-button, sidebar-button-disabled"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <Label text="📊" styleClass="menu-icon">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <!-- Bouton Voyages -->
                <Button fx:id="btnVoyages"
                        text="Voyages"
                        disable="true"
                        styleClass="sidebar-button, sidebar-button-disabled"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <Label text="✈️" styleClass="menu-icon">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <!-- Bouton Réservations -->
                <Button fx:id="btnReservations"
                        text="Réservations"
                        disable="true"
                        styleClass="sidebar-button, sidebar-button-disabled"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <Label text="📅" styleClass="menu-icon">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <!-- Bouton Locations (VOTRE PARTIE - ACTIF) -->
                <Button fx:id="btnLocations"
                        text="Locations"
                        onAction="#showGestionLocations"
                        styleClass="sidebar-button, sidebar-button-active"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <Label text="🚗" styleClass="menu-icon">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <!-- Bouton Logements -->
                <Button fx:id="btnLogements"
                        text="🏠 Logements"
                        disable="true"
                        styleClass="sidebar-button, sidebar-button-disabled"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <!-- Spacer pour pousser les éléments en bas -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Séparateur -->
                <Region styleClass="sidebar-separator" prefHeight="1">
                    <VBox.margin>
                        <Insets top="10" bottom="10"/>
                    </VBox.margin>
                </Region>

                <!-- Bouton Conseil -->
                <Button fx:id="btnConseil"
                        text="Conseil"
                        disable="true"
                        styleClass="sidebar-button, sidebar-button-disabled"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <Label text="💡" styleClass="menu-icon">
                            <font>
                                <Font size="18"/>
                            </font>
                        </Label>
                    </graphic>
                    <padding>
                        <Insets top="12" right="15" bottom="12" left="15"/>
                    </padding>
                </Button>

                <!-- Info utilisateur -->
                <VBox styleClass="user-info" spacing="5">
                    <padding>
                        <Insets top="15" right="10" bottom="15" left="10"/>
                    </padding>
                    <Label text="Utilisez le menu pour naviguer" styleClass="user-email">
                        <font>
                            <Font size="10"/>
                        </font>
                    </Label>
                    <Label text="© Horizia" styleClass="copyright">
                        <font>
                            <Font size="9"/>
                        </font>
                    </Label>
                </VBox>

            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- ZONE DE CONTENU PRINCIPAL -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- Le contenu sera chargé ici dynamiquement -->
            <Label text="Chargement..." style="-fx-font-size: 18px; -fx-text-fill: #999;"/>
        </StackPane>
    </center>

</BorderPane>
