<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierLocationController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="0"
          style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #e8ecf1);"
          prefWidth="920">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- HEADER                                                  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <VBox spacing="8" alignment="CENTER" style="-fx-padding: 20 0 30 0;">
            <Label text="✏️" style="-fx-font-size: 56px;"/>
            <Label text="Modifier une Location"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
            <Label text="Recherchez une location puis mettez à jour les informations"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
        </VBox>

        <Separator style="-fx-background-color: #bdc3c7; -fx-padding: 0 0 20 0;"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <VBox spacing="20">

            <!-- ──────────────────────────────────────────────────── -->
            <!-- RECHERCHE                                            -->
            <!-- ──────────────────────────────────────────────────── -->
            <VBox spacing="0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-padding: 14 24;
                             -fx-background-color: #f59e0b10;
                             -fx-background-radius: 16 16 0 0;
                             -fx-border-color: #f59e0b;
                             -fx-border-width: 0 0 0 4;">
                    <Label text="🔍"
                           style="-fx-font-size: 18px; -fx-text-fill: #f59e0b;"/>
                    <Label text="RECHERCHER UNE LOCATION"
                           style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                  -fx-font-weight: bold; -fx-text-fill: #64748b;
                                  -fx-letter-spacing: 2;"/>
                </HBox>

                <VBox spacing="10" style="-fx-padding: 20 24;">
                    <HBox spacing="12">
                        <TextField fx:id="txtRechercheClient"
                                   promptText="Nom ou téléphone du client…"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 14px; -fx-padding: 13 16;
                                          -fx-background-color: #f8fafc;
                                          -fx-border-color: #e2e8f0;
                                          -fx-border-width: 2;
                                          -fx-border-radius: 10;
                                          -fx-background-radius: 10;
                                          -fx-text-fill: #1e293b;
                                          -fx-prompt-text-fill: #94a3b8;"/>
                        <Button text="RECHERCHER"
                                onAction="#rechercherLocation"
                                prefHeight="46" prefWidth="150"
                                style="-fx-background-color: #f59e0b;
                                       -fx-text-fill: white;
                                       -fx-font-family: 'Courier New';
                                       -fx-font-size: 12px; -fx-font-weight: bold;
                                       -fx-background-radius: 10;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, #f59e0b40, 8, 0, 0, 3);"/>
                    </HBox>
                    <Label fx:id="lblMessageRecherche"
                           visible="false" managed="false"
                           style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;
                                  -fx-padding: 10 14; -fx-background-radius: 8;"/>
                </VBox>
            </VBox>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- FORMULAIRE (visible après recherche)                 -->
            <!-- ──────────────────────────────────────────────────── -->
            <VBox fx:id="vboxFormulaire" spacing="20"
                  visible="false" managed="false">

                <!-- Résumé location -->
                <Label fx:id="lblLocationInfo"
                       wrapText="true"
                       style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                              -fx-background-color: #f1f5f9;
                              -fx-padding: 12 16; -fx-background-radius: 8;
                              -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;
                              -fx-border-width: 1; -fx-border-radius: 8;
                              -fx-font-weight: bold;"/>

                <!-- ───────────────────────────────────── -->
                <!-- SCAN CIN (OBLIGATOIRE)                -->
                <!-- ───────────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-padding: 18 24 18 24;
                                 -fx-background-color: #f59e0b10;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #f59e0b;
                                 -fx-border-width: 0 0 0 4;">
                        <Label text="01"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 22px;
                                      -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                        <VBox spacing="2">
                            <Label text="SCAN CIN  —  OBLIGATOIRE"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <Label text="Scannez la CIN pour mettre à jour le numéro automatiquement"
                                   style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="16" style="-fx-padding: 24;">
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <Button fx:id="btnScannerCIN"
                                    text="📷 SCANNER LA CIN"
                                    onAction="#scannerCIN"
                                    prefHeight="52"
                                    style="-fx-background-color: #f59e0b;
                                           -fx-text-fill: white;
                                           -fx-font-family: 'Courier New';
                                           -fx-font-weight: bold;
                                           -fx-font-size: 13px;
                                           -fx-padding: 0 32;
                                           -fx-background-radius: 10;
                                           -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, #f59e0b40, 8, 0, 0, 3);"/>
                            <VBox spacing="4">
                                <Label text="Sélectionnez une photo de la CIN"
                                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                                <Label text="Le numéro CIN (8 chiffres) sera extrait automatiquement"
                                       style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                              -fx-text-fill: #94a3b8;"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="6">
                            <Label text="NUMÉRO CIN *"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <TextField fx:id="txtCIN"
                                       promptText="00000000"
                                       style="-fx-font-family: 'Courier New'; -fx-font-size: 20px;
                                              -fx-font-weight: bold; -fx-padding: 14 18;
                                              -fx-background-color: #f8fafc;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 2;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;
                                              -fx-text-fill: #1e293b;
                                              -fx-prompt-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ───────────────────────────────────── -->
                <!-- INFORMATIONS CLIENT                   -->
                <!-- ───────────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-padding: 14 24;
                                 -fx-background-color: #8b5cf610;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #8b5cf6;
                                 -fx-border-width: 0 0 0 4;">
                        <Label text="02"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 18px;
                                      -fx-font-weight: bold; -fx-text-fill: #8b5cf6;"/>
                        <Label text="INFORMATIONS CLIENT"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-text-fill: #64748b;
                                      -fx-letter-spacing: 2;"/>
                    </HBox>

                    <GridPane hgap="16" vgap="14" style="-fx-padding: 20 24;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="NOM COMPLET"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <TextField fx:id="txtNomClient"
                                       promptText="Ahmed Ben Salah"
                                       style="-fx-font-size: 14px; -fx-padding: 11 14;
                                              -fx-background-color: #f8fafc;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 2;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;
                                              -fx-text-fill: #1e293b;
                                              -fx-prompt-text-fill: #94a3b8;"/>
                        </VBox>

                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="TÉLÉPHONE"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <TextField fx:id="txtTelephone"
                                       promptText="+216 98 123 456"
                                       style="-fx-font-size: 14px; -fx-padding: 11 14;
                                              -fx-background-color: #f8fafc;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 2;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;
                                              -fx-text-fill: #1e293b;
                                              -fx-prompt-text-fill: #94a3b8;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- ───────────────────────────────────── -->
                <!-- ADRESSE                               -->
                <!-- ───────────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-padding: 14 24;
                                 -fx-background-color: #10b98110;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #10b981;
                                 -fx-border-width: 0 0 0 4;">
                        <Label text="03"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 18px;
                                      -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                        <Label text="ADRESSE CLIENT"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-text-fill: #64748b;
                                      -fx-letter-spacing: 2;"/>
                    </HBox>

                    <VBox spacing="14" style="-fx-padding: 20 24;">
                        <VBox spacing="6">
                            <Label text="ADRESSE COMPLÈTE"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <HBox spacing="10">
                                <TextField fx:id="txtAdresse"
                                           promptText="Avenue Habib Bourguiba, Immeuble 15"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-font-size: 14px; -fx-padding: 11 14;
                                                  -fx-background-color: #f8fafc;
                                                  -fx-border-color: #e2e8f0;
                                                  -fx-border-width: 2;
                                                  -fx-border-radius: 10;
                                                  -fx-background-radius: 10;
                                                  -fx-text-fill: #1e293b;
                                                  -fx-prompt-text-fill: #94a3b8;"/>
                                <Button text="📍 Géolocaliser"
                                        onAction="#geocoderAdresseManuel"
                                        prefHeight="44"
                                        style="-fx-background-color: #10b981;
                                               -fx-text-fill: white;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-padding: 0 18;
                                               -fx-background-radius: 10;
                                               -fx-cursor: hand;
                                               -fx-effect: dropshadow(gaussian, #10b98140, 8, 0, 0, 3);"/>
                            </HBox>
                        </VBox>

                        <GridPane hgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="60"/>
                                <ColumnConstraints percentWidth="40"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="VILLE"
                                       style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                              -fx-font-weight: bold; -fx-text-fill: #64748b;
                                              -fx-letter-spacing: 2;"/>
                                <TextField fx:id="txtVille"
                                           promptText="Tunis"
                                           style="-fx-font-size: 14px; -fx-padding: 11 14;
                                                  -fx-background-color: #f8fafc;
                                                  -fx-border-color: #e2e8f0;
                                                  -fx-border-width: 2;
                                                  -fx-border-radius: 10;
                                                  -fx-background-radius: 10;
                                                  -fx-text-fill: #1e293b;
                                                  -fx-prompt-text-fill: #94a3b8;"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="CODE POSTAL"
                                       style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                              -fx-font-weight: bold; -fx-text-fill: #64748b;
                                              -fx-letter-spacing: 2;"/>
                                <TextField fx:id="txtCodePostal"
                                           promptText="1000"
                                           style="-fx-font-size: 14px; -fx-padding: 11 14;
                                                  -fx-background-color: #f8fafc;
                                                  -fx-border-color: #e2e8f0;
                                                  -fx-border-width: 2;
                                                  -fx-border-radius: 10;
                                                  -fx-background-radius: 10;
                                                  -fx-text-fill: #1e293b;
                                                  -fx-prompt-text-fill: #94a3b8;"/>
                            </VBox>
                        </GridPane>

                        <Label fx:id="lblCoordonnees"
                               text=""
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                      -fx-text-fill: #10b981; -fx-padding: 8 12;
                                      -fx-background-color: #d1fae5;
                                      -fx-background-radius: 8;"/>
                    </VBox>
                </VBox>

                <!-- ───────────────────────────────────── -->
                <!-- RETOUR VÉHICULE                       -->
                <!-- ───────────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-padding: 14 24;
                                 -fx-background-color: #06b6d410;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #06b6d4;
                                 -fx-border-width: 0 0 0 4;">
                        <Label text="04"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 18px;
                                      -fx-font-weight: bold; -fx-text-fill: #06b6d4;"/>
                        <Label text="RETOUR DU VÉHICULE"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-text-fill: #64748b;
                                      -fx-letter-spacing: 2;"/>
                    </HBox>

                    <GridPane hgap="16" vgap="14" style="-fx-padding: 20 24;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="DATE FIN RÉELLE"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <DatePicker fx:id="dateFinReelle"
                                        maxWidth="Infinity"
                                        style="-fx-font-size: 13px;
                                               -fx-background-color: #f8fafc;
                                               -fx-border-color: #e2e8f0;
                                               -fx-border-width: 2;
                                               -fx-border-radius: 10;"/>
                        </VBox>

                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="KILOMÉTRAGE RETOUR"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <TextField fx:id="txtKilometrageRetour"
                                       promptText="16500"
                                       style="-fx-font-size: 14px; -fx-padding: 11 14;
                                              -fx-background-color: #f8fafc;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 2;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;
                                              -fx-text-fill: #1e293b;
                                              -fx-prompt-text-fill: #94a3b8;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- ───────────────────────────────────── -->
                <!-- PAIEMENT & STATUT                     -->
                <!-- ───────────────────────────────────── -->
                <VBox spacing="0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                    <HBox spacing="14" alignment="CENTER_LEFT"
                          style="-fx-padding: 14 24;
                                 -fx-background-color: #f43f5e10;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #f43f5e;
                                 -fx-border-width: 0 0 0 4;">
                        <Label text="05"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 18px;
                                      -fx-font-weight: bold; -fx-text-fill: #f43f5e;"/>
                        <Label text="PAIEMENT ET STATUT"
                               style="-fx-font-family: 'Courier New'; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-text-fill: #64748b;
                                      -fx-letter-spacing: 2;"/>
                    </HBox>

                    <GridPane hgap="16" vgap="14" style="-fx-padding: 20 24;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="AVANCE VERSÉE (TND)"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <TextField fx:id="txtAvance"
                                       promptText="0.000"
                                       style="-fx-font-size: 14px; -fx-padding: 11 14;
                                              -fx-background-color: #f8fafc;
                                              -fx-border-color: #e2e8f0;
                                              -fx-border-width: 2;
                                              -fx-border-radius: 10;
                                              -fx-background-radius: 10;
                                              -fx-text-fill: #1e293b;
                                              -fx-prompt-text-fill: #94a3b8;"/>
                        </VBox>

                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="STATUT *"
                                   style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                          -fx-font-weight: bold; -fx-text-fill: #64748b;
                                          -fx-letter-spacing: 2;"/>
                            <ComboBox fx:id="comboStatut"
                                      maxWidth="Infinity"
                                      style="-fx-font-size: 13px; -fx-padding: 8;
                                             -fx-background-color: #f8fafc;
                                             -fx-border-color: #e2e8f0;
                                             -fx-border-width: 2;
                                             -fx-border-radius: 10;
                                             -fx-background-radius: 10;
                                             -fx-text-fill: #1e293b;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- NOTES -->
                <VBox spacing="8"
                      style="-fx-background-color: white; -fx-padding: 20 24;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                    <Label text="NOTES"
                           style="-fx-font-family: 'Courier New'; -fx-font-size: 10px;
                                  -fx-font-weight: bold; -fx-text-fill: #64748b;
                                  -fx-letter-spacing: 2;"/>
                    <TextArea fx:id="txtNotes"
                              promptText="Remarques, état du véhicule au retour…"
                              prefRowCount="3" wrapText="true"
                              style="-fx-font-size: 13px; -fx-padding: 10;
                                     -fx-background-color: #f8fafc;
                                     -fx-border-color: #e2e8f0;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-text-fill: #1e293b;
                                     -fx-prompt-text-fill: #94a3b8;"/>
                </VBox>

                <!-- Message -->
                <Label fx:id="lblMessage"
                       text="" wrapText="true"
                       visible="false" managed="false"
                       style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;
                              -fx-padding: 14; -fx-background-radius: 8;"/>

                <!-- BOUTONS -->
                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Annuler" onAction="#annuler"
                            prefHeight="48" prefWidth="140"
                            style="-fx-background-color: #e5e7eb;
                                   -fx-text-fill: #374151;
                                   -fx-font-family: 'Courier New';
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 10;
                                   -fx-border-radius: 10;
                                   -fx-cursor: hand;"/>
                    <Button text="💾 ENREGISTRER LES MODIFICATIONS"
                            onAction="#enregistrerModifications"
                            prefHeight="48" prefWidth="320"
                            style="-fx-background-color: #f59e0b;
                                   -fx-text-fill: white;
                                   -fx-font-family: 'Courier New';
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 10;
                                   -fx-border-radius: 10;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, #f59e0b40, 12, 0, 0, 4);"/>
                </HBox>

            </VBox><!-- fin vboxFormulaire -->
        </VBox>
    </VBox>
</ScrollPane>