<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierLocationController"
            fitToWidth="true"
            prefHeight="550"
            maxHeight="550"
            style="-fx-background-color: transparent;">

    <VBox spacing="25" style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #e8ecf1);" prefWidth="600">
        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <VBox spacing="8" alignment="CENTER">
            <Label text="✏️" style="-fx-font-size: 56px;"/>
            <Label text="Modifier une Location" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font><Font name="System Bold" size="28"/></font>
            </Label>
        </VBox>

        <Separator/>

        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15;">
            <Label text="🔍 Rechercher la location" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <HBox spacing="15">
                <TextField fx:id="txtRechercheClient" promptText="Nom du client..." HBox.hgrow="ALWAYS" style="-fx-font-size: 14px; -fx-padding: 12;"/>
                <Button text="🔎 Rechercher" onAction="#rechercherLocation" prefWidth="150" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 0; -fx-background-radius: 8;"/>
            </HBox>
            <Label fx:id="lblMessageRecherche" visible="false" managed="false" style="-fx-font-size: 12px; -fx-padding: 10;"/>
        </VBox>

        <VBox fx:id="vboxFormulaire" spacing="20" visible="false" managed="false" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">
            <Label text="✏️ Modifier les informations" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblLocationInfo" style="-fx-font-size: 12px; -fx-background-color: #e8f4f8; -fx-padding: 10; -fx-background-radius: 8;"/>

            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Date fin réelle" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="dateFinReelle" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Kilométrage retour" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtKilometrageRetour" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>

                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Avance versée" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtAvance" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>

                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Statut" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="comboStatut" maxWidth="Infinity" style="-fx-font-size: 14px;"/>
                </VBox>
            </GridPane>

            <VBox spacing="6">
                <Label text="Notes" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextArea fx:id="txtNotes" prefRowCount="3" wrapText="true"/>
            </VBox>

            <Label fx:id="lblMessage" visible="false" managed="false" style="-fx-font-size: 13px; -fx-padding: 12;"/>

            <HBox spacing="15" alignment="CENTER">
                <Button text="✖ Annuler" onAction="#annuler" prefWidth="180" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 0; -fx-background-radius: 10;"/>
                <Button text="💾 Enregistrer" onAction="#enregistrerModifications" prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #f39c12, #e67e22); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14 0; -fx-background-radius: 10;"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
