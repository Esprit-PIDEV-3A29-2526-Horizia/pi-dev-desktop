<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.shape.Rectangle?>
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.client.ClientPlanningController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #0a0f1e; -fx-background: #0a0f1e;">

    <VBox spacing="0" style="-fx-background-color: #0a0f1e;">

        <!-- NAVBAR -->
        <HBox alignment="CENTER_LEFT" spacing="0"
              style="-fx-background-color: rgba(10,15,30,0.95);
                     -fx-padding: 0 40 0 40; -fx-min-height: 65;
                     -fx-border-color: rgba(52,152,219,0.2); -fx-border-width: 0 0 1 0;">
            <Label text="⬡ HORIZIA"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Retour à l'accueil" onAction="#retourAccueil"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent;"/>
        </HBox>

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="12"
              style="-fx-padding: 40 40 20 40;">
            <Label text="📅 Planning des Disponibilités"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Consultez en temps réel les disponibilités des véhicules"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <!-- SÉLECTION VÉHICULE -->
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 0 40 20 40;">
            <Label text="Sélectionner un véhicule :"
                   style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <ComboBox fx:id="comboVehicule" prefWidth="350"
                      style="-fx-background-color: rgba(255,255,255,0.08);
                             -fx-background-radius: 10; -fx-text-fill: white;"/>
        </HBox>

        <!-- NAVIGATION MOIS -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 40;">
            <Button text="◀" onAction="#moisPrecedent"
                    style="-fx-background-color: rgba(255,255,255,0.08);
                           -fx-text-fill: white; -fx-font-size: 16px;
                           -fx-padding: 8 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"/>
            <Label fx:id="lblMoisAnnee" text="MARS 2026"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"
                   minWidth="200" alignment="CENTER"/>
            <Button text="▶" onAction="#moisSuivant"
                    style="-fx-background-color: rgba(255,255,255,0.08);
                           -fx-text-fill: white; -fx-font-size: 16px;
                           -fx-padding: 8 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"/>
            <Button text="📅 Aujourd'hui" onAction="#revenirAujourdhui"
                    style="-fx-background-color: rgba(52,152,219,0.15);
                           -fx-text-fill: #3498db; -fx-font-size: 13px;
                           -fx-padding: 8 16; -fx-background-radius: 8;
                           -fx-cursor: hand; -fx-border-color: rgba(52,152,219,0.3);
                           -fx-border-width: 1; -fx-border-radius: 8;"/>
        </HBox>

        <!-- CALENDRIER -->
        <VBox style="-fx-padding: 20 40 30 40;">
            <GridPane fx:id="gridCalendrier" hgap="6" vgap="6" maxWidth="Infinity"/>
        </VBox>

        <!-- LÉGENDE -->
        <HBox spacing="30" alignment="CENTER" style="-fx-padding: 0 40 30 40;">
            <HBox spacing="8" alignment="CENTER">
                <Rectangle width="16" height="16" fill="#fee2e2" arcWidth="4" arcHeight="4"/>
                <Label text="Occupé" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER">
                <Rectangle width="16" height="16" fill="white" stroke="#dee2e6" arcWidth="4" arcHeight="4"/>
                <Label text="Libre" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER">
                <Rectangle width="16" height="16" fill="#fff3cd" arcWidth="4" arcHeight="4"/>
                <Label text="Aujourd'hui" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            </HBox>
        </HBox>

        <!-- MESSAGE INFO -->
        <VBox alignment="CENTER" style="-fx-padding: 0 40 40 40;">
            <Label fx:id="lblMessage" text="✓ Les périodes en rouge sont déjà réservées"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>

    </VBox>
</ScrollPane>