<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.client.CatalogueVoituresController"
            style="-fx-background-color: #0a0f1e;">

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- HEADER - Version sombre -->
    <!-- ════════════════════════════════════════════════════════ -->
    <top>
        <VBox spacing="20" style="-fx-background-color: #060a14; -fx-padding: 20;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);
                                  -fx-border-color: rgba(3,132,183,0.22);
                                  -fx-border-width: 0 0 1 0;">

            <!-- En-tête avec titre et bouton retour -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Button fx:id="btnRetourAccueil" text="← Retour" onAction="#retourAccueil"
                        style="-fx-background-color: rgba(3,132,183,0.12);
                               -fx-text-fill: #0384b7; -fx-font-size: 14px;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 20;
                               -fx-border-color: rgba(3,132,183,0.28); -fx-border-radius: 8;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="🚗 Catalogue de Voitures"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblNombreResultats" text="0 voiture(s)"
                       style="-fx-font-size: 16px; -fx-text-fill: #0384b7; -fx-font-weight: bold;
                              -fx-background-color: rgba(3,132,183,0.12); -fx-padding: 8 16;
                              -fx-background-radius: 12; -fx-border-color: rgba(3,132,183,0.3);
                              -fx-border-radius: 12;"/>
            </HBox>

            <!-- Barre de filtres - Version sombre -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <!-- Recherche -->
                <VBox spacing="5">
                    <Label text="Rechercher"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtRecherche" promptText="Modèle ou immatriculation..." prefWidth="220"
                               style="-fx-font-size: 14px; -fx-background-radius: 8;
                                      -fx-background-color: rgba(255,255,255,0.08);
                                      -fx-text-fill: white; -fx-prompt-text-fill: #4a5568;"/>
                </VBox>

                <!-- Carburant -->
                <VBox spacing="5">
                    <Label text="Carburant"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbCarburant" prefWidth="150"
                              style="-fx-font-size: 14px; -fx-background-radius: 8;
                                     -fx-background-color: rgba(255,255,255,0.08);
                                     -fx-text-fill: white;"/>
                </VBox>

                <!-- Tri -->
                <VBox spacing="5">
                    <Label text="Trier par"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cbTri" prefWidth="180"
                              style="-fx-font-size: 14px; -fx-background-radius: 8;
                                     -fx-background-color: rgba(255,255,255,0.08);
                                     -fx-text-fill: white;"/>
                </VBox>

                <!-- Prix maximum -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Prix max :"
                               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="lblPrixMax" text="300 TND/jour"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </HBox>
                    <Slider fx:id="sliderPrixMax" min="0" max="300" value="300"
                            showTickLabels="false" showTickMarks="false" prefWidth="250"
                            style="-fx-background-radius: 8;"/>
                </VBox>

                <!-- Bouton réinitialiser -->
                <VBox alignment="BOTTOM_CENTER" spacing="5">
                    <Label text=" " style="-fx-font-size: 11px;"/>
                    <Button text="↻ Réinitialiser" onAction="#reinitialiserFiltres"
                            style="-fx-background-color: rgba(231,76,60,0.15);
                                   -fx-text-fill: #e74c3c; -fx-font-size: 13px;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 16;
                                   -fx-border-color: rgba(231,76,60,0.3); -fx-border-radius: 8;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- CENTER - Zone de contenu (thème sombre) -->
    <!-- ════════════════════════════════════════════════════════ -->
    <center>
        <StackPane style="-fx-background-color: #0a0f1e;">

            <!-- FlowPane pour les cards de voitures -->
            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <FlowPane fx:id="flowPaneVoitures" hgap="25" vgap="25" alignment="CENTER"
                          style="-fx-background-color: transparent; -fx-padding: 30;">
                    <!-- Les cards seront ajoutées dynamiquement par le controller -->
                </FlowPane>
            </ScrollPane>

            <!-- Message "Aucune voiture" (caché par défaut) - Version sombre -->
            <VBox fx:id="vboxAucuneVoiture" spacing="20" alignment="CENTER" visible="false" managed="false"
                  style="-fx-background-color: #0a0f1e; -fx-background-radius: 16; -fx-padding: 60;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 12, 0, 0, 4);
                         -fx-border-color: rgba(3,132,183,0.22); -fx-border-radius: 16;">
                <Label text="🔍" style="-fx-font-size: 64px;"/>
                <Label text="Aucune voiture trouvée"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Essayez de modifier vos critères de recherche"
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                <Button text="↻ Réinitialiser les filtres" onAction="#reinitialiserFiltres"
                        style="-fx-background-color: rgba(52,152,219,0.15); -fx-text-fill: #3498db;
                               -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-padding: 12 24; -fx-font-weight: bold;
                               -fx-border-color: rgba(52,152,219,0.3); -fx-border-radius: 8;"/>
            </VBox>

        </StackPane>
    </center>

</BorderPane>