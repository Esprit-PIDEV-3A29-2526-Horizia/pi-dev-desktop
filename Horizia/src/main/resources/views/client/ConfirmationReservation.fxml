<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.client.ConfirmationReservationController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #0a0f1e; -fx-background: #0a0f1e;">

    <VBox spacing="0" style="-fx-background-color: #0a0f1e;">

        <!-- NAVBAR -->
        <HBox alignment="CENTER_LEFT" spacing="0"
              style="-fx-background-color: rgba(10,15,30,0.95);
                     -fx-padding: 0 40 0 40; -fx-min-height: 65;
                     -fx-border-color: rgba(52,152,219,0.2); -fx-border-width: 0 0 1 0;">
            <Label text="⬡ HORIZIA"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Retour au Catalogue" onAction="#retourCatalogue"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent;"/>
        </HBox>

        <!-- SUCCES BANNER -->
        <VBox alignment="CENTER" spacing="12"
              style="-fx-background-color: rgba(39,174,96,0.1);
                     -fx-padding: 40 40 40 40;
                     -fx-border-color: rgba(39,174,96,0.2); -fx-border-width: 0 0 1 0;">
            <Label text="✓" style="-fx-font-size: 56px; -fx-text-fill: #27ae60;"/>
            <Label text="Réservation Confirmée !"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="lblNumeroReservation" text="Réservation #..."
                   style="-fx-font-size: 18px; -fx-text-fill: #27ae60;"/>
        </VBox>

        <!-- CONTENU PRINCIPAL -->
        <HBox spacing="40" style="-fx-padding: 50 60 50 60; -fx-background-color: #0a0f1e;">

            <!-- GAUCHE : QR Code -->
            <VBox spacing="25" alignment="CENTER" prefWidth="420"
                  style="-fx-background-color: rgba(255,255,255,0.04);
                         -fx-background-radius: 20; -fx-padding: 35;
                         -fx-border-color: rgba(52,152,219,0.2);
                         -fx-border-width: 1; -fx-border-radius: 20;">

                <Label text="▦  QR Code de Réservation"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Label text="Présentez ce code lors du retrait du véhicule"
                       style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

                <!-- QR Code Image -->
                <StackPane style="-fx-background-color: white; -fx-background-radius: 15;
                                  -fx-padding: 10; -fx-min-width: 300; -fx-min-height: 300;">
                    <ImageView fx:id="imgQRCode"
                               fitWidth="300" fitHeight="300"
                               preserveRatio="true" smooth="true"/>
                    <Label fx:id="lblQRLoading" text="Génération du QR Code..."
                           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </StackPane>

                <!-- Bouton sauvegarder QR -->
                <Button text="💾  Sauvegarder le QR Code" onAction="#sauvegarderQRCode"
                        prefWidth="280"
                        style="-fx-background-color: rgba(52,152,219,0.15);
                               -fx-text-fill: #3498db; -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-padding: 12 20; -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-border-color: rgba(52,152,219,0.3); -fx-border-width: 1;
                               -fx-border-radius: 10;"/>
            </VBox>

            <!-- DROITE : Détails + Email -->
            <VBox spacing="25" HBox.hgrow="ALWAYS">

                <!-- Détails réservation -->
                <VBox spacing="18"
                      style="-fx-background-color: rgba(255,255,255,0.04);
                             -fx-background-radius: 20; -fx-padding: 30;
                             -fx-border-color: rgba(255,255,255,0.08);
                             -fx-border-width: 1; -fx-border-radius: 20;">

                    <Label text="Détails de votre Réservation"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <VBox spacing="14">
                        <!-- Ligne client -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="👤" style="-fx-font-size: 18px;"/>
                            <VBox spacing="3">
                                <Label text="CLIENT" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                <Label fx:id="lblClient" text="—"
                                       style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- Ligne véhicule -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="🚗" style="-fx-font-size: 18px;"/>
                            <VBox spacing="3">
                                <Label text="VÉHICULE" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                <Label fx:id="lblVehicule" text="—"
                                       style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- Ligne dates -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📅" style="-fx-font-size: 18px;"/>
                            <VBox spacing="3">
                                <Label text="PÉRIODE" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                <Label fx:id="lblPeriode" text="—"
                                       style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- Ligne montant -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="💰" style="-fx-font-size: 18px;"/>
                            <VBox spacing="3">
                                <Label text="MONTANT TOTAL" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                <Label fx:id="lblMontant" text="—"
                                       style="-fx-font-size: 22px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- Ligne avance -->
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="⚡" style="-fx-font-size: 18px;"/>
                            <VBox spacing="3">
                                <Label text="AVANCE (30%)" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                                <Label fx:id="lblAvance" text="—"
                                       style="-fx-font-size: 16px; -fx-text-fill: #e67e22; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Section Email -->
                <VBox spacing="18"
                      style="-fx-background-color: rgba(39,174,96,0.06);
                             -fx-background-radius: 20; -fx-padding: 30;
                             -fx-border-color: rgba(39,174,96,0.2);
                             -fx-border-width: 1; -fx-border-radius: 20;">

                    <Label text="✉  Recevoir la confirmation par Email"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Label text="Saisissez votre email pour recevoir les détails et votre QR Code"
                           style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="txtEmail"
                                   promptText="votre@email.com"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 14px;
                                          -fx-background-color: rgba(255,255,255,0.08);
                                          -fx-background-radius: 10; -fx-text-fill: white;
                                          -fx-prompt-text-fill: #4a5568;
                                          -fx-padding: 12 15; -fx-border-color: transparent;"/>
                        <Button text="Envoyer →" onAction="#envoyerEmail"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                       -fx-font-size: 14px; -fx-font-weight: bold;
                                       -fx-padding: 12 25; -fx-background-radius: 10;
                                       -fx-cursor: hand; -fx-border-color: transparent;"/>
                    </HBox>

                    <Label fx:id="lblStatutEmail" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #27ae60;"/>
                </VBox>

                <!-- Boutons navigation -->
                <HBox spacing="15">
                    <Button text="🔍 Mes Réservations" onAction="#ouvrirMesReservations"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: rgba(230,126,34,0.15);
                                   -fx-text-fill: #e67e22; -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-padding: 14 20; -fx-background-radius: 12; -fx-cursor: hand;
                                   -fx-border-color: rgba(230,126,34,0.3); -fx-border-width: 1;
                                   -fx-border-radius: 12;"/>
                    <Button text="← Retour au Catalogue" onAction="#retourCatalogue"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color: rgba(255,255,255,0.06);
                                   -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-padding: 14 20; -fx-background-radius: 12; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1;
                                   -fx-border-radius: 12;"/>
                </HBox>

            </VBox>
        </HBox>

        <!-- FOOTER -->
        <VBox alignment="CENTER" spacing="5"
              style="-fx-padding: 25 40; -fx-background-color: #080c18;
                     -fx-border-color: rgba(255,255,255,0.05); -fx-border-width: 1 0 0 0;">
            <Label text="⬡ HORIZIA  —  Réservation sécurisée et confirmée"
                   style="-fx-text-fill: #4a5568; -fx-font-size: 12px;"/>
        </VBox>

    </VBox>
</ScrollPane>
