<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.client.ReservationVoitureController"
            style="-fx-background-color: #0a0f1e;" prefWidth="1000" prefHeight="700">

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- HEADER - Version sombre -->
    <!-- ════════════════════════════════════════════════════════ -->
    <top>
        <VBox spacing="0" style="-fx-background-color: #060a14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);
                                 -fx-border-color: rgba(3,132,183,0.22);
                                 -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER" style="-fx-padding: 20;">
                <Label text="📝 Réservation de Voiture"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
            <Separator style="-fx-background-color: rgba(3,132,183,0.22);"/>
        </VBox>
    </top>

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- CENTER - Formulaire -->
    <!-- ════════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="30" style="-fx-padding: 30; -fx-background-color: transparent;">

                <!-- ═══════════════════════════════════════════════ -->
                <!-- SECTION 1 : Informations Véhicule -->
                <!-- ═══════════════════════════════════════════════ -->
                <VBox spacing="15" style="-fx-background-color: #0a0f1e; -fx-background-radius: 12; -fx-padding: 25;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 3);
                                          -fx-border-color: rgba(3,132,183,0.22); -fx-border-radius: 12;">
                    <Label text="🚗 Voiture Sélectionnée"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Separator style="-fx-background-color: rgba(3,132,183,0.22);"/>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <!-- Image voiture -->
                        <ImageView fx:id="imgVoiture" fitWidth="300" fitHeight="180" preserveRatio="true"
                                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 8, 0, 0, 2);
                                          -fx-border-color: rgba(3,132,183,0.3); -fx-border-radius: 8;"/>

                        <!-- Infos voiture -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblModele" text="Modèle"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label fx:id="lblCaracteristiques" text="Caractéristiques"
                                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                            <Separator prefWidth="200" style="-fx-background-color: rgba(3,132,183,0.22);"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Prix :" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="lblPrixJour" text="0.00 TND/jour"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- SECTION 2 : Dates et Durée -->
                <!-- ═══════════════════════════════════════════════ -->
                <VBox spacing="15" style="-fx-background-color: #0a0f1e; -fx-background-radius: 12; -fx-padding: 25;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 3);
                                          -fx-border-color: rgba(3,132,183,0.22); -fx-border-radius: 12;">
                    <Label text="📅 Période de Location"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Separator style="-fx-background-color: rgba(3,132,183,0.22);"/>

                    <HBox spacing="30">
                        <!-- Date début -->
                        <VBox spacing="8">
                            <Label text="Date de début *"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <DatePicker fx:id="dpDateDebut" prefWidth="200"
                                        style="-fx-font-size: 14px; -fx-background-color: rgba(255,255,255,0.08);
                                               -fx-text-fill: white; -fx-background-radius: 8;"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Heure :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                <Spinner fx:id="spHeureDebut" prefWidth="80" editable="true"
                                         style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white;"/>
                                <Label text="h 00" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            </HBox>
                        </VBox>

                        <!-- Date fin -->
                        <VBox spacing="8">
                            <Label text="Date de retour *"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <DatePicker fx:id="dpDateFin" prefWidth="200"
                                        style="-fx-font-size: 14px; -fx-background-color: rgba(255,255,255,0.08);
                                               -fx-text-fill: white; -fx-background-radius: 8;"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Heure :" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                <Spinner fx:id="spHeureFin" prefWidth="80" editable="true"
                                         style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white;"/>
                                <Label text="h 00" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- SECTION 3 : Informations Client -->
                <!-- ═══════════════════════════════════════════════ -->
                <VBox spacing="15" style="-fx-background-color: #0a0f1e; -fx-background-radius: 12; -fx-padding: 25;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 3);
                                          -fx-border-color: rgba(3,132,183,0.22); -fx-border-radius: 12;">
                    <Label text="👤 Vos Informations"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Separator style="-fx-background-color: rgba(3,132,183,0.22);"/>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <!-- Nom complet -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Nom complet *"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="txtNomComplet" promptText="Ex: Ahmed Ben Salah"
                                       style="-fx-font-size: 14px; -fx-background-radius: 8;
                                              -fx-background-color: rgba(255,255,255,0.08);
                                              -fx-text-fill: white; -fx-prompt-text-fill: #4a5568;"/>
                        </VBox>

                        <!-- Téléphone -->
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Téléphone *"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <HBox spacing="10">
                                <ComboBox fx:id="comboPays" promptText="Pays" prefWidth="170"
                                          style="-fx-font-size: 13px; -fx-background-radius: 8;
                                                 -fx-background-color: rgba(255,255,255,0.08);
                                                 -fx-text-fill: white;"/>
                                <TextField fx:id="txtTelephone" promptText="Ex: 98 123 456"
                                           style="-fx-font-size: 14px; -fx-background-radius: 8;
                                                  -fx-background-color: rgba(255,255,255,0.08);
                                                  -fx-text-fill: white; -fx-prompt-text-fill: #4a5568;"
                                           HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <!-- CIN -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="CIN / Passport *"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="txtCIN" promptText="Ex: 12345678 ou AB123456"
                                       style="-fx-font-size: 14px; -fx-background-radius: 8;
                                              -fx-background-color: rgba(255,255,255,0.08);
                                              -fx-text-fill: white; -fx-prompt-text-fill: #4a5568;"/>
                        </VBox>

                        <!-- Notes -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                            <Label text="Notes additionnelles (optionnel)"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextArea fx:id="txtNotes" promptText="Remarques, demandes spéciales..."
                                      prefRowCount="3" wrapText="true"
                                      style="-fx-font-size: 14px; -fx-background-radius: 8;
                                             -fx-background-color: rgba(255,255,255,0.08);
                                             -fx-text-fill: white; -fx-prompt-text-fill: #4a5568;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- SECTION EXTRAS -->
                <!-- ═══════════════════════════════════════════════ -->
                <VBox spacing="15" style="-fx-background-color: #0a0f1e; -fx-background-radius: 12; -fx-padding: 25;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 3);
                                          -fx-border-color: rgba(3,132,183,0.22); -fx-border-radius: 12;">
                    <Label text="🎁 Options supplémentaires"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Separator style="-fx-background-color: rgba(3,132,183,0.22);"/>

                    <HBox spacing="30" alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkGPS" text="🛰️ GPS (5 TND/jour)"
                                  style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                        <CheckBox fx:id="chkSiegeBebe" text="👶 Siège bébé (3 TND/jour)"
                                  style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                        <CheckBox fx:id="chkAssurance" text="🛡️ Assurance complète (15 TND/jour)"
                                  style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- SECTION Récapitulatif Prix -->
                <!-- ═══════════════════════════════════════════════ -->
                <VBox spacing="15" style="-fx-background-color: linear-gradient(to bottom right, #0a1a2f, #0d1829);
                                          -fx-background-radius: 12; -fx-padding: 25;
                                          -fx-effect: dropshadow(gaussian, rgba(3,132,183,0.3), 12, 0, 0, 4);
                                          -fx-border-color: rgba(3,132,183,0.3); -fx-border-radius: 12;">
                    <Label text="💰 Récapitulatif"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Separator style="-fx-background-color: rgba(3,132,183,0.3);"/>

                    <GridPane hgap="20" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="60"/>
                            <ColumnConstraints percentWidth="40" halignment="RIGHT"/>
                        </columnConstraints>

                        <!-- Durée -->
                        <Label text="Durée de location :"
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="lblNbJours" text="0 jour(s)"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <!-- Prix de base -->
                        <Label text="Prix de base :"
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="lblPrixBase" text="0.000 TND"
                               style="-fx-font-size: 14px; -fx-text-fill: white;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <!-- Extras -->
                        <Label text="Extras :"
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="lblMontantExtras" text="0.000 TND"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3498db;"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"
                                   style="-fx-background-color: rgba(3,132,183,0.3);"/>

                        <!-- Prix total -->
                        <Label text="Montant total :"
                               style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="lblMontantFinal" text="0.000 TND"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Separator GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"
                                   style="-fx-background-color: rgba(3,132,183,0.3);"/>

                        <!-- Avance -->
                        <Label text="Avance à payer (30%) :"
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                               GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <Label fx:id="lblAvance" text="0.000 TND"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"
                               GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                        <!-- Reste -->
                        <Label text="Reste à payer :"
                               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                               GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <Label fx:id="lblResteAPayer" text="0.000 TND"
                               style="-fx-font-size: 14px; -fx-text-fill: #e67e22;"
                               GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    </GridPane>
                </VBox>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- SECTION Conditions et Boutons -->
                <!-- ═══════════════════════════════════════════════ -->
                <VBox spacing="20" style="-fx-background-color: #0a0f1e; -fx-background-radius: 12; -fx-padding: 25;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 3);
                                          -fx-border-color: rgba(3,132,183,0.22); -fx-border-radius: 12;">

                    <!-- Checkbox conditions -->
                    <CheckBox fx:id="cbAccepteConditions" wrapText="true"
                              text="J'accepte les conditions générales de location et je confirme l'exactitude des informations fournies *"
                              style="-fx-font-size: 13px; -fx-text-fill: white;"/>

                    <Separator style="-fx-background-color: rgba(3,132,183,0.22);"/>

                    <!-- Boutons -->
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnAnnuler" text="✖ Annuler" onAction="#annulerReservation"
                                prefWidth="200" prefHeight="45"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white;
                                       -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;
                                       -fx-font-weight: bold; -fx-border-color: rgba(255,255,255,0.2);
                                       -fx-border-radius: 10;"/>

                        <Button fx:id="btnConfirmer" text="✓ Confirmer la Réservation" onAction="#confirmerReservation"
                                prefWidth="250" prefHeight="45"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px;
                                       -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Note légale -->
                    <Label text="* Champs obligatoires"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>