<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AfficherModelesController"
      spacing="20"
      style="-fx-background-color: #f5f7fa;"
      prefWidth="900" prefHeight="600">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                          HEADER SECTION                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="🚗" style="-fx-font-size: 42px;"/>
        <VBox spacing="3">
            <Label text="Catalogue des Modèles de Véhicules"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
            <Label text="Parcourez tous les modèles disponibles par marque"
                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <HBox HBox.hgrow="ALWAYS"/>

        <!-- Compteur de modèles -->
        <VBox alignment="CENTER" spacing="3"
              style="-fx-background-color: linear-gradient(to bottom, #f093fb, #f5576c);
                     -fx-padding: 12 20;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
            <Label fx:id="lblNombreModeles"
                   text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;">
                <font>
                    <Font name="System Bold" size="32"/>
                </font>
            </Label>
            <Label text="modèles"
                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;"/>
        </VBox>

        <!-- Bouton Rafraîchir -->
        <Button text="🔄 Rafraîchir"
                onAction="#rafraichir"
                style="-fx-background-color: #3498db;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-padding: 12 20;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.4), 8, 0, 0, 3);">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Button>
    </HBox>

    <Separator style="-fx-background-color: #d5d8dc;"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                    BARRE DE RECHERCHE ET FILTRES                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="🔍 Recherche et Filtres"
                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #34495e;">
                <font>
                    <Font name="System Bold" size="17"/>
                </font>
            </Label>
            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Badge du filtre actif -->
            <Label fx:id="lblFiltreActif"
                   text="Tous les modèles"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #e74c3c;
                          -fx-background-color: #fadbd8;
                          -fx-padding: 5 12;
                          -fx-background-radius: 15;
                          -fx-font-weight: bold;"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT">

            <!-- Filtre par Marque -->
            <VBox spacing="6">
                <Label text="Filtrer par marque"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <ComboBox fx:id="comboFiltreMarque"
                          prefWidth="220"
                          promptText="Toutes les marques"
                          style="-fx-font-size: 13px; -fx-padding: 8;">
                </ComboBox>
            </VBox>

            <!-- Champ de recherche -->
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Rechercher par nom de modèle"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <TextField fx:id="txtRecherche"
                           promptText="Tapez le nom d'un modèle (ex: Picanto, Clio, Corolla...)..."
                           style="-fx-font-size: 14px;
                                  -fx-padding: 12;
                                  -fx-background-color: #f8f9fa;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #e0e0e0;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 2;"
                           HBox.hgrow="ALWAYS"/>
            </VBox>

            <!-- ComboBox Tri -->
            <VBox spacing="6">
                <Label text="Trier par"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                <ComboBox fx:id="comboTri"
                          prefWidth="200"
                          style="-fx-font-size: 13px; -fx-padding: 8;">
                </ComboBox>
            </VBox>

            <!-- Bouton Réinitialiser -->
            <VBox spacing="6" alignment="BOTTOM_CENTER">
                <Label text=" " style="-fx-font-size: 12px;"/> <!-- Spacer -->
                <Button text="↺ Réinitialiser"
                        onAction="#reinitialiserFiltres"
                        style="-fx-background-color: #95a5a6;
                               -fx-text-fill: white;
                               -fx-font-size: 12px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 16;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Button>
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                      ZONE D'AFFICHAGE DES CARDS                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <VBox VBox.vgrow="ALWAYS" spacing="12">

        <!-- Barre d'info -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblResultats"
                   text="Affichage de tous les modèles"
                   style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNombreResultats"
                   text="0 résultat"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #7f8c8d;
                          -fx-background-color: #ecf0f1;
                          -fx-padding: 5 12;
                          -fx-background-radius: 12;"/>
        </HBox>

        <!-- ScrollPane avec les Cards -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <content>
                <VBox style="-fx-background-color: white;
                             -fx-padding: 25;
                             -fx-background-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">

                    <!-- FlowPane pour les cards -->
                    <FlowPane fx:id="flowPaneModeles"
                              hgap="20"
                              vgap="20"
                              alignment="TOP_LEFT"
                              style="-fx-padding: 10;">
                        <!-- Les cards seront ajoutées dynamiquement ici -->
                    </FlowPane>

                    <!-- Message si aucun modèle -->
                    <VBox fx:id="vboxAucunModele"
                          alignment="CENTER"
                          spacing="15"
                          style="-fx-padding: 60;"
                          visible="false"
                          managed="false">
                        <Label text="📭" style="-fx-font-size: 72px;"/>
                        <Label text="Aucun modèle trouvé"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;">
                            <font>
                                <Font name="System Bold" size="20"/>
                            </font>
                        </Label>
                        <Label text="Essayez de modifier vos critères de recherche ou filtres"
                               style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                          FOOTER INFO                             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER" spacing="15"
          style="-fx-background-color: #ecf0f1;
                 -fx-padding: 12;
                 -fx-background-radius: 8;">
        <Label text="💡" style="-fx-font-size: 16px;"/>
        <Label text="Les modèles sont des données mondiales et ne peuvent pas être modifiés ou supprimés"
               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
    </HBox>

</VBox>
