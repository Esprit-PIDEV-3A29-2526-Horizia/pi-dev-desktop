<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #F5F1E9;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.GestionReservationsAdminController">

    <left>
        <VBox prefWidth="250.0" spacing="10.0"
              style="-fx-background-color: #000328;"
              alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="40.0"/>
            </padding>
            <children>
                <ImageView fitHeight="60.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                    <VBox.margin>
                        <Insets bottom="40.0" left="10.0"/>
                    </VBox.margin>
                    <image>
                        <Image url="@images/logo.png"/>
                    </image>
                </ImageView>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity"
                        onAction="#naviguerCategories"
                        prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #DACEB6; -fx-font-size: 14;"
                        text="Catégories"/>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity"
                        onAction="#naviguerVoyages"
                        prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #DACEB6; -fx-font-size: 14;"
                        text="Voyages"/>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity"
                        prefHeight="45.0"
                        style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                        text="Réservations"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button onAction="#handleDeconnexion" prefHeight="45.0" prefWidth="210.0"
                        style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-background-radius: 10;"
                        text="Déconnexion"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding>
                        <Insets bottom="16" left="16" right="16" top="16"/>
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #23779C;"
                               text="GESTION DES RÉSERVATIONS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <VBox spacing="0.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding>
                        <Insets bottom="15" left="15" right="15" top="15"/>
                    </padding>
                    <children>
                        <GridPane style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints halignment="CENTER" percentWidth="15.0" />
                                <ColumnConstraints halignment="CENTER" percentWidth="15.0" />
                                <ColumnConstraints halignment="CENTER" percentWidth="20.0" />
                            </columnConstraints>
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Voyage" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Client" GridPane.columnIndex="1" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Places" GridPane.columnIndex="2" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Statut" GridPane.columnIndex="3" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Actions" GridPane.columnIndex="4" />
                            </children>
                        </GridPane>

                        <ScrollPane fitToWidth="true"
                                    style="-fx-background-color: transparent; -fx-background-insets: 0;"
                                    VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="containerToutesReservations" spacing="10.0" style="-fx-padding: 10 0 0 0;" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>