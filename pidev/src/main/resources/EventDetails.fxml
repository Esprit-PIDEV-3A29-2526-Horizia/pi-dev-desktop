<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.ToggleGroup?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.EventDetailsController">
    <content>
        <VBox spacing="25" style="-fx-background-color: #f5f7fb; -fx-padding: 30;" alignment="TOP_CENTER" prefWidth="1200" maxWidth="1200">

            <HBox alignment="CENTER_LEFT" prefWidth="1180">
                <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #23779C; -fx-font-size: 14px; -fx-cursor: hand;" text="← Retour" />
            </HBox>

            <StackPane fx:id="imageContainer" prefHeight="300" prefWidth="1100" style="-fx-background-color: #f0f0f0; -fx-background-radius: 15;">
                <ImageView fx:id="eventImage" fitWidth="1100" fitHeight="300" preserveRatio="true" />
            </StackPane>

            <Label fx:id="categoryLabel" style="-fx-background-color: #DACEB6; -fx-text-fill: #23779C; -fx-background-radius: 20; -fx-padding: 5 20; -fx-font-size: 14px; -fx-font-weight: bold;" />

            <Label fx:id="titleLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #23779C;" wrapText="true" alignment="CENTER" />

            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" prefWidth="1100">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📍" style="-fx-font-size: 18px;" />
                    <Label fx:id="locationLabel" style="-fx-text-fill: #666; -fx-font-size: 16px;" />
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📅" style="-fx-font-size: 18px;" />
                    <Label fx:id="datesLabel" style="-fx-text-fill: #666; -fx-font-size: 16px;" />
                </HBox>
            </VBox>

            <!-- Section Météo -->
            <VBox fx:id="weatherBox" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;" prefWidth="1100" visible="false" managed="false">
                <Label text="🌤️ Météo prévue" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <ImageView fx:id="weatherIcon" fitWidth="50" fitHeight="50" />

                    <VBox spacing="5">
                        <Label fx:id="weatherLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                        <HBox spacing="15">
                            <Label fx:id="tempLabel" style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                            <Label fx:id="humidityLabel" style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                            <Label fx:id="windLabel" style="-fx-font-size: 14px; -fx-text-fill: #666;" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- TAB PANE avec localisation et artiste -->
            <TabPane prefHeight="300" prefWidth="1100" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
                <tabs>


                    <!-- Onglet Artiste (nouveau) -->
                    <!-- Onglet Artiste -->
                    <Tab text="🎤 Artiste" fx:id="artistTab" disable="true">
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                            <VBox fx:id="artistInfoBox" spacing="20" style="-fx-padding: 20;">

                                <!-- En-tête avec image et nom -->
                                <HBox spacing="20" alignment="CENTER_LEFT">
                                    <ImageView fx:id="artistImageView" fitWidth="150" fitHeight="150" preserveRatio="true"
                                               style="-fx-background-color: #f0f0f0; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" />
                                    <VBox spacing="10">
                                        <Label fx:id="artistNameLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
                                        <Label fx:id="artistListenersLabel" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
                                        <Hyperlink fx:id="artistLink" style="-fx-text-fill: #3D94CA; -fx-font-size: 14px;" text="Voir sur Last.fm" />
                                    </VBox>
                                </HBox>

                                <!-- Tags (genres) - Version simple sans FlowPane pour éviter les erreurs -->
                                <VBox spacing="8">
                                    <Label text="Genres" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
                                    <FlowPane fx:id="artistTagsBox" hgap="10" vgap="10" prefWrapLength="800" />                                </VBox>

                                <!-- Biographie -->
                                <VBox spacing="8">
                                    <Label text="Biographie" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
                                    <Label fx:id="artistBioLabel" wrapText="true" style="-fx-text-fill: #666; -fx-font-size: 14px; -fx-line-spacing: 5;" />
                                </VBox>

                                <!-- Top titres -->
                                <VBox spacing="8">
                                    <Label text="Titres populaires" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
                                    <VBox fx:id="topTracksBox" spacing="10" />
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </Tab>
                </tabs>
            </TabPane>

            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" prefWidth="1100">
                <Label text="Description" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
                <Label fx:id="descriptionLabel" wrapText="true" style="-fx-text-fill: #666; -fx-font-size: 14px;" />
            </VBox>

            <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;" prefWidth="1100">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Prix" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                    <Label fx:id="priceLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #81AE8D;" />
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="40" />
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Places disponibles" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                    <Label fx:id="availableLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="40" />
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Capacité totale" style="-fx-text-fill: #666; -fx-font-size: 12px;" />
                    <Label fx:id="capacityLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
                </VBox>
            </HBox>

            <VBox fx:id="bookingForm" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;" prefWidth="1100" visible="false" managed="false">
                <Label text="Réserver cet événement" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />

                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="Nom complet :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #666;" />
                    <TextField fx:id="nomField" promptText="Votre nom" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 10;" />

                    <Label text="Email :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #666;" />
                    <TextField fx:id="emailField" promptText="votre@email.com" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 10;" />

                    <Label text="Téléphone :" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #666;" />
                    <TextField fx:id="telephoneField" promptText="Votre téléphone" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 10;" />

                    <Label text="Nombre de places :" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #666;" />
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <Spinner fx:id="placesSpinner" prefWidth="100" />
                        <Label fx:id="totalPriceLabel" text="0 DT" style="-fx-text-fill: #81AE8D; -fx-font-size: 18px; -fx-font-weight: bold;" />
                    </HBox>
                </GridPane>

                <Button onAction="#handleConfirmBooking" text="Confirmer la réservation"
                        style="-fx-background-color: #81AE8D; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 10; -fx-cursor: hand;"
                        maxWidth="Infinity" />
            </VBox>

            <!-- SECTION RECOMMANDATIONS -->
            <VBox fx:id="recommandationsBox" spacing="15" style="-fx-padding: 25 0 0 0;" visible="true" managed="true">
                <Label text="🔍 Vous aimerez aussi" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #23779C;" />

                <HBox spacing="15" alignment="CENTER">
                    <Label text="Type de recommandation :" style="-fx-text-fill: #666;" />
                    <RadioButton fx:id="radioSimple" text="Simple" selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="niveauRecommandation" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="radioSimilarite" text="Par similarité" toggleGroup="$niveauRecommandation" />
                    <RadioButton fx:id="radioCollaboratif" text="Collaboratif" toggleGroup="$niveauRecommandation" />
                    <Button text="Actualiser" onAction="#handleRecommandation"
                            style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-background-radius: 8;" />
                </HBox>

                <FlowPane fx:id="recommandationsFlow" hgap="15" vgap="15" prefWrapLength="1100" style="-fx-padding: 10;" />
            </VBox>

            <VBox fx:id="fullMessage" spacing="10" style="-fx-background-color: #e74c3c; -fx-background-radius: 15; -fx-padding: 20;" prefWidth="1100" alignment="CENTER" visible="false" managed="false">
                <Label text="COMPLET" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label text="Cet événement n'a plus de places disponibles" style="-fx-text-fill: white; -fx-font-size: 14px;" />
            </VBox>

            <Region prefHeight="20" />
        </VBox>
    </content>
</ScrollPane>