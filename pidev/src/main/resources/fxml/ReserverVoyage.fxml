<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1200" prefHeight="720"
            xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.ReserverVoyageController"
            stylesheets="@../details.css"
            styleClass="page">

    <!-- Barre de navigation partagée -->
    <top>
        <fx:include fx:id="navbar" source="Navbar.fxml" />
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <HBox spacing="28" styleClass="content">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                <!-- LEFT CARD -->
                <VBox spacing="18" HBox.hgrow="ALWAYS" styleClass="card">
                    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

                    <Label fx:id="lblTitre" text="Voyage à ..." styleClass="title"/>

                    <StackPane styleClass="imageContainer">
                        <ImageView fx:id="imgVoyage" fitHeight="300" preserveRatio="true"/>
                    </StackPane>

                    <Label text="Découvre ta destination" styleClass="subtitle"/>
                    <Label fx:id="lblDescription" wrapText="true" styleClass="paragraph"/>
                </VBox>

                <!-- RIGHT CARD -->
                <VBox spacing="18" prefWidth="420" styleClass="card">
                    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

                    <Label text="Finaliser ma réservation" styleClass="titleSmall"/>

                    <!-- Nombre total de personnes -->
                    <VBox spacing="5">
                        <Label text="Nombre de personnes" styleClass="label"/>
                        <Spinner fx:id="spinnerPlaces" prefHeight="40" editable="false"/>
                        <Label fx:id="errorPersonnes" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" managed="false"/>
                    </VBox>

                    <!-- Répartition adultes/enfants -->
                    <VBox spacing="8">
                        <Label text="Répartition" styleClass="label"/>
                        <HBox spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Adultes" style="-fx-text-fill: #1A3C5A; -fx-font-size: 13px;"/>
                                <Spinner fx:id="spinnerAdultes" prefHeight="40" prefWidth="150" editable="false"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Enfants" style="-fx-text-fill: #1A3C5A; -fx-font-size: 13px;"/>
                                <Spinner fx:id="spinnerEnfants" prefHeight="40" prefWidth="150" editable="false"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="errorRepartition" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" managed="false"/>
                    </VBox>

                    <Separator/>

                    <!-- SUMMARY BOX -->
                    <VBox spacing="14" styleClass="summaryBox">

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Prix unitaire" styleClass="muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblPrixUnitaire" text="0.0 DT" styleClass="value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Devise" styleClass="muted"/>
                            <ChoiceBox fx:id="cbCurrency" prefWidth="110"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblPrixUnitaireFx" text="--" styleClass="value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblRateInfo" text="Taux: --" styleClass="muted"/>
                        </HBox>

                        <Separator/>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Total à payer" styleClass="totalLabel"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblPrixTotal" text="0 DT" styleClass="totalValue"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Total (devise)" styleClass="muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblPrixTotalFx" text="--" styleClass="value"/>
                        </HBox>

                    </VBox>

                    <Button text="Confirmer la réservation"
                            onAction="#confirmerReservation"
                            prefHeight="46"
                            maxWidth="9999"
                            styleClass="primaryBtn"/>

                    <Label fx:id="lblAIStatus" text="" styleClass="hint"/>
                    <Label text="Paiement sécurisé • Annulation selon conditions"
                           styleClass="hint"/>

                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>