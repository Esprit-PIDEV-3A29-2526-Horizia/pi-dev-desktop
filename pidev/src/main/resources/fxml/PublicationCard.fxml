<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
      prefWidth="280" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.PublicationCardController">

    <StackPane>
        <ImageView fx:id="imageView" fitHeight="150" fitWidth="250" preserveRatio="true"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 10;" />

        <Button fx:id="favoriBtn" text="★" minWidth="40" prefWidth="40" minHeight="35"
                style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: #888;
                       -fx-font-size: 18; -fx-background-radius: 25; -fx-cursor: hand; -fx-padding: 0;"
                StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets top="8" right="8" />
            </StackPane.margin>
        </Button>
    </StackPane>

    <Label fx:id="categorieLabel" style="-fx-text-fill: #3b82f6; -fx-font-size: 13;" />

    <Label fx:id="titreLabel" wrapText="true"
           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

    <Label fx:id="auteurLabel" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />

    <Label fx:id="dateLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />

    <Label fx:id="descriptionLabel" wrapText="true"
           style="-fx-text-fill: #475569; -fx-font-size: 13;" maxHeight="50" />

    <HBox spacing="8" alignment="CENTER_LEFT">

        <!-- LIKE -->
        <Button fx:id="likeButton" text="&#9829;" minWidth="38" prefWidth="38" minHeight="35"
                style="-fx-background-color: transparent; -fx-text-fill: #ef4444;
                       -fx-font-size: 18; -fx-cursor: hand; -fx-padding: 0;"/>

        <Label fx:id="likesLabel" text="0" minWidth="25" prefWidth="25"
               style="-fx-text-fill: #ef4444; -fx-font-size: 13; -fx-font-weight: bold;"/>

        <Region HBox.hgrow="ALWAYS" />

        <!-- COMMENTAIRE -->
        <Button fx:id="commentairesBtn" minWidth="38" prefWidth="38" maxWidth="38" minHeight="35"/>

        <Label fx:id="commentairesLabel" text="0" minWidth="20" prefWidth="20"
               style="-fx-text-fill: #3b82f6; -fx-font-size: 13; -fx-font-weight: bold;"/>

        <!-- MODIFIER — caché par défaut, affiché par setAdminMode(true) -->
        <Button fx:id="modifierBtn" minWidth="38" prefWidth="38" maxWidth="38" minHeight="32"
                visible="false" managed="false"/>

        <!-- SUPPRIMER — caché par défaut, affiché par setAdminMode(true) -->
        <Button fx:id="supprimerBtn" minWidth="38" prefWidth="38" maxWidth="38" minHeight="32"
                visible="false" managed="false"/>

    </HBox>
</VBox>