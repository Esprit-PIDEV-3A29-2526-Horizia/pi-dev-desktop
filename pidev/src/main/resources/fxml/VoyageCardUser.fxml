<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="cardContainer"
      prefWidth="390" minWidth="390" maxWidth="390"
      prefHeight="285" minHeight="285" maxHeight="285"
      spacing="10"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.VoyageCardUserController"
      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 14;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 14, 0, 0, 6);">

    <!-- ================= IMAGE + BADGES ================= -->
    <StackPane fx:id="imageZone">

        <ImageView fx:id="imgVoyage"
                   fitWidth="362" fitHeight="135"
                   preserveRatio="false"
                   smooth="true"/>

        <!-- Badge statut (DISPONIBLE / COMPLET) -->
        <Label fx:id="badgeStatus" text="DISPONIBLE"
               StackPane.alignment="TOP_LEFT"
               style="-fx-background-color: #DCFCE7; -fx-text-fill: #059669;
                      -fx-background-radius: 14; -fx-padding: 3 10;
                      -fx-font-weight: bold; -fx-font-size: 11;">
            <StackPane.margin>
                <Insets top="10" left="10" right="0" bottom="0"/>
            </StackPane.margin>
        </Label>

        <!-- Chip météo (glass) -->
        <HBox fx:id="meteoChip"
              spacing="6"
              alignment="CENTER_LEFT"
              StackPane.alignment="BOTTOM_LEFT"
              visible="false"
              managed="false"
              style="-fx-background-color: rgba(15,23,42,0.65);
                     -fx-background-radius: 14;
                     -fx-padding: 6 10;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 8, 0, 0, 2);">
            <StackPane.margin>
                <Insets bottom="10" left="10"/>
            </StackPane.margin>

            <ImageView fx:id="imgMeteo"
                       fitWidth="18" fitHeight="18"
                       preserveRatio="true"/>

            <Label fx:id="lblMeteo"
                   text="Météo..."
                   style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold;"/>
        </HBox>

    </StackPane>

    <!-- ================= INFOS ================= -->
    <VBox spacing="6">

        <Label fx:id="lblDestination"
               wrapText="true"
               maxHeight="44"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

        <Label fx:id="lblDates"
               maxHeight="20"
               style="-fx-text-fill: #64748B; -fx-font-size: 12;"/>

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblPrix"
                   style="-fx-text-fill: #E8B156; -fx-font-weight: bold; -fx-font-size: 13;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblPlacesInfo"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12;"/>
        </HBox>

    </VBox>

    <!-- ================= ACTION ================= -->
    <Button fx:id="btnReserver" text="Réserver" onAction="#handleReserver"
            prefHeight="34" maxWidth="9999"
            style="-fx-background-color: #E8B156; -fx-text-fill: white;
                   -fx-background-radius: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>

</VBox>