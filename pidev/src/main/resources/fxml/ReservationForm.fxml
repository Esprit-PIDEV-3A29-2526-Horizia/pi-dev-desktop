<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="900" prefWidth="1400" style="-fx-background-color: #F6F7FB;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ReservationFormController">

    <top>
        <fx:include fx:id="navbar" source="Navbar.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- Section Héro -->
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: linear-gradient(to right, #23779C, #3D94CA); -fx-background-radius: 25; -fx-padding: 40;">
                    <effect><DropShadow color="#00000022" offsetY="5" radius="15"/></effect>
                    <Label text="Réservez votre séjour" textFill="WHITE" style="-fx-font-size: 36px; -fx-font-weight: bold;"/>
                    <Label text="Remplissez les détails pour confirmer votre réservation" textFill="#DACEB6" style="-fx-font-size: 18px;"/>
                </VBox>

                <HBox spacing="30" alignment="TOP_CENTER">

                    <!-- Colonne gauche : Formulaire -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);" prefWidth="550">

                        <!-- Dates -->
                        <VBox spacing="15">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 16px;" text="📅 Période de réservation"/>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Date d'arrivée" style="-fx-text-fill: #1A3C5A;"/>
                                    <DatePicker fx:id="dateArriveePicker" style="-fx-background-radius: 10; -fx-background-color: #F6F7FB;" prefWidth="200"/>
                                    <Label fx:id="arriveeErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Date de départ" style="-fx-text-fill: #1A3C5A;"/>
                                    <DatePicker fx:id="dateDepartPicker" style="-fx-background-radius: 10; -fx-background-color: #F6F7FB;" prefWidth="200"/>
                                    <Label fx:id="departErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="dureeErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false"/>
                        </VBox>

                        <!-- Nombre de personnes -->
                        <VBox spacing="10">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 16px;" text="👥 Voyageurs"/>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Adultes" style="-fx-text-fill: #1A3C5A;"/>
                                    <Spinner fx:id="adultesSpinner" prefWidth="120" editable="false"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Enfants" style="-fx-text-fill: #1A3C5A;"/>
                                    <Spinner fx:id="enfantsSpinner" prefWidth="120" editable="false"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="capaciteErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false"/>
                        </VBox>

                        <!-- Formule de pension -->
                        <VBox spacing="10">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 16px;" text="🍽️ Formule de pension"/>
                            <VBox spacing="8">
                                <RadioButton style="-fx-text-fill: #1A3C5A;" fx:id="petitDejeunerRadio" text="🥐 Logement + Petit déjeuner" selected="true"/>
                                <RadioButton style="-fx-text-fill: #1A3C5A;" fx:id="demiPensionRadio" text="🍽️ Demi-pension (Petit déj + Déjeuner/Dîner)"/>
                                <RadioButton style="-fx-text-fill: #1A3C5A;" fx:id="allInclusiveRadio" text="🍾 All inclusive (Tous repas + Boissons)"/>
                                <RadioButton style="-fx-text-fill: #1A3C5A;" fx:id="allInclusiveSoftRadio" text="🥤 All inclusive soft (Sans alcool)"/>
                            </VBox>
                            <Label fx:id="pensionErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false"/>
                        </VBox>

                        <!-- Nombre de chambres (pour hôtels) -->
                        <VBox spacing="10" fx:id="chambresContainer" visible="false" managed="false">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 16px;" text="🛏️ Chambres"/>
                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Nombre de chambres" style="-fx-text-fill: #1A3C5A;"/>
                                    <Spinner fx:id="chambresSpinner" prefWidth="120" editable="false"/>
                                </VBox>
                            </HBox>
                            <TextArea fx:id="repartitionChambres" promptText="Répartition des chambres (ex: 2 chambres doubles, 1 suite)" prefHeight="60" wrapText="true" style="-fx-background-radius: 10;"/>
                        </VBox>

                        <!-- Modalité de paiement -->
                        <VBox spacing="10">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 16px;" text="💳 Modalité de paiement"/>
                            <HBox spacing="20">
                                <RadioButton style="-fx-text-fill: #1A3C5A;" fx:id="enLigneRadio" text="💳 En ligne (Stripe)" selected="true"/>
                                <RadioButton style="-fx-text-fill: #1A3C5A;" fx:id="surPlaceRadio" text="🏧 Sur place"/>
                            </HBox>
                            <Label fx:id="modaliteErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false"/>
                        </VBox>

                        <!-- Option paiement immédiat -->
                        <VBox spacing="10" fx:id="paiementImmediatContainer" visible="true" managed="true">
                            <CheckBox style="-fx-text-fill: #1A3C5A;" fx:id="paiementImmediatCheckbox" text="Payer immédiatement (réservation confirmée automatiquement)" selected="true"/>
                            <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Si non coché, vous aurez 24h pour finaliser votre paiement"/>
                        </VBox>

                        <!-- Détail du calcul -->
                        <VBox spacing="10" style="-fx-background-color: #F6F7FB; -fx-background-radius: 15; -fx-padding: 15;">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 16px;" text="💰 Détail du calcul"/>
                            <GridPane hgap="15" vgap="8">
                                <Label text="Nombre de nuits :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #1A3C5A;"/>
                                <Label fx:id="nuitsLabel" text="1" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>

                                <Label text="Voyageurs :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #1A3C5A;"/>
                                <Label fx:id="voyageursLabel" text="1 personne" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>

                                <Label text="Formule choisie :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #1A3C5A;"/>
                                <Label fx:id="formuleLabel" text="Petit déjeuner" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>

                                <Label text="Prix par personne/nuit :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #1A3C5A;"/>
                                <Label fx:id="prixParPersonneLabel" text="0 DT" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: #E8B156;"/>

                                <Separator GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4" />

                                <Label text="Total à payer :" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A3C5A;"/>
                                <Label fx:id="totalLabel" text="0 DT" GridPane.columnIndex="1" GridPane.rowIndex="5" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #E8B156;"/>
                            </GridPane>
                        </VBox>

                        <!-- Boutons -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="confirmerBtn" text="Confirmer la réservation" style="-fx-background-color: #81AE8D; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="annulerBtn" text="Annuler" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Colonne droite : Information logement -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);" prefWidth="500">
                        <ImageView fx:id="imageLogement" fitHeight="250" fitWidth="450" preserveRatio="true" style="-fx-border-radius: 15; -fx-background-radius: 15;"/>
                        <Label fx:id="nomLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #23779C;" wrapText="true"/>
                        <Label fx:id="typeLabel" style="-fx-text-fill: #1A3C5A; -fx-font-size: 14px;"/>
                        <Label fx:id="adresseLabel" style="-fx-text-fill: #81AE8D; -fx-font-size: 14px;" wrapText="true"/>
                        <Label fx:id="capaciteLabel" style="-fx-text-fill: #1A3C5A; -fx-font-size: 14px;"/>
                        <Label fx:id="prixLabel" style="-fx-font-weight: bold; -fx-text-fill: #E8B156; -fx-font-size: 18px;"/>
                        <Label fx:id="equipementLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;" wrapText="true"/>
                        <Label fx:id="disponibiliteLabel" style="-fx-text-fill: #81AE8D; -fx-font-size: 14px;"/>

                        <Separator/>
                        <Label text="📋 Informations importantes" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>
                        <Label text="• Le paiement en ligne est sécurisé par Stripe" style="-fx-text-fill: #666; -fx-font-size: 11px;" wrapText="true"/>
                        <Label text="• Les réservations sur place doivent être confirmées" style="-fx-text-fill: #666; -fx-font-size: 11px;" wrapText="true"/>
                        <Label text="• Annulation gratuite jusqu'à 48h avant l'arrivée" style="-fx-text-fill: #666; -fx-font-size: 11px;" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>