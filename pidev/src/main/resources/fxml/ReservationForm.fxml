<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800" prefWidth="1300" style="-fx-background-color: #F6F7FB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ReservationFormController">

    <!-- Barre de navigation (style fourni) -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1A3C5A; -fx-padding: 15 40;">
                <!-- Logo (à remplacer par votre image) -->
                <ImageView fitHeight="45.0" fitWidth="140.0" preserveRatio="true">
                    <image>
                        <Image url="@/image/logo.png" />
                    </image>
                </ImageView>
                <Region HBox.hgrow="ALWAYS" />

                <!-- Liens de navigation -->
                <HBox alignment="CENTER" spacing="30">
                    <Button fx:id="accueilBtn" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;" text="Accueil" />
                    <Button fx:id="nosLogementsBtn" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;" text="Nos Logements" />
                    <Button fx:id="mesReservationsBtn" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;" text="Mes Réservations" />
                    <Button fx:id="vayagerBtn" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;" text="Vayager" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Profil utilisateur -->
                <HBox fx:id="userBox" alignment="CENTER" spacing="12" style="-fx-background-color: #3D94CA; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 16;" text="👤" />
                    <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Connexion" />
                </HBox>
            </HBox>
            <!-- Ligne verte décorative -->
            <Region prefHeight="4" style="-fx-background-color: #2ECC71;" />
        </VBox>
    </top>

    <!-- Contenu principal avec scroll -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="25" style="-fx-padding: 30;">

                <!-- Section Héro (gradient) -->
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: linear-gradient(to right, #23779C, #3D94CA); -fx-background-radius: 25; -fx-padding: 40;">
                    <effect>
                        <DropShadow color="#00000022" offsetY="5" radius="15" />
                    </effect>
                    <Label style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;" text="Réservez votre séjour" />
                    <Label style="-fx-text-fill: #DACEB6; -fx-font-size: 18px;" text="Remplissez les détails pour confirmer votre réservation" />
                </VBox>

                <!-- Zone deux colonnes : formulaire à gauche, détails à droite -->
                <HBox spacing="30" style="-fx-padding: 0 20;">

                    <!-- Colonne gauche : formulaire de réservation (carte blanche) -->
                    <VBox maxWidth="Infinity" prefHeight="479.0" prefWidth="688.0" spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">

                        <!-- Dates d'arrivée et départ -->
                        <GridPane hgap="20" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" />
                                <ColumnConstraints percentWidth="50" />
                            </columnConstraints>
                            <!-- Arrivée -->
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C;" text="Date d’arrivée" />
                                <DatePicker fx:id="dateArriveePicker" prefWidth="200" style="-fx-background-radius: 10; -fx-background-color: #F6F7FB;" />
                                <Label fx:id="arriveeErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false" />
                            </VBox>
                            <!-- Départ -->
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C;" text="Date de départ" />
                                <DatePicker fx:id="dateDepartPicker" prefWidth="200" style="-fx-background-radius: 10; -fx-background-color: #F6F7FB;" />
                                <Label fx:id="departErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false" />
                            </VBox>
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>

                        <!-- Modalité de paiement (radio) -->
                        <VBox prefHeight="40.0" prefWidth="335.0" spacing="5">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C;" text="Modalité de paiement" />
                            <HBox spacing="20">
                                <RadioButton fx:id="enLigneRadio" style="-fx-text-fill: #1A3C5A;" text="En ligne">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="modaliteGroup" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="surPlaceRadio" style="-fx-text-fill: #1A3C5A;" text="Sur place" toggleGroup="$modaliteGroup" />
                            </HBox>
                            <Label fx:id="modaliteErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false" />
                        </VBox>

                        <!-- Détails du paiement (tableau) -->
                        <VBox prefHeight="132.0" prefWidth="514.0" spacing="5">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C;" text="Détails du paiement" />
                            <GridPane hgap="10" prefHeight="85.0" prefWidth="423.0" vgap="5">
                                <columnConstraints>
                                    <ColumnConstraints halignment="LEFT" minWidth="150.0" />
                                    <ColumnConstraints halignment="RIGHT" minWidth="50.0" />
                                </columnConstraints>
                                <Label style="-fx-text-fill: #1A3C5A;" text="Nombre de nuits :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <HBox alignment="CENTER_RIGHT" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label fx:id="nuitsLabel" style="-fx-text-fill: #1A3C5A;" text="1" />
                                    <Label style="-fx-text-fill: #1A3C5A;" text="nuit(s)" />
                                </HBox>
                                <Label style="-fx-text-fill: #1A3C5A;" text="Prix par nuit :" GridPane.rowIndex="1" />
                                <!-- Label dynamique pour prix par nuit (à ajouter dans le controller) -->
                                <Label fx:id="prixParNuitLabel" style="-fx-text-fill: #1A3C5A;" text="200 DT" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label style="-fx-text-fill: #1A3C5A;" text="Frais du service :" GridPane.rowIndex="2" />
                                <Label style="-fx-text-fill: #1A3C5A;" text="0 DT" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C;" text="Total :" GridPane.rowIndex="3" />
                                <Label fx:id="totalNuitLabel" style="-fx-font-weight: bold; -fx-text-fill: #E8B156;" text="200 DT" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                        </rowConstraints>
                            </GridPane>
                            <Label fx:id="dureeErrorLabel" managed="false" style="-fx-text-fill: red; -fx-font-size: 10pt;" visible="false" />
                        </VBox>

                        <!-- Total à payer -->
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #23779C;" text="Total à payer :" />
                            <Label fx:id="totalLabel" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #E8B156;" text="200 DT" />
                        </HBox>

                        <!-- Info paiement -->

                        <!-- Boutons d'action -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <Button fx:id="confirmerBtn" style="-fx-background-color: #81AE8D; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" text="Confirmer la réservation" />
                            <Button fx:id="annulerBtn" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" text="Annuler" />
                        </HBox>

                        <!-- Éléments cachés pour conserver la compatibilité avec le controller (adultes/enfants) -->
                        <VBox managed="false" visible="false">
                            <Label text="Adultes" />
                            <Spinner fx:id="adultesSpinner" />
                            <Label text="Enfants" />
                            <Spinner fx:id="enfantsSpinner" />
                            <Label fx:id="capaciteErrorLabel" />
                        </VBox>
                    </VBox>

                    <!-- Colonne droite : détails du logement avec photo (carte blanche) -->
                    <VBox maxWidth="756.0" minWidth="300" prefHeight="479.0" prefWidth="710.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                        <!-- Image -->
                        <ImageView fx:id="imageLogement" fitHeight="200" fitWidth="350" preserveRatio="true" style="-fx-border-color: lightgray; -fx-border-radius: 10;" />
                        <!-- Détails texte -->
                        <Label fx:id="nomLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #23779C;" text="hotel Diar yassine" />
                        <Label fx:id="typeLabel" style="-fx-text-fill: #1A3C5A;" text="Type: Villa" />
                        <Label fx:id="adresseLabel" style="-fx-text-fill: #81AE8D;" text="📍 Tunis, Tunisie" />
                        <Label fx:id="capaciteLabel" style="-fx-text-fill: #1A3C5A;" text="👥 Capacité: 9 personnes" />
                        <Label fx:id="prixLabel" style="-fx-font-weight: bold; -fx-text-fill: #E8B156;" text="200 DT" />
                        <Label fx:id="equipementLabel" style="-fx-text-fill: #7f8c8d;" text="⚙️ connexion" />
                        <Label fx:id="disponibiliteLabel" style="-fx-text-fill: #81AE8D;" text="Disponible" />
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
