<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.GestionReservationsAdminController"
      style="-fx-background-color: #F5F1E9;">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <children>
        <!-- ====== HEADER AVEC RECHERCHE ET FILTRES ====== -->
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #23779C;"
                       text="GESTION DES RÉSERVATIONS"/>
                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher..."
                           prefWidth="200"
                           style="-fx-background-radius: 15; -fx-border-color: #DACEB6; -fx-border-radius: 15; -fx-padding: 8;"/>

                <ComboBox fx:id="filterStatusCombo"
                          promptText="Filtrer par statut"
                          prefWidth="150"
                          style="-fx-background-radius: 10;"/>

                <Button text="Rechercher"
                        onAction="#handleSearch"
                        style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 16;"/>

                <Button text="Réinitialiser"
                        onAction="#handleReset"
                        style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 16;"/>
            </children>
        </HBox>

        <!-- ====== STATISTIQUES RAPIDES ====== -->
        <HBox spacing="20.0">
            <children>
                <VBox prefWidth="180.0" spacing="6.0"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <children>
                        <Label style="-fx-text-fill: #777;" text="Total réservations"/>
                        <Label fx:id="totalReservationsLabel"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #23779C;"
                               text="0"/>
                    </children>
                </VBox>

                <VBox prefWidth="180.0" spacing="6.0"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <children>
                        <Label style="-fx-text-fill: #777;" text="En attente"/>
                        <Label fx:id="enAttenteLabel"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #E8B156;"
                               text="0"/>
                    </children>
                </VBox>

                <VBox prefWidth="180.0" spacing="6.0"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <children>
                        <Label style="-fx-text-fill: #777;" text="Confirmées"/>
                        <Label fx:id="confirmeesLabel"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #81AE8D;"
                               text="0"/>
                    </children>
                </VBox>

                <VBox prefWidth="180.0" spacing="6.0"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <children>
                        <Label style="-fx-text-fill: #777;" text="Annulées"/>
                        <Label fx:id="annuleesLabel"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"
                               text="0"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- ====== EN-TÊTE DU TABLEAU (GRID) ====== -->
        <VBox spacing="0.0" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15"/>
            </padding>
            <children>
                <GridPane style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="15.0" />
                        <ColumnConstraints percentWidth="15.0" />
                        <ColumnConstraints percentWidth="15.0" />
                        <ColumnConstraints percentWidth="15.0" />
                    </columnConstraints>
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="ID" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Voyage" GridPane.columnIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Client" GridPane.columnIndex="2" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Dates" GridPane.columnIndex="3" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Places" GridPane.columnIndex="4" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Actions" GridPane.columnIndex="5" />
                    </children>
                </GridPane>

                <!-- ====== LISTE DES RÉSERVATIONS ====== -->
                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background-insets: 0;"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="containerToutesReservations" spacing="10.0" style="-fx-padding: 10 0 0 0;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</VBox>