<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="800" prefWidth="1300" style="-fx-background-color: #F6F7FB;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.CatalogueUserController" stylesheets="@../style.css">

    <!-- Barre de navigation partagée -->
    <top>
        <fx:include fx:id="navbar" source="Navbar.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox spacing="35" fillWidth="true">
                <padding><Insets top="30" right="30" bottom="30" left="30" /></padding>

                <!-- Section Héro (identique à celle des logements) -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: linear-gradient(to right, #23779C, #3D94CA); -fx-background-radius: 25; -fx-padding: 50;">
                    <effect><DropShadow color="#00000022" radius="15" offsetY="5"/></effect>

                    <Label text="Trouvez votre voyage idéal"
                           textFill="WHITE"
                           style="-fx-font-size: 36; -fx-font-weight: bold;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Label text="Circuits, séjours et expériences sur mesure"
                           textFill="#DACEB6"
                           style="-fx-font-size: 17;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Region prefHeight="15" />

                    <!-- Barre de recherche responsive -->
                    <HBox alignment="CENTER" spacing="12" fillHeight="true">
                        <HBox.margin><Insets left="20" right="20" /></HBox.margin>

                        <HBox alignment="CENTER_LEFT"
                              spacing="10"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 10 20;">
                            <Label text="🔍" style="-fx-font-size: 16;"/>
                            <TextField fx:id="searchField"
                                       onKeyReleased="#handleRecherche"
                                       promptText="Où voulez-vous aller ?"
                                       style="-fx-background-color: transparent; -fx-font-size: 14;"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>

                        <ComboBox fx:id="comboTri"
                                  prefWidth="170"
                                  promptText="Trier par Prix"
                                  style="-fx-background-color: white; -fx-background-radius: 30;" />
                    </HBox>
                </VBox>

                <!-- CHIPS filtres (centrés) -->
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="btnTous" text="Tous" onAction="#filtrerTous"
                            style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>
                    <Button fx:id="btnTunisie" text="Tunisie" onAction="#filtrerTunisie"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>
                    <Button fx:id="btnEurope" text="Europe" onAction="#filtrerEurope"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>
                    <Button fx:id="btnPromos" text="Promos" onAction="#filtrerPromos"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;"/>
                </HBox>

                <!-- GRID cartes -->
                <GridPane fx:id="voyageGrid" hgap="18" vgap="18" alignment="TOP_CENTER">
                    <padding><Insets top="6" right="6" bottom="16" left="6"/></padding>
                </GridPane>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>