<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1300.0"
            xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.loginController"
            style="-fx-background-image: url('/images/bg_5.jpg'); -fx-background-size: cover; -fx-background-position: center;">

    <children>

        <!-- Overlay uniforme — même opacité partout, pas de dégradé -->
        <AnchorPane prefHeight="1300.0" prefWidth="1800.0"
                    style="-fx-background-color: rgba(38,40,56,0.6);" />

        <!-- Carte glassmorphism -->
        <AnchorPane layoutX="520.0" layoutY="90.0" prefHeight="620.0" prefWidth="420.0"
                    style="-fx-background-color: rgba(255,255,255,0.10);
                           -fx-background-radius: 28;
                           -fx-border-color: rgba(255,255,255,0.20);
                           -fx-border-radius: 28;
                           -fx-border-width: 1.2;">
            <effect>
                <DropShadow blurType="GAUSSIAN" radius="28.0" spread="0.0" offsetY="8.0">
                    <color><Color opacity="0.35" /></color>
                </DropShadow>
            </effect>
        </AnchorPane>

        <!-- Contenu de la carte -->
        <VBox layoutX="540.0" layoutY="108.0" prefWidth="368.0" spacing="18.0" alignment="TOP_CENTER">
            <children>

                <!-- ── En-tête compact : logo + titre sur une ligne ── -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <!-- Logo réduit -->
                        <StackPane prefHeight="54.0" prefWidth="54.0"
                                   style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ff6b35, #ff9a5c);
                                          -fx-background-radius: 27;
                                          -fx-border-color: rgba(255,255,255,0.35);
                                          -fx-border-radius: 27;
                                          -fx-border-width: 1.5;">
                            <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true">
                                <Image url="@/images/logo.png" />
                            </ImageView>
                        </StackPane>

                        <VBox spacing="2.0">
                            <Label text="Horizia" textFill="WHITE"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                            <Label text="Connectez-vous pour continuer l'aventure"
                                   textFill="rgba(255,255,255,0.75)"
                                   style="-fx-font-size: 11.5px;" />
                        </VBox>
                    </children>
                </HBox>

                <!-- Séparateur -->
                <Separator style="-fx-background-color: rgba(255,255,255,0.18);" />

                <!-- Formulaire -->
                <VBox spacing="14.0">
                    <children>
                        <!-- Email -->
                        <VBox spacing="6.0">
                            <Label text="Adresse email" textFill="WHITE"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: bold;" />
                            <TextField fx:id="txtEmail" promptText="exemple@email.com"
                                       style="-fx-background-color: rgba(255,255,255,0.10);
                                              -fx-background-radius: 14;
                                              -fx-padding: 12 16;
                                              -fx-border-color: rgba(255,255,255,0.28);
                                              -fx-border-radius: 14;
                                              -fx-border-width: 1;
                                              -fx-text-fill: white;
                                              -fx-font-size: 13.5px;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.45);" />
                        </VBox>

                        <!-- Mot de passe -->
                        <VBox spacing="6.0">
                            <Label text="Mot de passe" textFill="WHITE"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: bold;" />
                            <PasswordField fx:id="txtPassword" promptText="Entrez votre mot de passe"
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 14;
                                                  -fx-padding: 12 16;
                                                  -fx-border-color: rgba(255,255,255,0.28);
                                                  -fx-border-radius: 14;
                                                  -fx-border-width: 1;
                                                  -fx-text-fill: white;
                                                  -fx-font-size: 13.5px;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.45);" />
                        </VBox>
                    </children>
                </VBox>

                <!-- Se souvenir / Mot de passe oublié -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <CheckBox text="Se souvenir de moi"
                                      style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12px;" />
                        </HBox>
                        <Hyperlink fx:id="forgotPasswordLink" text="Mot de passe oublié ?"
                                   onAction="#handleForgotPassword"
                                   textFill="#ff9a5c" underline="false"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <!-- Bouton principal -->
                <Button fx:id="btnLogin" mnemonicParsing="false"
                        onAction="#handleLogin" prefHeight="48.0" maxWidth="Infinity"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #ff6b35, #ff9a5c);
                               -fx-background-radius: 24;
                               -fx-effect: dropshadow(gaussian, rgba(255,107,53,0.45), 14, 0, 0, 4);"
                        text="SE CONNECTER" textFill="white">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>

                <!-- ── Séparateur "ou continuer avec" ── -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Separator prefWidth="100.0" style="-fx-background-color: rgba(255,255,255,0.20);" />
                        <Label text="ou continuer avec" textFill="rgba(255,255,255,0.55)"
                               style="-fx-font-size: 11.5px;" />
                        <Separator prefWidth="100.0" style="-fx-background-color: rgba(255,255,255,0.20);" />
                    </children>
                </HBox>

                <!-- ── Boutons alternatifs : Face ID + Google côte à côte ── -->
                <HBox spacing="12.0">
                    <children>
                        <!-- Reconnaissance faciale -->
                        <Button fx:id="btnFaceLogin" mnemonicParsing="false"
                                onAction="#handleFaceLogin"
                                prefHeight="44.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: rgba(255,255,255,0.10);
                                       -fx-background-radius: 22;
                                       -fx-border-color: rgba(255,255,255,0.28);
                                       -fx-border-radius: 22;
                                       -fx-border-width: 1;"
                                text="📷 Face ID" textFill="white">
                            <font><Font size="13.0" /></font>
                        </Button>

                        <!-- Google -->
                        <Button fx:id="btnGoogleLogin" mnemonicParsing="false"
                                onAction="#handleGoogleLogin"
                                prefHeight="44.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: rgba(255,255,255,0.10);
                                       -fx-background-radius: 22;
                                       -fx-border-color: rgba(255,255,255,0.28);
                                       -fx-border-radius: 22;
                                       -fx-border-width: 1;"
                                text="G  Google" textFill="white">
                            <font><Font size="13.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <!-- Lien inscription -->
                <HBox alignment="CENTER" spacing="6.0" style="-fx-padding: 4 0 0 0;">
                    <children>
                        <Label text="Nouveau voyageur ?" textFill="rgba(255,255,255,0.75)"
                               style="-fx-font-size: 12.5px;" />
                        <Hyperlink onAction="#goToSignUp" text="Créer un compte"
                                   textFill="#ff9a5c" underline="false"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <!-- Message d'erreur -->
                <Label fx:id="lblMessage" alignment="CENTER" maxWidth="Infinity"
                       textFill="#ff9a5c" wrapText="true"
                       style="-fx-font-size: 12px;" visible="false" />

            </children>
        </VBox>

    </children>
</AnchorPane>
