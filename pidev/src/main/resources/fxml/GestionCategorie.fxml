<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #F5F1E9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.GestionCategorieController">

    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #000328;" alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="40.0" />
            </padding>
            <children>
                <ImageView fx:id="logoApp" fitHeight="60.0" fitWidth="180.0" focusTraversable="true" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
                    <VBox.margin>
                        <Insets bottom="40.0" left="10.0" />
                    </VBox.margin>
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
               <cursor>
                  <Cursor fx:constant="SE_RESIZE" />
               </cursor>
                </ImageView>
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Catégories" />

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity"
                        onAction="#naviguerVoyages"
                        prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #DACEB6;"
                        text="Voyages" />

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #DACEB6; -fx-font-size: 14;"
                        text="Réservations"
                        onAction="#naviguerReservations"/>


                <Region VBox.vgrow="ALWAYS" />

                <Button prefHeight="45.0" prefWidth="210.0"
                        style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-background-radius: 10;"
                        text="Déconnexion"
                        onAction="#handleDeconnexion"/>
            </children>
        </VBox>
    </left>

    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #23779C;" text="GESTION DES CATÉGORIES" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="tfRecherche" prefWidth="200.0" promptText="Rechercher..." style="-fx-background-radius: 15; -fx-border-color: #DACEB6; -fx-border-radius: 15; -fx-background-insets: 0;" />
                                <Button onAction="#handleViderFormulaire" style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-background-radius: 8;" text="+ Nouvelle Catégorie" />
                            </children>
                        </HBox>

                        <ListView fx:id="listCategories" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 5;" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <VBox prefWidth="350.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #DACEB6; -fx-border-radius: 15; -fx-border-width: 1.5;">
                    <padding>
                        <Insets bottom="25" left="25" right="25" top="25" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #23779C; -fx-font-size: 15;" text="ÉDITER LA CATÉGORIE" />

                        <VBox spacing="8.0">
                            <Label style="-fx-font-size: 12; -fx-text-fill: #555;" text="Nom de la catégorie" />
                            <TextField fx:id="tfNom" prefHeight="40.0" style="-fx-background-radius: 8; -fx-border-color: #eee; -fx-border-radius: 8;" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label style="-fx-font-size: 12; -fx-text-fill: #555;" text="Description" />
                            <TextArea fx:id="taDescription" prefHeight="200.0" style="-fx-background-radius: 8; -fx-border-color: #eee; -fx-border-radius: 8;" wrapText="true" />
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Button onAction="#handleViderFormulaire" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #DACEB6; -fx-border-color: #DACEB6; -fx-border-radius: 8; -fx-text-fill: #555;" text="Annuler" />
                            <Button onAction="#handleEnregistrer" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Enregistrer" />
                        </HBox>
                        <Button maxWidth="Infinity" onAction="#handleSupprimer" prefHeight="35.0" style="-fx-background-color: #c5302e; -fx-text-fill: white; -fx-background-radius: 8;" text="Supprimer" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
