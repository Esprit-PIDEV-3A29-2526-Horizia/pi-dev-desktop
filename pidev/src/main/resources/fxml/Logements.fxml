<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" style="-fx-background-color: #F6F7FB; -fx-padding: 20;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.LogementsController">
    <children>
        <!-- Barre de tri, recherche et ajout -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Trier par :" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                <ComboBox fx:id="sortComboBox" promptText="Choisir..." style="-fx-pref-width: 150px; -fx-background-radius: 5;" />
                <TextField fx:id="searchField" promptText="Rechercher un logement..." HBox.hgrow="ALWAYS" style="-fx-padding: 8; -fx-background-radius: 5;" />
                <Button fx:id="addButton" mnemonicParsing="false" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 5;" text="+ Ajouter" />
            </children>
        </HBox>

        <!-- Zone des cartes (ScrollPane avec FlowPane) -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="logementsFlowPane" hgap="20" vgap="20" style="-fx-background-color: #F6F7FB; -fx-padding: 5;">
                    <!-- Les cartes des logements seront ajoutées dynamiquement ici (via le contrôleur) -->
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>