<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.controllers.StatisticsController">

    <stylesheets>
        <String fx:value="/css/global.css" />
        <String fx:value="/css/statistics.css" />
    </stylesheets>

    <children>
        <!-- ScrollPane principal - prend tout l'espace et rend tout scrollable -->
        <ScrollPane fx:id="mainScrollPane"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.topAnchor="0"
                    style="-fx-background: #F9FAFB; -fx-background-color: #F9FAFB; -fx-border-color: transparent;">

            <content>
                <!-- Conteneur principal avec padding responsive -->
                <VBox spacing="20" style="-fx-background-color: #F9FAFB; -fx-padding: 20;">

                    <!-- Header avec titre et bouton refresh -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="📊 Tableau de Bord Statistique"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnRefresh" onAction="#refreshStats"
                                style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;"
                                text="🔄 Actualiser" />
                    </HBox>

                    <!-- KPIs Cards - Layout responsive -->
                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        </columnConstraints>

                        <!-- Total Membres -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="👥 Total Membres" style="-fx-font-size: 16px; -fx-text-fill: #6B7280;" />
                            <Label fx:id="totalMembersLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;" />
                            <Label fx:id="membersEvolutionLabel" text="+0% vs mois dernier" style="-fx-font-size: 14px; -fx-text-fill: #10B981;" />
                        </VBox>

                        <!-- Membres Actifs -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="✅ Membres Actifs" style="-fx-font-size: 16px; -fx-text-fill: #6B7280;" />
                            <Label fx:id="activeMembersLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #10B981;" />
                            <Label fx:id="activePercentageLabel" text="0% du total" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" />
                        </VBox>

                        <!-- Membres Bloqués -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                              GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="🔒 Membres Bloqués" style="-fx-font-size: 16px; -fx-text-fill: #6B7280;" />
                            <Label fx:id="blockedMembersLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #EF4444;" />
                            <Label fx:id="blockedPercentageLabel" text="0% du total" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" />
                        </VBox>

                        <!-- Total Profils -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                              GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label text="📋 Total Profils" style="-fx-font-size: 16px; -fx-text-fill: #6B7280;" />
                            <Label fx:id="totalProfilsLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" />
                            <Label text="Types de profils" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;" />
                        </VBox>
                    </GridPane>

                    <!-- Graphiques en ligne - Responsive avec ScrollPane horizontal -->
                    <ScrollPane fx:id="chartsScrollPane"
                                fitToWidth="true"
                                fitToHeight="true"
                                hbarPolicy="AS_NEEDED"
                                vbarPolicy="NEVER"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                        <content>
                            <HBox spacing="20" minWidth="-Infinity">
                                <!-- Répartition par Type -->
                                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                                      minWidth="350" prefWidth="450" HBox.hgrow="ALWAYS">
                                    <Label text="Répartition par Type" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                    <PieChart fx:id="typePieChart" prefHeight="300" legendVisible="true" />
                                </VBox>

                                <!-- Répartition par Statut -->
                                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                                      minWidth="350" prefWidth="450" HBox.hgrow="ALWAYS">
                                    <Label text="Répartition par Statut" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                    <PieChart fx:id="statutPieChart" prefHeight="300" legendVisible="true" />
                                </VBox>
                            </HBox>
                        </content>
                    </ScrollPane>

                    <!-- Graphique en barres - Scrollable horizontalement -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                        <Label text="Distribution Type/Statut" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <ScrollPane fx:id="barChartScrollPane"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <content>
                                <BarChart fx:id="distributionBarChart" prefHeight="400" minWidth="600">
                                    <xAxis>
                                        <CategoryAxis label="Type" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Nombre" />
                                    </yAxis>
                                </BarChart>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- Tableau récapitulatif - Scrollable horizontalement -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                        <Label text="Récapitulatif Détaillé" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <ScrollPane fx:id="tableScrollPane"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="AS_NEEDED"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <content>
                                <TableView fx:id="summaryTable" prefHeight="250" minWidth="600">
                                    <columns>
                                        <TableColumn fx:id="colType" text="Type" prefWidth="150" />
                                        <TableColumn fx:id="colActif" text="Actif" prefWidth="100" />
                                        <TableColumn fx:id="colBloque" text="Bloqué" prefWidth="100" />
                                        <TableColumn fx:id="colInactif" text="Inactif" prefWidth="100" />
                                        <TableColumn fx:id="colTotal" text="Total" prefWidth="100" />
                                    </columns>
                                </TableView>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- Message -->
                    <Label fx:id="lblMessage" style="-fx-text-fill: #10B981; -fx-font-weight: bold;" alignment="CENTER" />

                    <!-- Espace supplémentaire en bas -->
                    <Region prefHeight="20" />
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>