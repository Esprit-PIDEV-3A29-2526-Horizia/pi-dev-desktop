<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane fx:id="rootPane"
            prefHeight="800" prefWidth="1250"
            style="-fx-background-color:#F6F7FB;"
            xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AccueilController"
            stylesheets="@../style.css">

    <top>
        <fx:include fx:id="navbar" source="Navbar.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox spacing="35" fillWidth="true">
                <padding><Insets top="30" right="30" bottom="30" left="30" /></padding>

                <!-- Section Héro -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: linear-gradient(to right, #23779C, #3D94CA); -fx-background-radius: 25; -fx-padding: 50;">
                    <effect><DropShadow color="#00000022" radius="15" offsetY="5"/></effect>

                    <Label text="Trouvez votre refuge idéal"
                           textFill="WHITE"
                           style="-fx-font-size: 36; -fx-font-weight: bold;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Label text="Villas de luxe, appartements cosy et hôtels de charme"
                           textFill="#DACEB6"
                           style="-fx-font-size: 17;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Region prefHeight="15" />

                    <!-- Barre de recherche responsive -->
                    <HBox alignment="CENTER" spacing="12" fillHeight="true">
                        <HBox.margin><Insets left="20" right="20" /></HBox.margin>

                        <HBox alignment="CENTER_LEFT"
                              spacing="10"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 10 20;">
                            <Label text="🔍" style="-fx-font-size: 16;"/>
                            <TextField fx:id="searchField"
                                       promptText="Où voulez-vous aller ?"
                                       style="-fx-background-color: transparent; -fx-font-size: 14;"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>

                        <ComboBox fx:id="sortCombo"
                                  prefWidth="170"
                                  promptText="Trier par Prix"
                                  style="-fx-background-color: white; -fx-background-radius: 30;" />

                        <Button fx:id="btnRecommendations"
                                text="✨ Recommandations"
                                styleClass="filter-button" />
                    </HBox>
                </VBox>

                <!-- Filtres par catégorie -->
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="allFilterBtn"   styleClass="filter-button-active" text="Tous" />
                    <Button fx:id="villaFilterBtn"  styleClass="filter-button"        text="Villas" />
                    <Button fx:id="hotelFilterBtn"  styleClass="filter-button"        text="Hôtels" />
                    <Button fx:id="appartFilterBtn" styleClass="filter-button"        text="Appartements" />
                </HBox>

                <!-- Grille des logements — s'adapte à la largeur -->
                <FlowPane fx:id="flowLogements"
                          hgap="25"
                          vgap="25"
                          alignment="CENTER"
                          prefWrapLength="1200" />

                <!-- Bouton centré -->


            </VBox>
        </ScrollPane>
    </center>
</BorderPane>