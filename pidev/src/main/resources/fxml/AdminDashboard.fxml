<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1280.0"
        prefHeight="800.0"
        style="-fx-background-color: #0f172a;"
        xmlns="http://javafx.com/javafx/20.0.2"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="tn.esprit.controllers.AdminDashboardController"
        stylesheets="@/css/style.css">


    <!-- LEFT : SIDEBAR -->
    <left>
        <VBox
                prefWidth="280"
                minWidth="280"
                maxWidth="280"
                style="-fx-background-color: #0f172a;">

            <!-- Logo / Brand -->
            <HBox
                    prefHeight="60"
                    alignment="CENTER_LEFT"
                    spacing="10"
                    style="-fx-padding: 0 18; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0;">
                <ImageView fitHeight="36" fitWidth="36" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@/images/logo.png" backgroundLoading="true" />
                    </image>
                </ImageView>
                <Label
                        text="Horozia"
                        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
            </HBox>

            <!-- Menu scrollable -->
            <ScrollPane
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="2" style="-fx-padding: 10 0;">

                        <!-- Dashboard -->
                        <Button
                                fx:id="btnDashboard"
                                onAction="#showDashboard"
                                maxWidth="Infinity"
                                style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 11 18; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13.5px; -fx-font-weight: bold;">
                            <graphic>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="⊞" style="-fx-font-size: 17px; -fx-text-fill: white;" />
                                    <Label text="Dashboard" style="-fx-font-size: 13.5px; -fx-text-fill: white; -fx-font-weight: bold;" />
                                </HBox>
                            </graphic>
                        </Button>

                        <Separator style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 5 0;">
                            <VBox.margin><Insets left="18" right="18" /></VBox.margin>
                        </Separator>

                        <!-- GESTION UTILISATEURS -->
                        <Accordion style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <panes>
                                <TitledPane text="👥 Gestion Utilisateurs"
                                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5; -fx-border-color: transparent;">
                                    <content>
                                        <VBox spacing="4" style="-fx-padding: 5 0 5 20;">
                                            <Button fx:id="btnUsers" text="Membres" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showUsers"/>
                                            <Button fx:id="btnProfils" text="Profils" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showProfils"/>
                                            <Button fx:id="btnStats" text="Statistiques" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showStats"/>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </panes>
                        </Accordion>

                        <!-- GESTION VOYAGES -->
                        <Accordion style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <panes>
                                <TitledPane text="✈️Gestion Voyages"
                                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;">
                                    <content>
                                        <VBox spacing="4" style="-fx-padding: 5 0 5 20;">
                                            <Button fx:id="btnVoyages" text="Voyages" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showVoyages"/>
                                            <Button fx:id="btncatalogue" text="Categorie" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showcatalogue"/>

                                            <Button fx:id="btnReservations" text="Réservations" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showReservations"/>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </panes>
                        </Accordion>

                        <!-- Gestion Logements -->
                        <Button
                                fx:id="btnLogements"
                                onAction="#showLogements"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.72); -fx-alignment: center-left; -fx-padding: 11 18; -fx-cursor: hand; -fx-background-radius: 0; -fx-font-size: 13.5px;">
                            <graphic>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="🏠" style="-fx-font-size: 17px;" />
                                    <Label text="Gestion Logements" style="-fx-font-size: 13.5px; -fx-text-fill: rgba(255,255,255,0.72);" />
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Gestion Événements -->
                        <Button
                                fx:id="btnEvenements"
                                onAction="#showEvenements"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.72); -fx-alignment: center-left; -fx-padding: 11 18; -fx-cursor: hand; -fx-background-radius: 0; -fx-font-size: 13.5px;">
                            <graphic>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="🎉" style="-fx-font-size: 17px;" />
                                    <Label text="Gestion Événements" style="-fx-font-size: 13.5px; -fx-text-fill: rgba(255,255,255,0.72);" />
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Gestion Locations -->
                        <Button
                                fx:id="btnLocationDashboard"
                                onAction="#showLocationDashboard"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.72); -fx-alignment: center-left; -fx-padding: 11 18; -fx-cursor: hand; -fx-background-radius: 0; -fx-font-size: 13.5px;">
                            <graphic>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="🚗" style="-fx-font-size: 17px;" />
                                    <Label text="Gestion Locations" style="-fx-font-size: 13.5px; -fx-text-fill: rgba(255,255,255,0.72);" />
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- GESTION PUBLICATIONS -->
                        <Accordion style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <panes>
                                <TitledPane text="📝 Gestion Publications"
                                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;">
                                    <content>
                                        <VBox spacing="4" style="-fx-padding: 5 0 5 20;">
                                            <Button fx:id="btnPublications" text="Publications" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showPublications"/>
                                            <Button fx:id="btnCommentaires" text="Commentaires" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-alignment: center-left; -fx-padding: 10 15; -fx-cursor: hand;" maxWidth="Infinity" onAction="#showCommentaires"/>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </panes>
                        </Accordion>

                        <Separator style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 5 0;">
                            <VBox.margin><Insets left="18" right="18" /></VBox.margin>
                        </Separator>

                        <!-- Déconnexion -->
                        <Button
                                onAction="#handleLogout"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(239,68,68,0.85); -fx-alignment: center-left; -fx-padding: 11 18; -fx-cursor: hand; -fx-background-radius: 0; -fx-font-size: 13.5px;">
                            <graphic>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="🚪" style="-fx-font-size: 17px;" />
                                    <Label text="Déconnexion" style="-fx-font-size: 13.5px; -fx-text-fill: rgba(239,68,68,0.85);" />
                                </HBox>
                            </graphic>
                        </Button>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- Carte Admin bas de sidebar -->
            <VBox
                    style="-fx-background-color: #0b1220; -fx-padding: 14 16 10 16; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 1 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox
                            alignment="CENTER"
                            style="-fx-background-color: #3d94ca; -fx-background-radius: 17; -fx-min-width: 34; -fx-min-height: 34; -fx-max-width: 34; -fx-max-height: 34;">
                        <Label
                                text="A"
                                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label
                                fx:id="lblAdminName"
                                text="Administrateur"
                                style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label
                                fx:id="lblAdminEmail"
                                text="admin@horozia.com"
                                style="-fx-text-fill: #9ca3af; -fx-font-size: 10px;" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Copyright -->
            <Label
                    text="© 2026 Horozia"
                    style="-fx-text-fill: #4b5563; -fx-font-size: 10px; -fx-padding: 7 18;" />

        </VBox>
    </left>

    <!-- CENTER : NAVBAR + CONTENU -->
    <center>
        <VBox style="-fx-background-color: #f1f5f9;">

            <!-- NAVBAR -->
            <HBox
                    prefHeight="60"
                    alignment="CENTER_LEFT"
                    spacing="10"
                    style="-fx-background-color: white; -fx-padding: 0 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">

                <Region HBox.hgrow="ALWAYS" />

                <!-- Actions navbar -->
                <HBox spacing="8" alignment="CENTER">

                    <!-- Bouton Notification -->
                    <StackPane>
                        <Button
                                fx:id="btnNotification"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 6 8; -fx-background-radius: 8;">
                            <graphic>
                                <Label text="🔔" style="-fx-font-size: 18px;" />
                            </graphic>
                        </Button>
                    </StackPane>

                    <!-- Bouton Chat -->
                    <Button
                            fx:id="btnChat"
                            onAction="#openChat"
                            style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 6 8; -fx-background-radius: 8;">
                        <graphic>
                            <Label text="💬" style="-fx-font-size: 18px;" />
                        </graphic>
                    </Button>

                    <!-- Dropdown utilisateur -->
                    <MenuButton
                            style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;">
                        <graphic>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <VBox
                                        alignment="CENTER"
                                        style="-fx-background-color: #3d94ca; -fx-background-radius: 16; -fx-min-width: 30; -fx-min-height: 30;">
                                    <Label text="A" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                </VBox>
                                <Label text="Administrateur" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                            </HBox>
                        </graphic>
                        <items>
                            <MenuItem text="👤 Mon Profil" onAction="#showProfile" />
                            <MenuItem text="📊 Dashboard" onAction="#showDashboard" />
                            <SeparatorMenuItem />
                            <MenuItem text="⚙️ Paramètres" onAction="#showSettings" />
                            <SeparatorMenuItem />
                            <MenuItem text="🚪 Déconnexion" onAction="#handleLogout" />
                        </items>
                    </MenuButton>

                </HBox>
            </HBox>

            <!-- ZONE CONTENU DYNAMIQUE -->
            <AnchorPane
                    fx:id="contentArea"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: #f1f5f9;" />

        </VBox>
    </center>

</BorderPane>