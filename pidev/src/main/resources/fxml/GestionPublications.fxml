<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AdminPublicationsController">

    <VBox spacing="30" style="-fx-padding: 30; -fx-background-color: #f8fafc;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox>
                <Label text="📰 Gestion des Publications"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label text="Gérez, filtrez et modifiez toutes les publications"
                       style="-fx-font-size: 14; -fx-text-fill: #64748b;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAjouter" text="➕ Nouvelle publication"
                    style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 25; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14;"/>
        </HBox>

        <!-- Barre de recherche -->
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="searchField" promptText="Rechercher une publication..."
                       style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 12 20; -fx-font-size: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 30;"
                       HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="sortCombo" promptText="Trier par"
                      style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 5 15; -fx-font-size: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 30;"
                      prefWidth="150"/>
            <Button fx:id="searchBtn" text="🔍"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 12 20; -fx-cursor: hand;"/>
        </HBox>

        <!-- Filtres catégories -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Catégories:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14;"/>
            <Button fx:id="btnTous" text="Tous"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button fx:id="btnPlage" text="🏖️ Plage"
                    style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
            <Button fx:id="btnMontagne" text="⛰️ Montagne"
                    style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
            <Button fx:id="btnVille" text="🏙️ Ville"
                    style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
            <Button fx:id="btnDesert" text="🏜️ Désert"
                    style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
            <Button fx:id="btnCampagne" text="🌾 Campagne"
                    style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
        </HBox>

        <!-- Grille des publications -->
        <FlowPane fx:id="publicationsGrid" hgap="20" vgap="20" style="-fx-padding: 10 0;"/>

    </VBox>
</ScrollPane>