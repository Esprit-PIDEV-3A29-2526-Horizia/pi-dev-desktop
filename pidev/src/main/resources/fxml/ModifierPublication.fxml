<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="800" prefWidth="1300" style="-fx-background-color: #F6F7FB;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ModifierPublicationsController">

    <!-- NAVBAR PARTAGÉE -->
    <top>
        <fx:include fx:id="navbar" source="/fxml/Navbar.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox spacing="35" fillWidth="true" alignment="TOP_CENTER">
                <padding><Insets top="30" right="30" bottom="30" left="30" /></padding>

                <!-- Section Héro -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: linear-gradient(to right, #23779C, #3D94CA); -fx-background-radius: 25; -fx-padding: 50;">
                    <effect><DropShadow color="#00000022" radius="15" offsetY="5"/></effect>

                    <Label text="✏️ Modifier la publication"
                           textFill="WHITE"
                           style="-fx-font-size: 36; -fx-font-weight: bold;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Label text="Modifiez les informations de votre publication"
                           textFill="#DACEB6"
                           style="-fx-font-size: 17;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />
                </VBox>

                <!-- Formulaire de modification -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);" prefWidth="600" maxWidth="600">

                    <Label text="Informations de la publication" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3C5A;"/>

                    <!-- Titre -->
                    <VBox spacing="8">
                        <Label text="Titre *" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>
                        <TextField fx:id="titreField" promptText="Titre de la publication" style="-fx-background-radius: 10; -fx-padding: 12;"/>
                    </VBox>

                    <!-- Catégorie -->
                    <VBox spacing="8">
                        <Label text="Catégorie *" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>
                        <ComboBox fx:id="categorieCombo" promptText="Sélectionnez une catégorie" style="-fx-background-radius: 10; -fx-padding: 8;"/>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="8">
                        <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>
                        <TextArea fx:id="descriptionField" promptText="Description détaillée..." wrapText="true" prefRowCount="5" style="-fx-background-radius: 10; -fx-padding: 12;"/>
                    </VBox>

                    <!-- Image actuelle -->
                    <VBox spacing="8">
                        <Label text="Image actuelle" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>
                        <ImageView fx:id="currentImageView" fitHeight="150" fitWidth="250" preserveRatio="true" style="-fx-border-color: #e2e8f0; -fx-border-radius: 10;"/>
                    </VBox>

                    <!-- Nouvelle image -->
                    <VBox spacing="8">
                        <Label text="Nouvelle image (optionnel)" style="-fx-font-weight: bold; -fx-text-fill: #23779C;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="imageField" promptText="Aucun fichier sélectionné" editable="false" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;"/>
                            <Button fx:id="browseButton" text="Parcourir" style="-fx-background-color: #DACEB6; -fx-text-fill: #1A3C5A; -fx-background-radius: 20; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        </HBox>
                        <ImageView fx:id="previewImage" fitHeight="150" fitWidth="250" preserveRatio="true" visible="false" style="-fx-border-color: #e2e8f0; -fx-border-radius: 10;"/>
                    </VBox>

                    <!-- Boutons -->
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="annulerButton" text="Annuler" style="-fx-background-color: #DACEB6; -fx-text-fill: #1A3C5A; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button fx:id="enregistrerButton" text="Enregistrer" style="-fx-background-color: #81AE8D; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 30; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>