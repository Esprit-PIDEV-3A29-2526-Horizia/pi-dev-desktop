<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="800" prefWidth="1300" style="-fx-background-color: #F6F7FB;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AjouterPublicationController">

    <!-- NAVBAR PARTAGÉE (visible seulement si connecté) -->
    <top>
        <VBox fx:id="navbarContainer">
            <fx:include fx:id="navbar" source="/fxml/Navbar.fxml" />
        </VBox>
    </top>


    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox spacing="30" style="-fx-background-color: #f5f7fa; -fx-padding: 40;" alignment="TOP_CENTER" maxWidth="900">

                <!-- Header avec retour -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button fx:id="retourBtn" text="←"
                            style="-fx-background-color: transparent; -fx-font-size: 28; -fx-text-fill: #2c3e50; -fx-cursor: hand;" />
                    <Label text="➕ Nouvelle Publication"
                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1A3C5A;" />
                </HBox>

                <!-- Formulaire -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30;
                                         -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);">

                    <!-- Titre -->
                    <VBox spacing="8">
                        <Label text="Titre *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" />
                        <TextField fx:id="titreField" promptText="Ex: Belle plage à Hammamet, Randonnée en montagne..."
                                   style="-fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #e0e0e0;
                                          -fx-border-radius: 10; -fx-font-size: 14;" />
                        <Label fx:id="titreError" text="Le titre doit contenir au moins 3 caractères"
                               visible="false" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;" />
                    </VBox>

                    <!-- Catégorie -->
                    <VBox spacing="8">
                        <Label text="Catégorie *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" />
                        <ComboBox fx:id="categorieCombo" promptText="Sélectionnez une catégorie"
                                  style="-fx-padding: 5; -fx-background-radius: 10; -fx-border-color: #e0e0e0;
                                         -fx-border-radius: 10;" maxWidth="Infinity" />
                    </VBox>

                    <!-- Localisation -->
                    <VBox spacing="8">
                        <Label text="Localisation" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" />
                        <HBox spacing="10">
                            <TextField fx:id="villeField" promptText="Ville" HBox.hgrow="ALWAYS"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e0e0e0;
                                              -fx-border-radius: 10;" />
                            <TextField fx:id="paysField" promptText="Pays" HBox.hgrow="ALWAYS"
                                       style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e0e0e0;
                                              -fx-border-radius: 10;" />
                        </HBox>
                    </VBox>

                    <!-- Description + Boutons IA -->
                    <VBox spacing="8">
                        <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" />
                        <TextArea fx:id="descriptionArea" promptText="Décrivez votre expérience, vos recommandations..."
                                  wrapText="true" prefRowCount="6"
                                  style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;
                                         -fx-padding: 10; -fx-font-size: 14;" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="descCount" text="0 / 1000" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnGenererIA" text="🤖 Générer description IA"
                                    style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" />
                            <Button fx:id="btnTraduire" text="🌐 Traduire en anglais"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <!-- Tags -->
                    <VBox spacing="8">
                        <Label text="Tags (séparés par des virgules)"
                               style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" />
                        <TextField fx:id="tagsField" promptText="plage, soleil, famille, budget, été, voyage..."
                                   style="-fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e0e0e0;
                                          -fx-border-radius: 10;" />
                    </VBox>

                    <!-- Image -->
                    <VBox spacing="8">
                        <Label text="Photo" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" />

                        <StackPane fx:id="imagePreviewContainer"
                                   style="-fx-background-color: #ecf0f1; -fx-background-radius: 10; -fx-min-height: 250;
                                         -fx-border-color: #ddd; -fx-border-radius: 10; -fx-border-style: dashed;">

                            <VBox fx:id="imagePlaceholder" alignment="CENTER" spacing="10">
                                <Label text="🖼️" style="-fx-font-size: 64;" />
                                <Label text="Glissez une photo ou cliquez pour parcourir"
                                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;" />
                                <Button fx:id="parcourirBtn" text="📁 Parcourir"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 12 30;
                                               -fx-background-radius: 25; -fx-cursor: hand; -fx-font-size: 14;" />
                            </VBox>

                            <ImageView fx:id="imagePreview" fitWidth="700" fitHeight="250"
                                       preserveRatio="true" visible="false" />
                        </StackPane>

                        <Label fx:id="imagePathLabel" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;" />
                    </VBox>

                    <!-- Options avancées -->
                    <TitledPane text="Options avancées" expanded="false"
                                style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;">
                        <VBox spacing="15" style="-fx-padding: 15 0;">

                            <CheckBox fx:id="publierMaintenantCheck" text="Publier immédiatement" selected="true"
                                      style="-fx-font-size: 14;" />

                            <CheckBox fx:id="autoriserCommentairesCheck" text="Autoriser les commentaires" selected="true"
                                      style="-fx-font-size: 14;" />

                            <CheckBox fx:id="visiblePubliqueCheck" text="Visible publiquement" selected="true"
                                      style="-fx-font-size: 14;" />

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Date de publication:" style="-fx-font-size: 14;" />
                                <TextField fx:id="dateField" promptText="AAAA-MM-JJ"
                                           style="-fx-padding: 8; -fx-background-radius: 5;" />
                            </HBox>
                        </VBox>
                    </TitledPane>

                    <!-- Boutons -->
                    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="annulerBtn" text="Annuler"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 12 30;
                                       -fx-background-radius: 25; -fx-font-size: 14; -fx-cursor: hand;" />
                        <Button fx:id="enregistrerBtn" text="✓ Publier"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 12 40;
                                       -fx-background-radius: 25; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>