<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="400.0" prefWidth="600.0"
      style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Bienvenue sur Horizia" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #23779C;" />
        <Label text="Veuillez choisir votre mode d'accès :" style="-fx-font-size: 14;" />

        <HBox alignment="CENTER" spacing="30.0">
            <Button fx:id="btnAdmin" onAction="#handleAdminAccess" prefHeight="100.0" prefWidth="150.0"
                    text="ADMIN" style="-fx-background-color: #3D94CA; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 15;" />
            <Button fx:id="btnUser" onAction="#handleUserAccess" prefHeight="100.0" prefWidth="150.0"
                    text="UTILISATEUR" style="-fx-background-color: #2ecc71; ..." />
        </HBox>
    </children>
</VBox>