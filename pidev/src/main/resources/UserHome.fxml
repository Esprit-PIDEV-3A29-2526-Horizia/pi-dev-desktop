<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="800" prefWidth="1300" style="-fx-background-color: #F3F6FA;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.UserController">

    <!-- NAVBAR PARTAGÉE -->
    <top>
        <fx:include fx:id="navbar" source="/fxml/Navbar.fxml" />
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox spacing="35" fillWidth="true">
                <padding><Insets top="30" right="30" bottom="30" left="30" /></padding>

                <!-- Section Héro (identique à celle des logements) -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: linear-gradient(to right, #23779C, #3D94CA); -fx-background-radius: 25; -fx-padding: 50;">
                    <effect><DropShadow color="#00000022" radius="15" offsetY="5"/></effect>

                    <Label text="Découvrez nos événements"
                           textFill="WHITE"
                           style="-fx-font-size: 36; -fx-font-weight: bold;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Label text="Concerts, spectacles, conférences et plus encore"
                           textFill="#DACEB6"
                           style="-fx-font-size: 17;"
                           wrapText="true"
                           alignment="CENTER"
                           maxWidth="Infinity" />

                    <Region prefHeight="15" />

                    <!-- Barre de recherche responsive -->
                    <HBox alignment="CENTER" spacing="12" fillHeight="true">
                        <HBox.margin><Insets left="20" right="20" /></HBox.margin>

                        <HBox alignment="CENTER_LEFT"
                              spacing="10"
                              HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 10 20;">
                            <Label text="🔍" style="-fx-font-size: 16;"/>
                            <TextField fx:id="searchField"
                                       promptText="Rechercher un événement..."
                                       style="-fx-background-color: transparent; -fx-font-size: 14;"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>

                        <ComboBox fx:id="sortCombo"
                                  prefWidth="170"
                                  promptText="Trier par"
                                  style="-fx-background-color: white; -fx-background-radius: 30;" />
                    </HBox>
                </VBox>

                <!-- CHIPS filtres (centrés) -->
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="allFilterBtn" text="Tous"
                            style="-fx-background-color: #E8B156; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;" />
                    <Button fx:id="concertFilterBtn" text="Concerts"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;" />
                    <Button fx:id="spectacleFilterBtn" text="Spectacles"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;" />
                    <Button fx:id="conferenceFilterBtn" text="Conférences"
                            style="-fx-background-color: #DACEB6; -fx-text-fill: #1F2937; -fx-font-weight: bold;
                                   -fx-background-radius: 18; -fx-padding: 6 16; -fx-cursor: hand;" />
                </HBox>

                <!-- EVENTS GRID (FlowPane) -->
                <FlowPane fx:id="flowEvents" hgap="25" vgap="25" prefWrapLength="1200" alignment="TOP_CENTER" />

                <!-- Message si aucun événement -->
                <Label fx:id="emptyMessage" text="Aucun événement trouvé"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 16;"
                       visible="false" managed="false" />

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>