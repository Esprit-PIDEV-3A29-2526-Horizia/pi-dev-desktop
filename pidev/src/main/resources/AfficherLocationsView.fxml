<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AfficherLocationsController"
      spacing="20"
      style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #e8ecf1);"
      prefWidth="1100" prefHeight="700">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                          HEADER SECTION                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="📋" style="-fx-font-size: 56px;"/>
        <Label text="Historique des Locations"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="32"/>
            </font>
        </Label>
        <Label text="Consultez toutes les locations (passées, en cours et à venir)"
               style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
    </VBox>

    <Separator style="-fx-background-color: #bdc3c7;"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                     BARRE DE RECHERCHE                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <HBox spacing="15" alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-padding: 20;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3);">

        <Label text="🔍 Rechercher :"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>

        <TextField fx:id="txtRecherche"
                   promptText="Nom du client, téléphone, CIN..."
                   prefWidth="400"
                   style="-fx-font-size: 14px;
                          -fx-padding: 12;
                          -fx-background-color: #f8f9fa;
                          -fx-background-radius: 8;
                          -fx-border-color: #e0e0e0;
                          -fx-border-radius: 8;
                          -fx-border-width: 2;"/>

        <Button text="🔎 Rechercher"
                onAction="#rechercherLocations"
                style="-fx-background-color: #3498db;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-padding: 12 25;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>

        <Button text="🔄 Tout Afficher"
                onAction="#afficherTout"
                style="-fx-background-color: #95a5a6;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-padding: 12 25;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>

        <Label fx:id="lblNbResultats"
               text="0 location(s)"
               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"
               HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                    ZONE DE CARTES DES LOCATIONS                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">

        <FlowPane fx:id="flowPaneLocations"
                  hgap="20" vgap="20"
                  style="-fx-background-color: transparent; -fx-padding: 10;">

            <!-- Les cartes de locations seront ajoutées dynamiquement ici -->

        </FlowPane>
    </ScrollPane>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--                      BOUTONS D'ACTION                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <HBox spacing="15" alignment="CENTER">

        <Button text="🔙 Retour"
                onAction="#retour"
                prefWidth="180"
                style="-fx-background-color: #95a5a6;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-padding: 14 0;
                       -fx-background-radius: 10;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
            <font>
                <Font name="System Bold" size="15"/>
            </font>
        </Button>

        <Button text="🔄 Actualiser"
                onAction="#actualiser"
                prefWidth="180"
                style="-fx-background-color: #3498db;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-padding: 14 0;
                       -fx-background-radius: 10;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
            <font>
                <Font name="System Bold" size="15"/>
            </font>
        </Button>

        <Button text="📊 Exporter CSV"
                onAction="#exporterCSV"
                prefWidth="180"
                style="-fx-background-color: #16a085;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-padding: 14 0;
                       -fx-background-radius: 10;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
            <font>
                <Font name="System Bold" size="15"/>
            </font>
        </Button>
    </HBox>

    <!-- Footer Info -->
    <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Label text="💡 Cliquez sur une carte pour voir les détails complets"
               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
    </HBox>

</VBox>
