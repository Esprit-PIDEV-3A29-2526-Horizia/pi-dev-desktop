<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.input.MouseEvent?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="0" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AjoutLogementController">

    <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20" style="-fx-background-color: linear-gradient(to right, #2c3e50, #4ca1af); -fx-padding: 0 40;">
        <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
            <Image url="@image/log.png" />
        </ImageView>
        <VBox alignment="CENTER_LEFT">
            <Label text="Gestion du Catalogue" textFill="WHITE" style="-fx-opacity: 0.8;">
                <font><Font name="System Bold" size="14" /></font>
            </Label>
            <Label text="Ajouter un Nouveau Logement" textFill="WHITE">
                <font><Font name="System Bold" size="26" /></font>
            </Label>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
        <padding>
            <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
        </padding>

        <VBox spacing="25">
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
                <effect><DropShadow color="#00000015" radius="10" offsetY="4" /></effect>
                <Label text="🏠 Informations Générales" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                <Separator />

                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <VBox spacing="8" GridPane.columnIndex="0">
                        <Label text="Type de Logement" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <ComboBox fx:id="typeComboBox" maxWidth="Infinity" prefHeight="45" promptText="Choisir un type"
                                  style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Appartement" /><String fx:value="Maison" />
                                    <String fx:value="Villa" /><String fx:value="Hôtel" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="1">
                        <Label text="Nom de l'établissement" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <HBox spacing="10">
                            <TextField fx:id="nomField" HBox.hgrow="ALWAYS" prefHeight="45" promptText="Ex: Villa Yasmin"
                                       style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 8;" />
                            <Button fx:id="nomMicroBtn" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-width: 45; -fx-pref-height: 45;">
                                <graphic><ImageView fitHeight="20" fitWidth="20"><Image url="@image/micro.png"/></ImageView></graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Adresse Complète" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <HBox spacing="10">
                            <TextField fx:id="adresseField" HBox.hgrow="ALWAYS" prefHeight="45" promptText="Numéro, Rue, Ville..."
                                       style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 8;" />
                            <Button fx:id="adresseMicroBtn" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-width: 45;">
                                <graphic><ImageView fitHeight="20" fitWidth="20"><Image url="@image/micro.png"/></ImageView></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
                <effect><DropShadow color="#00000015" radius="10" offsetY="4" /></effect>
                <Label text="💰 Tarification et Capacité" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                <Separator />

                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33" />
                        <ColumnConstraints percentWidth="33" />
                        <ColumnConstraints percentWidth="33" />
                    </columnConstraints>

                    <VBox spacing="8" GridPane.columnIndex="0">
                        <Label text="Capacité" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <Spinner fx:id="capaciteSpinner" maxWidth="Infinity" prefHeight="45" style="-fx-background-radius: 8;" initialValue="1" min="1" max="20" editable="true" />
                    </VBox>

                    <VBox spacing="8" GridPane.columnIndex="1">
                        <Label text="Tarif (DT / Nuit)" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <TextField fx:id="tarifField" prefHeight="45" HBox.hgrow="ALWAYS" promptText="0.0" style="-fx-border-radius: 8; -fx-background-color: #f8f9fa;" />
                            <Button fx:id="tarifMicroBtn" style="-fx-background-color: #3498db; -fx-pref-height: 45;"><graphic><ImageView fitHeight="18" fitWidth="18"><Image url="@image/micro.png"/></ImageView></graphic></Button>
                        </HBox>
                    </VBox>

                    <!-- SWITCH PERSONNALISÉ - TAILLE RÉDUITE -->
                    <VBox spacing="6" alignment="CENTER" GridPane.columnIndex="2">
                        <Label text="Disponibilité Immédiate" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />

                        <!-- Label d'état -->
                        <Label fx:id="disponibiliteLabel" text="Non disponible" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />

                        <!-- Switch personnalisé - TAILLE 50x26 au lieu de 60x30 -->
                        <StackPane fx:id="switchContainer" onMouseClicked="#handleSwitchClick" style="-fx-cursor: hand;">
                            <!-- Fond du switch : 50px largeur, 26px hauteur -->
                            <HBox fx:id="switchBackground" prefWidth="50" prefHeight="26" maxWidth="50" maxHeight="26" minWidth="50" minHeight="26"
                                  style="-fx-background-color: #e74c3c; -fx-background-radius: 13; -fx-padding: 2;"
                                  alignment="CENTER_LEFT">
                                <!-- Cercle blanc : radius 10 au lieu de 13 -->
                                <Circle fx:id="switchCircle" radius="10" fill="white"
                                        style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 0, 1);"/>
                            </HBox>
                        </StackPane>

                        <!-- ToggleButton caché pour stocker l'état -->
                        <ToggleButton fx:id="disponibiliteToggle" visible="false" managed="false" selected="false"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
                <effect><DropShadow color="#00000015" radius="10" offsetY="4" /></effect>
                <Label text="✨ Équipements &amp; Photos" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                <Separator />

                <VBox spacing="15">
                    <VBox spacing="8">
                        <Label text="Équipements (Wifi, Piscine, Parking...)" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <HBox spacing="10">
                            <TextField fx:id="equipementField" HBox.hgrow="ALWAYS" prefHeight="45" style="-fx-background-color: #f8f9fa; -fx-border-radius: 8;" />
                            <Button fx:id="equipementMicroBtn" style="-fx-background-color: #3498db; -fx-pref-height: 45;"><graphic><ImageView fitHeight="20" fitWidth="20"><Image url="@image/micro.png"/></ImageView></graphic></Button>
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Image du logement (URL)" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                        <HBox spacing="10">
                            <TextField fx:id="imageField" HBox.hgrow="ALWAYS" prefHeight="45" style="-fx-background-color: #f8f9fa; -fx-border-radius: 8;" />
                            <Button fx:id="imageMicroBtn" style="-fx-background-color: #3498db; -fx-pref-height: 45;"><graphic><ImageView fitHeight="20" fitWidth="20"><Image url="@image/micro.png"/></ImageView></graphic></Button>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 20 0;">
                <Button fx:id="annulerBtn" prefHeight="50" prefWidth="150" text="ANNULER"
                        style="-fx-background-color: transparent; -fx-border-color: #e74c3c; -fx-border-radius: 10; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" />

                <Button fx:id="ajouterBtn" prefHeight="50" prefWidth="250" text="ENREGISTRER LE LOGEMENT"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-size: 14;">
                    <effect><DropShadow color="#2ecc7144" radius="15" offsetY="5" /></effect>
                </Button>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>