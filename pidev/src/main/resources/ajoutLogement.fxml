<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AjoutLogementController">
    <!-- Header -->
    <HBox alignment="CENTER" spacing="10" style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-padding: 20;">
        <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
            <Image url="/image/logement.png" />
        </ImageView>
        <Label text="Ajouter un Nouveau Logement" textFill="WHITE">
            <font>
                <Font name="Arial Bold" size="24" />
            </font>
        </Label>
    </HBox>

    <!-- Form Container -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: #f4f4f4;" VBox.vgrow="ALWAYS">
        <GridPane hgap="20" vgap="20" style="-fx-padding: 30; -fx-background-color: #f4f4f4;">
            <!-- Ligne 1 : Type et Nom -->
            <Label text="Type de Logement" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="typeComboBox" prefWidth="300" promptText="Sélectionnez le type" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Appartement" />
                        <String fx:value="Maison" />
                        <String fx:value="Villa" />
                        <String fx:value="Hôtel" />
                        <String fx:value="Autre" />
                    </FXCollections>
                </items>
            </ComboBox>

            <Label text="Nom du Logement" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <TextField fx:id="nomField" prefWidth="250" promptText="Entrez le nom" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" />
                <Button fx:id="nomMicroBtn" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 50%; -fx-pref-width: 40; -fx-pref-height: 40;">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <Image url="/image/micro.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- Ligne 2 : Image et Adresse -->
            <Label text="URL de l'Image" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <TextField fx:id="imageField" prefWidth="250" promptText="Entrez l'URL de l'image" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" />
                <Button fx:id="imageMicroBtn" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 50%; -fx-pref-width: 40; -fx-pref-height: 40;">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <Image url="/image/micro.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Label text="Adresse" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <TextField fx:id="adresseField" prefWidth="250" promptText="Entrez l'adresse" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" />
                <Button fx:id="adresseMicroBtn" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 50%; -fx-pref-width: 40; -fx-pref-height: 40;">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <Image url="/image/micro.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- Ligne 3 : Capacité et Équipements -->
            <Label text="Capacité (nombre de personnes)" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Spinner fx:id="capaciteSpinner" prefWidth="300" editable="true" initialValue="1" min="1" max="20" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Équipements" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="2">
                <TextField fx:id="equipementField" prefWidth="250" promptText="Entrez les équipements (séparés par des virgules)" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" />
                <Button fx:id="equipementMicroBtn" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 50%; -fx-pref-width: 40; -fx-pref-height: 40;">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <Image url="/image/micro.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- Ligne 4 : Tarif et Disponibilité -->
            <Label text="Tarif par Nuit (DT)" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="tarifField" prefWidth="300" promptText="Entrez le tarif" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Disponibilité" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <CheckBox fx:id="disponibiliteCheckBox" text="Disponible" selected="true" GridPane.columnIndex="3" GridPane.rowIndex="3" />

            <!-- Ligne 5 : Boutons (centrés sur toute la largeur) -->
            <HBox spacing="20" alignment="CENTER" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="4" GridPane.halignment="CENTER">
                <Button fx:id="ajouterBtn" text="Ajouter Logement" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16; -fx-background-radius: 10; -fx-padding: 10 20;">
                    <effect>
                        <DropShadow color="#00000040" radius="5" />
                    </effect>
                </Button>
                <Button fx:id="annulerBtn" text="Annuler" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16; -fx-background-radius: 10; -fx-padding: 10 20;">
                    <effect>
                        <DropShadow color="#00000040" radius="5" />
                    </effect>
                </Button>
            </HBox>
        </GridPane>
    </ScrollPane>
</VBox>