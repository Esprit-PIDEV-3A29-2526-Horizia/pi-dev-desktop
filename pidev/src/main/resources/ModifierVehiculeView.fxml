<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierVehiculeController"
            fitToWidth="true"
            prefHeight="600"
            maxHeight="600"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="25"
          style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #e8ecf1);"
          prefWidth="650">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--                          HEADER SECTION                          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="✏️" style="-fx-font-size: 56px;"/>
            <Label text="Modifier un Véhicule"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
            <Label text="Recherchez le véhicule puis modifiez ses informations"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
        </VBox>

        <Separator style="-fx-background-color: #bdc3c7;"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--                   SECTION RECHERCHE                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <VBox spacing="15"
              style="-fx-background-color: white;
                 -fx-padding: 25;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 5);">

            <Label text="🔍 Rechercher le véhicule à modifier"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Immatriculation du véhicule"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtRechercheImmat"
                               promptText="Ex: 123 TUN 456"
                               style="-fx-font-size: 15px; -fx-padding: 12;"
                               HBox.hgrow="ALWAYS"/>
                </VBox>

                <VBox spacing="6" alignment="BOTTOM_CENTER">
                    <Label text=" " style="-fx-font-size: 13px;"/>
                    <Button text="🔎 Rechercher"
                            onAction="#rechercherVehicule"
                            prefWidth="150"
                            style="-fx-background-color: #3498db;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-padding: 12 0;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Button>
                </VBox>
            </HBox>

            <Label fx:id="lblMessageRecherche"
                   text=""
                   wrapText="true"
                   visible="false"
                   managed="false"
                   style="-fx-font-size: 12px; -fx-padding: 10; -fx-background-radius: 8;"/>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--                   FORMULAIRE DE MODIFICATION                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <VBox fx:id="vboxFormulaire"
              spacing="25"
              visible="false"
              managed="false"
              style="-fx-background-color: white;
                 -fx-padding: 35;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 5);">

            <Label text="✏️ Modifier les informations"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="18"/>
                </font>
            </Label>

            <!-- Info véhicule trouvé -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #e8f4f8; -fx-padding: 12; -fx-background-radius: 8;">
                <Label text="ℹ️" style="-fx-font-size: 16px;"/>
                <Label fx:id="lblVehiculeTrouve"
                       text="Véhicule trouvé"
                       style="-fx-font-size: 13px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Champs modifiables -->
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Marque + Modèle (non modifiables) -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Marque" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboMarque" disable="true" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-padding: 8;"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Modèle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboModele" disable="true" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-padding: 8;"/>
                </VBox>

                <!-- Année -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Année" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtAnnee" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>

                <!-- Carburant -->
                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Carburant" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboCarburant" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-padding: 8;"/>
                </VBox>

                <!-- Couleur -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Couleur" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtCouleur" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>

                <!-- Kilométrage -->
                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Kilométrage" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtKilometrage" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>

                <!-- État -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="État" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <ComboBox fx:id="comboEtat" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-padding: 8;"/>
                </VBox>

                <!-- Prix par jour -->
                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="Prix par jour (TND)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtPrixParJour" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>

                <!-- Photo -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                    <Label text="URL Photo" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtPhoto" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>
            </GridPane>

            <!-- Message -->
            <Label fx:id="lblMessage"
                   text=""
                   wrapText="true"
                   visible="false"
                   managed="false"
                   style="-fx-font-size: 13px; -fx-padding: 12; -fx-background-radius: 8;"/>

            <!-- Boutons -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="✖ Annuler"
                        onAction="#annuler"
                        prefWidth="180"
                        style="-fx-background-color: #95a5a6;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-padding: 14 0;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="15"/>
                    </font>
                </Button>

                <Button text="💾 Enregistrer les modifications"
                        onAction="#enregistrerModifications"
                        prefWidth="280"
                        defaultButton="true"
                        style="-fx-background-color: linear-gradient(to bottom, #f39c12, #e67e22);
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-padding: 14 0;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="16"/>
                    </font>
                </Button>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
