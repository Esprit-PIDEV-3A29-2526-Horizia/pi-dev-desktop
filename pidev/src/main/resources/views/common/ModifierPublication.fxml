<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.frontend.common.ModifierPublicationController">  <!-- ✅ Fixed package -->

    <!-- Titre -->
    <Label text="Modifier Publication" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Formulaire -->
    <VBox spacing="15">
        <!-- Titre -->
        <VBox spacing="5">
            <Label text="Titre *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
            <TextField fx:id="titreField" promptText="Entrez le titre" style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
        </VBox>

        <!-- Description -->
        <VBox spacing="5">
            <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
            <TextArea fx:id="descriptionField" promptText="Entrez la description..." wrapText="true" prefRowCount="4" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
        </VBox>

        <!-- Image -->
        <VBox spacing="5">
            <Label text="Image actuelle" style="-fx-font-weight: bold; -fx-text-fill: #555;" />
            <ImageView fx:id="currentImageView" fitHeight="150" fitWidth="250" preserveRatio="true" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="imageField" promptText="Nouvelle image (optionnel)" HBox.hgrow="ALWAYS" editable="false" style="-fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" />
                <Button fx:id="browseButton" text="Changer" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 12 20; -fx-background-radius: 8; -fx-font-weight: bold;" />
            </HBox>
            <ImageView fx:id="previewImage" fitHeight="100" fitWidth="150" preserveRatio="true" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8;" />
        </VBox>
    </VBox>

    <!-- Boutons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
        <children>
            <Button fx:id="annulerButton" text="Annuler" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-weight: bold;" />
            <Button fx:id="enregistrerButton" text="Enregistrer" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 12 25; -fx-background-radius: 8; -fx-font-weight: bold;" />
        </children>
    </HBox>
</VBox>