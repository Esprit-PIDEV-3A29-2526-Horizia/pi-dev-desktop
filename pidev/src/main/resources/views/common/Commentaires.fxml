<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.common.CommentairesController">

    <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f8fafc;">

        <!-- Titre de la publication -->
        <Label fx:id="publicationInfoLabel" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

        <!-- Formulaire d'ajout de commentaire avec micro et sélecteur de langue -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
            <Label text="Ajouter un commentaire"/>
            <TextField fx:id="auteurField" promptText="Votre nom"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextArea fx:id="contenuField" promptText="Votre commentaire..." wrapText="true" prefRowCount="3" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="langueCombo" prefWidth="100" promptText="Langue"/>
                <Button fx:id="voiceInputBtn" text="🎤" style="-fx-background-radius: 20; -fx-cursor: hand;"/>
            </HBox>

            <Button fx:id="ajouterBtn" text="Publier" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>

        <!-- Liste des commentaires -->
        <VBox fx:id="commentairesContainer" spacing="10"/>

        <!-- Bouton retour -->
        <Button fx:id="retourBtn" text="← Retour" style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-cursor: hand;"/>

        <!-- Conteneur pour la WebView de reconnaissance vocale (invisible) -->
        <StackPane fx:id="webViewContainer" prefWidth="0" prefHeight="0" />
    </VBox>
</ScrollPane>