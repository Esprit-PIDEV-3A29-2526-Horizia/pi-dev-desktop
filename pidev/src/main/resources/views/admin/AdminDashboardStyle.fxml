<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.frontend.admin.AdminDashboardStyleController"
            style="-fx-background-color: #f8fafc;">

    <!-- TOP BAR (menu horizontal) -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 30;">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="🏔️" style="-fx-font-size: 28;"/>
                    <Label text="HORIZIA ADMIN" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Admin" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            </HBox>

            <HBox spacing="25" style="-fx-padding: 0 30 10 30;" alignment="CENTER_LEFT">
                <Button fx:id="btnAccueil" text="Accueil" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Button fx:id="btnPublications" text="Publications" style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Button fx:id="btnUtilisateurs" text="Utilisateurs" style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Button fx:id="btnStatistiques" text="Statistiques" style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-size: 14; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="30" style="-fx-padding: 30; -fx-background-color: #f8fafc;">

                <!-- Hero Section (statistiques rapides) -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <Label text="📰 Publications" style="-fx-text-fill: #64748b; -fx-font-size: 14;"/>
                        <Label fx:id="totalPubsLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <Label text="👥 Utilisateurs" style="-fx-text-fill: #64748b; -fx-font-size: 14;"/>
                        <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <Label text="💬 Commentaires" style="-fx-text-fill: #64748b; -fx-font-size: 14;"/>
                        <Label fx:id="totalCommentsLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                </HBox>

                <!-- Barre de recherche et tri -->
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="searchField" promptText="Rechercher une publication..."
                               style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 15 25; -fx-font-size: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 30;"
                               HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="sortCombo" promptText="Trier par"
                              style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 5 15; -fx-font-size: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 30;"
                              prefWidth="150"/>
                    <Button fx:id="searchBtn" text="Rechercher"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 15 30; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <!-- Filtres par catégorie -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Catégories:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14;"/>
                    <Button fx:id="btnTous" text="Tous" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand;"/>
                    <Button fx:id="btnPlage" text="🌊 Plage" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
                    <Button fx:id="btnMontagne" text="⛰️ Montagne" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
                    <Button fx:id="btnVille" text="🏙️ Ville" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-background-radius: 25; -fx-padding: 10 25; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 25;"/>
                </HBox>

                <!-- Grille des publications récentes -->
                <FlowPane fx:id="itemsGrid" hgap="20" vgap="20" style="-fx-padding: 10 0;" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>