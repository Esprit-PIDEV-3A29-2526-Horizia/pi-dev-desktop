<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
      prefWidth="280" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.frontend.components.PublicationCardController">

    <ImageView fx:id="imageView" fitHeight="150" fitWidth="250" preserveRatio="true"
               style="-fx-background-color: #f1f5f9; -fx-background-radius: 10;" />

    <Label fx:id="categorieLabel" style="-fx-text-fill: #3b82f6; -fx-font-size: 13;" />

    <Label fx:id="titreLabel" wrapText="true" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

    <Label fx:id="auteurLabel" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />

    <Label fx:id="dateLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />

    <Label fx:id="descriptionLabel" wrapText="true" style="-fx-text-fill: #475569; -fx-font-size: 13;" maxHeight="50" />

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="likeButton" text="♥" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand;"/>
        <Label fx:id="likesLabel" text="♥ 0" style="-fx-text-fill: #ef4444;"/>
        <Button fx:id="commentairesBtn" text="💬" style="-fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-cursor: hand;"/>
        <Label fx:id="commentsLabel" text="💬 0" style="-fx-text-fill: #3b82f6;"/>
        <Region HBox.hgrow="ALWAYS" />
        <HBox fx:id="adminActionsBox" spacing="5" visible="false" managed="false">
            <Button fx:id="modifierBtn" text="✏️" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" />
            <Button fx:id="supprimerBtn" text="🗑️" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" />
        </HBox>
    </HBox>
</VBox>