<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f4f7fb;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <children>
                <!-- Header avec image et titre -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                            <image>
                                <Image url="@/images/logo.png" />
                            </image>
                        </ImageView>
                        <VBox>
                            <children>
                                <Label text="Tableau de bord" style="-fx-font-weight: bold;">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>
                                <Label text="Bienvenue dans votre espace d'administration" style="-fx-text-fill: #666666;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Slogan -->
                <Label text="Simplifiez votre gestion au quotidien" style="-fx-font-style: italic; -fx-text-fill: #2a5298;" alignment="CENTER">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <!-- Grille de fonctionnalités -->
                <GridPane hgap="15.0" vgap="15.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="SOMETIMES" percentHeight="50" />
                        <RowConstraints vgrow="SOMETIMES" percentHeight="50" />
                    </rowConstraints>

                    <children>
                        <!-- Carte 1 -->
                        <AnchorPane style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                                    <children>
                                        <Label text="📊" style="-fx-font-size: 40px;" />
                                        <Label text="Statistiques" style="-fx-font-weight: bold;" />
                                        <Label text="Visualisez vos données en temps réel" wrapText="true" alignment="CENTER" style="-fx-text-fill: #666666; -fx-font-size: 12px;" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>

                        <!-- Carte 2 -->
                        <AnchorPane style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                                    <children>
                                        <Label text="👥" style="-fx-font-size: 40px;" />
                                        <Label text="Utilisateurs" style="-fx-font-weight: bold;" />
                                        <Label text="Gérez les comptes utilisateurs" wrapText="true" alignment="CENTER" style="-fx-text-fill: #666666; -fx-font-size: 12px;" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>

                        <!-- Carte 3 -->
                        <AnchorPane style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                                    <children>
                                        <Label text="📋" style="-fx-font-size: 40px;" />
                                        <Label text="Profils" style="-fx-font-weight: bold;" />
                                        <Label text="Gérez les profils et permissions" wrapText="true" alignment="CENTER" style="-fx-text-fill: #666666; -fx-font-size: 12px;" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>

                        <!-- Carte 4 -->
                        <AnchorPane style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                                    <children>
                                        <Label text="⚙️" style="-fx-font-size: 40px;" />
                                        <Label text="Paramètres" style="-fx-font-weight: bold;" />
                                        <Label text="Configurez votre application" wrapText="true" alignment="CENTER" style="-fx-text-fill: #666666; -fx-font-size: 12px;" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </children>
                </GridPane>
            </children>
        </VBox>
    </children>
</AnchorPane>