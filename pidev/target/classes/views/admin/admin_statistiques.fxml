<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="25" style="-fx-background-color: #f8fafc; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.frontend.admin.AdminStatistiquesController">

    <!-- En-tête -->
    <VBox spacing="10">
        <Label text="📊 Statistiques"
               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
        <Label text="Analyse des données de la plateforme"
               style="-fx-font-size: 14; -fx-text-fill: #64748b;" />
    </VBox>

    <!-- Cartes de statistiques rapides -->
    <HBox spacing="20">
        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label text="📰 Publications" style="-fx-text-fill: #64748b; -fx-font-size: 14;" />
            <Label fx:id="totalPublicationsLabel" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" />
        </VBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label text="💬 Commentaires" style="-fx-text-fill: #64748b; -fx-font-size: 14;" />
            <Label fx:id="totalCommentairesLabel" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #f59e0b;" />
        </VBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label text="❤️ Likes" style="-fx-text-fill: #64748b; -fx-font-size: 14;" />
            <Label fx:id="totalLikesLabel" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #ef4444;" />
        </VBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              HBox.hgrow="ALWAYS">
            <Label text="👥 Utilisateurs" style="-fx-text-fill: #64748b; -fx-font-size: 14;" />
            <Label fx:id="totalUtilisateursLabel" text="0"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;" />
        </VBox>
    </HBox>

    <!-- Graphiques -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
        </columnConstraints>

        <!-- Graphique des publications par catégorie -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Publications par catégorie"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <PieChart fx:id="categoriePieChart" prefHeight="300"
                      style="-fx-padding: 10;" />
        </VBox>

        <!-- Graphique des publications par mois -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Publications par mois"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <BarChart fx:id="moisBarChart" prefHeight="300">
                <xAxis>
                    <CategoryAxis label="Mois" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Nombre" />
                </yAxis>
            </BarChart>
        </VBox>

        <!-- Top publications -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="🔥 Top 5 publications"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <VBox fx:id="topPublicationsList" spacing="10" style="-fx-padding: 10;" />
        </VBox>

        <!-- Dernières activités -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                    -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
              GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="🕐 Dernières activités"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <VBox fx:id="activitesList" spacing="10" style="-fx-padding: 10;" />
        </VBox>
    </GridPane>
</VBox>